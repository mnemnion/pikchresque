    try std.testing.expect(std.mem.indexOf(u8, out.text, "._fc {fill:rgb(255,0,0)}") != null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "class=\"noop _sb _fc\"") != null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "._G") == null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "fill=\"rgb(255,0,0)\"") == null);
}

test "Pik generated arrowhead fill uses foreground color class" {
    const out = try render(std.testing.allocator, "arrow color 0x112233\n", "pikchr", PIKCHR_DARK_MODE);
    defer out.deinit(std.testing.allocator);
    try std.testing.expect(out.ok());
    try std.testing.expect(std.mem.indexOf(u8, out.text, "._sa {stroke:rgb(204,221,238)}") != null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "._fb {fill:rgb(204,221,238)}") != null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "<polygon class=\"arrow _sa _fb\"") != null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "._G") == null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "fill=\"rgb(204,221,238)\"") == null);
}

test "Pik generated render expands macros" {
    const out = try render(std.testing.allocator, "define b {box \"hi\"}\nb\n", "pikchr", 0);
    defer out.deinit(std.testing.allocator);
    try std.testing.expect(out.ok());
    try std.testing.expect(std.mem.indexOf(u8, out.text, "hi") != null);
}

test "Pik generated render expands macro arguments" {
    const out = try render(std.testing.allocator, "define b {box $1}\nb(\"hi\")\n", "pikchr", 0);
    defer out.deinit(std.testing.allocator);
    try std.testing.expect(out.ok());
    try std.testing.expect(std.mem.indexOf(u8, out.text, "hi") != null);
