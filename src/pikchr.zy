// Convert an object class name into a PClass pointer
fn pik_find_class(id: *PToken) ?*const PClass {
    for (&aClass) |*class| {
        if (std.mem.eql(u8, class.zName, id.z)) return class;
    }
    return null;
}

// Recompute key layout parameters from variables.
fn pik_compute_layout_settings(p: *Pik) void {
    if (p.bLayoutVars != 0) return;
    var thickness = pik_value(p, "thickness", null);
    if (thickness <= 0.01) thickness = 0.01;
    const w_arrow = 0.5 * pik_value(p, "arrowwid", null);
    p.wArrow = w_arrow / thickness;
    p.hArrow = pik_value(p, "arrowht", null) / thickness;
    p.fontScale = pik_value(p, "fontscale", null);
    if (p.fontScale <= 0.0) p.fontScale = 1.0;
    p.rScale = 144.0;
    p.charWidth = pik_value(p, "charwid", null) * p.fontScale;
    p.charHeight = pik_value(p, "charht", null) * p.fontScale;
    p.bLayoutVars = 1;
}

// Add all objects of the list pList to the bounding box
fn pik_bbox_add_elist(p: *Pik, list: *PList, w_arrow: PNum) void {
    for (list.a[0..list.n]) |obj| {
        if (obj.sw >= 0.0) pik_bbox_addbox(&p.bbox, &obj.bbox);
        pik_append_txt(p, obj, &p.bbox);
        if (obj.pSublist) |sublist| pik_bbox_add_elist(p, sublist, w_arrow);

        // Expand the bounding box to account for arrowheads on lines
        if (obj.type) |class| {
            if (class.isLine != 0 and obj.nPath > 0 and obj.aPath.len >= @as(usize, @intCast(obj.nPath))) {
                if (obj.larrow != 0) {
                    pik_bbox_addellipse(&p.bbox, obj.aPath[0].x, obj.aPath[0].y, w_arrow, w_arrow);
                }
                if (obj.rarrow != 0) {
                    const j: usize = @intCast(obj.nPath - 1);
                    pik_bbox_addellipse(&p.bbox, obj.aPath[j].x, obj.aPath[j].y, w_arrow, w_arrow);
                }
            }
        }
    }
}

// Show basic information about each object as a comment in the
// generated HTML.  Used for testing and debugging.  Activated
// by the (undocumented) "debug = 1;"
// command.
fn pik_elem_render(p: *Pik, obj: *PObj) void {
    pik_append(p, "<!-- ");
    if (obj.zName.len != 0) {
        pik_append_text(p, obj.zName, 0);
        pik_append(p, ": ");
    }
    if (obj.type) |class| pik_append_text(p, class.zName, 0);
    if (obj.nTxt != 0) {
        pik_append(p, " \"");
        pik_append_text(p, tokenInner(&obj.aTxt[0]), 1);
        pik_append(p, "\"");
    }
    pik_append_num(p, " w=", obj.w);
    pik_append_num(p, " h=", obj.h);
    pik_append_point(p, " center=", &obj.ptAt);
    pik_append_point(p, " enter=", &obj.ptEnter);
    const z_dir = switch (obj.outDir) {
        DIR_LEFT => " left",
        DIR_UP => " up",
        DIR_DOWN => " down",
        else => " right",
    };
    pik_append_point(p, " exit=", &obj.ptExit);
    pik_append(p, z_dir);
    pik_append(p, " -->\n");
}

// Render a list of objects
fn pik_elist_render(p: *Pik, list: *PList) void {
    var i_next_layer: i32 = 0;
    const mut_debug = pik_round(pik_value(p, "debug", null));
    while (true) {
        var b_more_to_do: i32 = 0;
        const i_this_layer = i_next_layer;
        i_next_layer = std.math.maxInt(i32);
        for (list.a[0..list.n]) |obj| {
            if (obj.pSublist != null and obj.iLayer == i_this_layer) {
                pik_append_tag_open(p, obj, "g");
                pik_append(p, "\" >\n");
            }
            if (obj.iLayer > i_this_layer) {
                if (obj.iLayer < i_next_layer) i_next_layer = obj.iLayer;
                b_more_to_do = 1;
                continue; // Defer until another round
            } else if (obj.iLayer < i_this_layer) {
                continue;
            }
            if ((mut_debug & 1) != 0) pik_elem_render(p, obj);
            if (obj.type) |class| {
                if (class.xRender) |xrender| xrender(p, obj);
            }
            if (obj.pSublist) |sublist| {
                pik_elist_render(p, sublist);
            }
            if (obj.pSublist != null and obj.iLayer == i_this_layer) {
                pik_append(p, "</g>\n");
            }
        }
        if (b_more_to_do == 0) break;
    }

    // If the color_debug_label value is defined, then go through
    // and paint a dot at every label location
    var miss: i32 = 0;
    const color_label = pik_value(p, "debug_label_color", &miss);
    if (miss == 0 and color_label >= 0.0) {
        var dot: PObj = .start;
        dot.type = &noopClass;
        dot.rad = 0.015;
        dot.sw = 0.015;
        dot.fill = color_label;
        dot.color = color_label;
        dot.textcolor = color_label;
        dot.nTxt = 1;
        dot.aTxt[0].eCode = TP_ABOVE;
        for (list.a[0..list.n]) |obj| {
            if (obj.zName.len == 0) continue;
            dot.ptAt = obj.ptAt;
            dot.aTxt[0].z = obj.zName;
            dotRender(p, &dot);
        }
    }
}

// Render a list of objects.  Write the SVG into p->zOut.
// Delete the input object_list before returnning.
fn pik_render(p: *Pik, list: ?*PList) void {
    const l = list orelse return;
    defer {
        pik_elist_free(p, l);
        if (p.list == l) p.list = null;
    }
    if (p.nErr != 0) {
        p.wSVG = -1;
        p.hSVG = -1;
        return;
    }
    pik_compute_layout_settings(p);
    var thickness = pik_value(p, "thickness", null);
    if (thickness <= 0.01) thickness = 0.01;
    var margin = pik_value(p, "margin", null);
    margin += thickness;
    const w_arrow = p.wArrow * thickness;
    pik_bbox_init(&p.bbox);
    pik_bbox_add_elist(p, l, w_arrow);
    p.bbox.ne.x += margin + pik_value(p, "rightmargin", null);
    p.bbox.ne.y += margin + pik_value(p, "topmargin", null);
    p.bbox.sw.x -= margin + pik_value(p, "leftmargin", null);
    p.bbox.sw.y -= margin + pik_value(p, "bottommargin", null);
    const w = p.bbox.ne.x - p.bbox.sw.x;
    const h = p.bbox.ne.y - p.bbox.sw.y;
    p.wSVG = pik_round(p.rScale * w);
    p.hSVG = pik_round(p.rScale * h);
    var debug_label_miss: i32 = 0;
    const debug_label_color = pik_value(p, "debug_label_color", &debug_label_miss);
    if (debug_label_miss == 0 and debug_label_color >= 0.0) {
        pik_remember_color(p, &p.hStroke, debug_label_color);
        pik_remember_color(p, &p.hFgFill, debug_label_color);
    }
    pik_append(p, "<svg xmlns='http://www.w3.org/2000/svg' style='font-size:initial;'");
    pik_append(p, " class=\"");
    pik_append(p, p.zClass);
    pik_append(p, "\" id=\"");
    pik_append(p, p.zClass);
    pik_append(p, p.zID);
    pik_append(p, "\"");
    pik_append(p, " role=\"img\"");
    var aria_start = false;
    if (p.zTitle.len != 0) {
        if (p.bLabel != 0) {
            pik_append(p, " aria-label=\"");
            pik_append_str(p, p.zTitle, 0x6);
            pik_append(p, "\"");
        } else {
            aria_start = true;
            pik_append(p, " aria-labelledby=\"title");
            pik_append(p, p.zID);
        }
    }
    if (p.zDesc.len != 0) {
        if (!aria_start) {
            aria_start = true;
            pik_append(p, " aria-labelledby=\"");
        } else {
            pik_append(p, " ");
        }
        pik_append(p, "desc");
        pik_append(p, p.zID);
    }
    if (aria_start) {
        pik_append(p, "\"");
    }
    const pik_scale = pik_value(p, "scale", null);
    if (pik_scale >= 0.001 and pik_scale <= 1000.0 and (pik_scale < 0.99 or pik_scale > 1.01)) {
        p.wSVG = pik_round(@as(PNum, @floatFromInt(p.wSVG)) * pik_scale);
        p.hSVG = pik_round(@as(PNum, @floatFromInt(p.hSVG)) * pik_scale);
        pik_append_num(p, " width=\"", @floatFromInt(p.wSVG));
        pik_append_num(p, "\" height=\"", @floatFromInt(p.hSVG));
        pik_append(p, "\"");
    }
    pik_append_dis(p, " viewBox=\"0 0 ", w, "");
    pik_append_dis(p, " ", h, "\">\n");
    // CSS
    pik_append(p, "<style>\n#");
    pik_append(p, p.zClass);
    pik_append(p, p.zID);
    pik_append(p, " {\n");
    if ((p.mAttr & ATTR_BASELINE) != 0) {
        pik_append(p, "._D {dominant-baseline:central}\n");
    }
    if ((p.mAttr & ATTR_FILL_NO) != 0) {
        pik_append(p, "._T {fill:transparent}\n");
    }
    pik_append_color_css(p);
    if ((p.mAttr & ATTR_T_START) != 0) {
        pik_append(p, "._tS {text-anchor:start}\n");
    }
    if ((p.mAttr & ATTR_T_MIDDLE) != 0) {
        pik_append(p, "._tM {text-anchor:middle}\n");
    }
    if ((p.mAttr & ATTR_T_END) != 0) {
        pik_append(p, "._tE {text-anchor:end}\n");
    }
    if ((p.mAttr & ATTR_F_BOLD) != 0) {
        pik_append(p, "._Fb {font-weight:bold}\n");
    }
    if ((p.mAttr & ATTR_F_BOLD) != 0) {
        pik_append(p, "._Fi {font-style:italic}\n");
    }
    if ((p.mAttr & ATTR_F_MONO) != 0) {
        pik_append(p, "._Fm {font-family:monospace}\n");
    }
    pik_append(p, "}\n</style>\n");
    if (p.zTitle.len != 0) {
        if (p.bLabel == 0) {
            pik_append(p, "<title id=\"title");
            pik_append(p, p.zID);
            pik_append(p, "\">\n");
            pik_append_str(p, p.zTitle, 0x2);
            pik_append(p, "\n</title>\n");
        }
    }
    if (p.zDesc.len != 0) {
        pik_append(p, "<desc id=\"desc");
        pik_append(p, p.zID);
        pik_append(p, "\">\n");
        pik_append_str(p, p.zDesc, 0x2);
        pik_append(p, "\n</desc>\n");
    }
    pik_elist_render(p, l);
    pik_append(p, "</svg>\n");
}

// Append a new object onto the end of an object list.  The
// object list is created if it does not already exist.  Return
// the new object list.
fn pik_elist_append(p: *Pik, list: ?*PList, obj: ?*PObj) ?*PList {
    const o = obj orelse return list;
    const l = list orelse p.allocator.create(PList) catch {
        pik_error(p, null, null);
        return null;
    };
    if (list == null) l.* = .zero;
    if (l.n >= l.nAlloc) {
        const n_new = (l.n + 5) * 2;
        l.a = p.allocator.realloc(l.a, n_new) catch {
            pik_error(p, null, null);
            pik_elem_free(p, o);
            return l;
        };
        l.nAlloc = n_new;
    }
    l.a[l.n] = o;
    l.n += 1;
    p.list = l;
    return l;
}

// Allocate and return a new PObj object.
//
// If pId!=0 then pId is an identifier that defines the object class.
// If pStr!=0 then it is a STRING literal that defines a text object.
// If pSublist!=0 then this is a [...] object. If all three parameters
// are NULL then this is a no-op object used to define a PLACENAME.
fn pik_elem_new(p: *Pik, id: ?*PToken, str: ?*PToken, sublist: ?*PList) ?*PObj {
    if (p.nErr != 0) return null;
    const obj = p.allocator.create(PObj) catch {
        pik_error(p, null, null);
        pik_elist_free(p, sublist);
        return null;
    };
    obj.* = .start;
    p.cur = obj;
    p.nTPath = 1;
    p.thenFlag = 0;
    if (p.list == null or p.list.?.n == 0) {
        obj.ptAt = cZeroPoint;
        obj.eWith = CP_C;
    } else {
        const prior = p.list.?.a[p.list.?.n - 1];
        obj.ptAt = prior.ptExit;
        obj.eWith = switch (p.eDir) {
            DIR_LEFT => CP_E,
            DIR_UP => CP_S,
            DIR_DOWN => CP_N,
            else => CP_W,
        };
    }
    p.aTPath[0] = obj.ptAt;
    obj.with = obj.ptAt;
    obj.outDir = p.eDir;
    obj.inDir = p.eDir;
    obj.pSublist = sublist;
    var miss: i32 = 0;
    obj.iLayer = @intCast(pik_round(pik_value(p, "layer", &miss)));
    if (miss != 0) obj.iLayer = 1000;
    if (obj.iLayer < 0) obj.iLayer = 0;
    if (sublist != null) {
        obj.type = &sublistClass;
        sublistClass.xInit.?(p, obj);
        p.cur = obj;
        return obj;
    }
    if (str) |s| {
        var n = classToken("text");
        obj.type = pik_find_class(&n);
        std.debug.assert(obj.type != null);
        obj.errTok = s.*;
        obj.type.?.xInit.?(p, obj);
        pik_add_txt(p, s, s.eCode);
        p.cur = obj;
        return obj;
    }
    if (id) |i| {
        obj.errTok = i.*;
        if (pik_find_class(i)) |class| {
            obj.type = class;
            obj.sw = pik_value(p, "thickness", null);
            obj.fill = pik_value(p, "fill", null);
            obj.color = pik_value(p, "color", null);
            obj.textcolor = pik_value(p, "textcolor", null);
            if (class.xInit) |initFn| initFn(p, obj);
            p.cur = obj;
            return obj;
        }
        pik_error(p, i, "unknown object type");
        pik_elem_free(p, obj);
        return null;
    }
    obj.type = &noopClass;
    obj.ptEnter = obj.ptAt;
    obj.ptExit = obj.ptAt;
    p.cur = obj;
    return obj;
}

// Set a title or label for the Pikchr diagram.
fn pik_set_title(p: *Pik, title: *PToken, label: i32) void {
    if (p.zTitle.len != 0) {
        if (p.bLabel != 0) {
            pik_error(p, title, "diagram already has a label");
        } else {
            pik_error(p, title, "diagram already has a title");
        }
        return;
    }
    p.zTitle = p.allocator.dupe(u8, tokenInner(title)) catch {
        pik_error(p, title, null);
        return;
    };
    p.bLabel = if (label != 0) 1 else 0;
}

// Set a description for the Pikchr diagram.
fn pik_set_description(p: *Pik, desc: *PToken) void {
    if (p.zDesc.len != 0) {
        pik_error(p, desc, "diagram already has a description");
        return;
    }
    p.zDesc = p.allocator.dupe(u8, tokenInner(desc)) catch {
        pik_error(p, desc, null);
        return;
    };
}

// Set the output direction and exit point for an object
fn pik_elem_set_exit(obj: *PObj, dir: i32) void {
    std.debug.assert(ValidDir(dir));
    obj.outDir = dir;
    if (obj.type == null or obj.type.?.isLine == 0 or obj.bClose != 0) {
        obj.ptExit = obj.ptAt;
        switch (obj.outDir) {
            DIR_LEFT => obj.ptExit.x -= obj.w * 0.5,
            DIR_UP => obj.ptExit.y += obj.h * 0.5,
            DIR_DOWN => obj.ptExit.y -= obj.h * 0.5,
            else => obj.ptExit.x += obj.w * 0.5,
        }
    }
}

// Change the layout direction.
fn pik_set_direction(p: *Pik, dir: u16) void {
    std.debug.assert(ValidDir(dir));
    p.eDir = @intCast(dir);
    if (p.list) |list| {
        if (list.n != 0) pik_elem_set_exit(list.a[list.n - 1], @intCast(dir));
    }
}

// Attach a name to an object
fn pik_elem_setname(p: *Pik, obj: ?*PObj, name: *PToken) void {
    const o = obj orelse return;
    if (o.zName.len != 0) p.allocator.free(o.zName);
    o.zName = p.allocator.dupe(u8, name.z) catch {
        pik_error(p, name, null);
        return;
    };
}

// Set a local variable name to "val".
//
// The name might be a built-in variable or a color name.  In either case,
// a new application-defined variable is set.  Since app-defined variables
// are searched first, this will override any built-in variables.
fn pik_apply_var_op(p: *Pik, v: *PVar, val: PNum, op: *PToken) void {
    switch (op.eCode) {
        @intFromEnum(TokenKind.PLUS) => v.val += val,
        @intFromEnum(TokenKind.STAR) => v.val *= val,
        @intFromEnum(TokenKind.MINUS) => v.val -= val,
        @intFromEnum(TokenKind.SLASH) => {
            if (val == 0.0) {
                pik_error(p, op, "division by zero");
            } else {
                v.val /= val;
            }
        },
        else => v.val = val,
    }
}

fn pik_set_var(p: *Pik, id: *PToken, val: PNum, op: *PToken) void {
    var found = p.pVar;
    while (found) |v| : (found = v.pNext) {
        if (pik_token_eq(id, v.zName) == 0) {
            const old_val = v.val;
            pik_apply_var_op(p, v, val, op);
            if (std.mem.eql(u8, v.zName, "color")) pik_sync_textcolor(p, old_val, v.val);
            p.bLayoutVars = 0;
            return;
        }
    }
    const v = p.allocator.create(PVar) catch {
        pik_error(p, id, null);
        return;
    };
    const name = p.allocator.dupe(u8, id.z) catch {
        p.allocator.destroy(v);
        pik_error(p, id, null);
        return;
    };
    v.* = .{
        .zName = name,
        .val = pik_value(p, id.z, null),
        .pNext = p.pVar,
    };
    p.pVar = v;
    const old_val = v.val;
    pik_apply_var_op(p, v, val, op);
    if (std.mem.eql(u8, v.zName, "color")) pik_sync_textcolor(p, old_val, v.val);
    p.bLayoutVars = 0;
}

// This is an ugly hack, but it keeps diagrams output-identical.  It
// should be removed to make textcolor independent of color.
fn pik_sync_textcolor(p: *Pik, old_val: PNum, new_val: PNum) void {
    var textcolor = p.pVar;
    while (textcolor) |v| : (textcolor = v.pNext) {
        if (std.mem.eql(u8, v.zName, "textcolor")) {
            if (v.val == old_val) v.val = new_val;
            return;
        }
    }
    const v = p.allocator.create(PVar) catch {
        pik_error(p, null, null);
        return;
    };
    const name = p.allocator.dupe(u8, "textcolor") catch {
        p.allocator.destroy(v);
        pik_error(p, null, null);
        return;
    };
    v.* = .{ .zName = name, .val = new_val, .pNext = p.pVar };
    p.pVar = v;
}

// Round a PNum into the nearest integer
fn pik_round(v: PNum) i32 {
    if (std.math.isNan(v)) return 0;
    if (v < -2147483647) return -2147483648;
    if (v >= 2147483647) return 2147483647;
    return @intFromFloat(v);
}

// Search for the variable named z[0..n-1] in:
//
//   * Application defined variables
//   * Built-in variables
//
// Return the value of the variable if found.  If not found
// return 0.0.  Also if pMiss is not NULL, then set it to 1
// if not found.
//
// This routine is a subroutine to pik_get_var().  But it is also
// used by object implementations to look up (possibly overwritten)
// values for built-in variables like "boxwid".
fn pik_value(p: *Pik, z: []const u8, miss: ?*i32) PNum {
    var v = p.pVar;
    while (v) |vv| : (v = vv.pNext) {
        if (std.mem.eql(u8, vv.zName, z)) {
            if (miss) |m| m.* = 0;
            return vv.val;
        }
    }
    for (aBuiltin) |bi| {
        if (std.mem.eql(u8, bi.zName, z)) {
            if (miss) |m| m.* = 0;
            return bi.val;
        }
    }
    if (std.mem.eql(u8, z, "nTokens")) {
        if (miss) |m| m.* = 0;
        return @floatFromInt(p.nToken);
    }
    if (miss) |m| m.* = 1;
    return 0.0;
}

// Look up a color-name.  Unlike other names in this program, the
// color-names are not case sensitive.  So "DarkBlue" and "darkblue"
// and "DARKBLUE" all find the same value (139).
//
// If not found, return -99.0.  Also post an error if p!=NULL.
//
// Special color names "None" and "Off" return -1.0 without causing
// an error.
fn pik_lookup_color(p: ?*Pik, id: *PToken) PNum {
    for (aColor) |color| {
        if (std.ascii.eqlIgnoreCase(id.z, color.zName)) {
            return @floatFromInt(color.val);
        }
    }
    if (p) |pp| pik_error(pp, id, "not a known color name");
    return -99.0;
}

// Get the value of a variable.
//
// Search in order:
//
//    *  Application defined variables
//    *  Built-in variables
//    *  Color names
//
// If no such variable is found, throw an error.
fn pik_get_var(p: *Pik, id: *PToken) PNum {
    var miss: i32 = 0;
    const v = pik_value(p, id.z, &miss);
    if (miss == 0) return v;
    const c = pik_lookup_color(null, id);
    if (c > -90.0) return c;
    pik_error(p, id, "no such variable");
    return 0.0;
}

// Convert a numeric literal into a number.  Return that number.
// There is no error handling because the tokenizer has already
// assured us that the numeric literal is valid.
//
// Allowed number forms:
//
//   (1)    Floating point literal
//   (2)    Same as (1) but followed by a unit: "cm", "mm", "in",
//          "px", "pt", or "pc".
//   (3)    Hex integers: 0x000000
//
// This routine returns the result in inches.  If a different unit
// is specified, the conversion happens automatically.
fn pik_atof(t: *PToken) PNum {
    const text = t.z;
    if (text.len >= 3 and text[0] == '0' and (text[1] == 'x' or text[1] == 'X')) {
        return @floatFromInt(std.fmt.parseInt(i64, text[2..], 16) catch 0);
    }
    var num_end: usize = 0;
    while (num_end < text.len) : (num_end += 1) {
        const c = text[num_end];
        if (!(std.ascii.isDigit(c) or c == '+' or c == '-' or c == '.' or c == 'e' or c == 'E')) break;
    }
    var ans = std.fmt.parseFloat(PNum, text[0..num_end]) catch 0.0;
    if (text.len - num_end == 2) {
        const unit = text[num_end..];
        if (std.mem.eql(u8, unit, "cm")) ans /= 2.54
        else if (std.mem.eql(u8, unit, "mm")) ans /= 25.4
        else if (std.mem.eql(u8, unit, "px")) ans /= 96
        else if (std.mem.eql(u8, unit, "pt")) ans /= 72
        else if (std.mem.eql(u8, unit, "pc")) ans /= 6;
    }
    return ans;
}

// Append raw text to zOut
fn pik_append(p: *Pik, text: []const u8) void {
    p.zOut.writer.writeAll(text) catch pik_error(p, null, null);
}

// Given a string and its length, returns true if the string begins
// with a construct which syntactically matches an HTML entity escape
// sequence (without checking for whether it's a known entity). Always
// returns false if zText[0] is false or n<4. Entities match the
// equivalent of the regexes `&#[0-9]{2,};` and
// `&[a-zA-Z][a-zA-Z0-9]+;`.
fn pik_isentity(text: []const u8) bool {
    if (text.len < 4 or text[0] != '&') return false;
    if (text[1] == '#') {
        var i: usize = 2;
        while (i < text.len) : (i += 1) {
            if (i > 3 and text[i] == ';') return true;
            if (!std.ascii.isDigit(text[i])) return false;
        }
    } else {
        var i: usize = 1;
        while (i < text.len) : (i += 1) {
            if (i > 2 and text[i] == ';') return true;
            if (i > 1 and std.ascii.isDigit(text[i])) continue;
            if (!std.ascii.isAlphabetic(text[i])) return false;
        }
    }
    return false;
}

// Append text to zOut with HTML characters escaped.
//
//   *  The space character is changed into non-breaking space (U+00a0)
//      if mFlags has the 0x01 bit set. This is needed when outputting
//      text to preserve leading and trailing whitespace.  Turns out we
//      cannot use &nbsp; as that is an HTML-ism and is not valid in XML.
//
//   *  The "&" character is changed into "&amp;" if mFlags has the
//      0x02 bit set.  This is needed when generating error message text.
//
//   *  The '"' character is changed into "&quot;" if mFlags has the
//      0x04 bit set.  This is needed when creating XML attribute strings.
//      This 'attribute mode' also replaces '\n' with ' '.
//
//   *  Except for the above, only "<" and ">" are escaped.
fn pik_append_text(p: *Pik, text: []const u8, flags: i32) void {
    const b_q_space = (flags & 1) != 0;
    const b_q_amp = (flags & 2) != 0;
    const b_q_attr = (flags & 4) != 0;
    var rest = text;
    while (rest.len > 0) {
        var i: usize = 0;
        while (i < rest.len) : (i += 1) {
            const c = rest[i];
            if (c == '<' or c == '>') break;
            if (c == ' ' and b_q_space) break;
            if (c == '&' and b_q_amp) break;
            if (c == '"' and b_q_attr) break;
            if (c == '\n' and b_q_attr) break;
        }
        if (i != 0) pik_append(p, rest[0..i]);
        if (i == rest.len) break;
        switch (rest[i]) {
            '<' => pik_append(p, "&lt;"),
            '>' => pik_append(p, "&gt;"),
            ' ' => pik_append(p, "\xc2\xa0"),
            '\n' => pik_append(p, " "),
            '"' => pik_append(p, "&quot;"),
            '&' => {
                if (pik_isentity(rest[i..])) pik_append(p, "&") else pik_append(p, "&amp;");
            },
            else => {},
        }
        rest = rest[i + 1 ..];
    }
}

// Append a PNum value
fn pik_append_num_sig(p: *Pik, prefix: []const u8, v: PNum, comptime sig: i32) void {
    pik_append(p, prefix);
    if (std.math.isNan(v)) {
        pik_append(p, "nan");
        return;
    }
    if (std.math.isInf(v)) {
        if (v < 0.0) pik_append(p, "-");
        pik_append(p, "inf");
        return;
    }
    var buf: [128]u8 = undefined;
    const av = @abs(v);
    if (av == 0.0) {
        pik_append(p, "0");
        return;
    }
    const exp10: i32 = @intFromFloat(@floor(@log10(av)));
    const decimals: usize = if (exp10 >= sig - 1)
        0
    else if (exp10 >= 0)
        @intCast(@max(0, sig - 1 - exp10))
    else
        @intCast(sig - 1 - exp10);
    const raw = switch (decimals) {
        0 => std.fmt.bufPrint(&buf, "{d:.0}", .{v}),
        1 => std.fmt.bufPrint(&buf, "{d:.1}", .{v}),
        2 => std.fmt.bufPrint(&buf, "{d:.2}", .{v}),
        3 => std.fmt.bufPrint(&buf, "{d:.3}", .{v}),
        4 => std.fmt.bufPrint(&buf, "{d:.4}", .{v}),
        5 => std.fmt.bufPrint(&buf, "{d:.5}", .{v}),
        6 => std.fmt.bufPrint(&buf, "{d:.6}", .{v}),
        7 => std.fmt.bufPrint(&buf, "{d:.7}", .{v}),
        8 => std.fmt.bufPrint(&buf, "{d:.8}", .{v}),
        9 => std.fmt.bufPrint(&buf, "{d:.9}", .{v}),
        10 => std.fmt.bufPrint(&buf, "{d:.10}", .{v}),
        11 => std.fmt.bufPrint(&buf, "{d:.11}", .{v}),
        12 => std.fmt.bufPrint(&buf, "{d:.12}", .{v}),
        else => std.fmt.bufPrint(&buf, "{d:.13}", .{v}),
    } catch unreachable; // NoSpaceError won't happen
    var end = raw.len;
    if (std.mem.indexOfScalar(u8, raw, '.')) |_| {
        while (end > 0 and raw[end - 1] == '0') end -= 1;
        if (end > 0 and raw[end - 1] == '.') end -= 1;
    }
    if (end == 0 or std.mem.eql(u8, raw[0..end], "-0")) {
        pik_append(p, "0");
    } else {
        pik_append(p, raw[0..end]);
    }
}

fn pik_append_num(p: *Pik, prefix: []const u8, v: PNum) void {
    pik_append_num_sig(p, prefix, v, 6);
}

fn pik_append_num10(p: *Pik, prefix: []const u8, v: PNum) void {
    pik_append_num_sig(p, prefix, v, 10);
}

// Search for object located at *pCenter that has an xChop method and
// that does not enclose point pOther.
//
// Return a pointer to the object, or NULL if not found.
fn pik_find_chopper(list: ?*PList, center: *PPoint, other: *PPoint) ?*PObj {
    const l = list orelse return null;
    var i = l.n;
    while (i > 0) {
        i -= 1;
        var obj = l.a[i];
        if (obj.type != null and obj.type.?.xChop != null and
            obj.ptAt.x == center.x and
            obj.ptAt.y == center.y and
            !pik_bbox_contains_point(&obj.bbox, other))
        {
            return obj;
        } else if (obj.pSublist) |sublist| {
            obj = pik_find_chopper(sublist, center, other) orelse continue;
            return obj;
        }
    }
    return null;
}

// There is a line traveling from pFrom to pTo.
//
// If pObj is not null and is a choppable object, then chop at
// the boundary of pObj - where the line crosses the boundary
// of pObj.
//
// If pObj is NULL or has no xChop method, then search for some
// other object centered at pTo that is choppable and use it
// instead.
fn pik_autochop(p: *Pik, from: *PPoint, to: *PPoint, obj: ?*PObj) void {
    var o = obj;
    if (o == null or o.?.type == null or o.?.type.?.xChop == null) {
        o = pik_find_chopper(p.list, to, from);
    }
    if (o) |chopper| {
        if (chopper.type) |class| {
            if (class.xChop) |xchop| {
                to.* = xchop(p, chopper, from);
            }
        }
    }
}

fn pik_next_color_tag(tag: []u8) void {
    var i: usize = 3;
    while (tag[i] == 0) i -= 1;
    const len = i + 1;
    while (true) {
        if (tag[i] < 'z') {
            tag[i] += 1;
            return;
        }
        tag[i] = 'a';
        if (i == 0) {
            tag[len] = 'a';
            return;
        }
        i -= 1;
    }
}

fn pik_remember_color(p: *Pik, map: *ColorMap, value: PNum) void {
    const entry = map.getOrPut(p.allocator, value) catch {
        pik_error(p, null, null);
        return;
    };
    if (!entry.found_existing) {
        entry.value_ptr.* = p.varGen;
        pik_next_color_tag(&p.varGen);
    }
}

fn pik_color_tag_eq(a: ColorTag, b: ColorTag) bool {
    return std.mem.eql(u8, a[0..], b[0..]);
}

fn pik_append_color_tag(p: *Pik, tag: ColorTag) void {
    var i: usize = 0;
    while (i < tag.len and tag[i] != 0) : (i += 1) {}
    pik_append(p, tag[0..i]);
}

fn pik_color_for_tag(map: *const ColorMap, tag: ColorTag) ?PNum {
    var it = map.iterator();
    while (it.next()) |entry| {
        if (pik_color_tag_eq(entry.value_ptr.*, tag)) return entry.key_ptr.*;
    }
    return null;
}

fn pik_append_color_css_for_tag(p: *Pik, prefix: []const u8, property: []const u8, tag: ColorTag, color: PNum, is_bg: bool) void {
    pik_append(p, ".");
    pik_append(p, prefix);
    pik_append_color_tag(p, tag);
    pik_append(p, " {");
    pik_append(p, property);
    pik_append(p, ":");
    pik_append_clr(p, "", color, "", is_bg);
    pik_append(p, "}\n");
}

fn pik_append_color_css(p: *Pik) void {
    var tag: ColorTag = .{ 'a', 0, 0, 0 };
    while (!pik_color_tag_eq(tag, p.varGen)) {
        if (pik_color_for_tag(&p.hFill, tag)) |color| {
            pik_append_color_css_for_tag(p, "_f", "fill", tag, color, true);
        } else if (pik_color_for_tag(&p.hFgFill, tag)) |color| {
            pik_append_color_css_for_tag(p, "_f", "fill", tag, color, false);
        } else if (pik_color_for_tag(&p.hStroke, tag)) |color| {
            pik_append_color_css_for_tag(p, "_s", "stroke", tag, color, false);
        } else if (pik_color_for_tag(&p.hBgStroke, tag)) |color| {
            pik_append_color_css_for_tag(p, "_s", "stroke", tag, color, true);
        }
        pik_next_color_tag(&tag);
    }
}

// This routine runs after all attributes have been received
// on an object.
fn pik_after_adding_attributes(p: *Pik, obj: ?*PObj) void {
    const o = obj orelse return;
    if (p.nErr != 0) return;
    const class = o.type orelse return;
    const e_fill = pik_style_e_fill(o);
    const use_fill = o.fill >= 0.0 and e_fill != 0;

    if ((e_fill != 0 or class.isLine != 0) and o.sw >= 0.0 and o.color >= 0.0) {
        pik_remember_color(p, pik_style_stroke_map(p, o, e_fill), o.color);
    }
    if ((o.larrow != 0 or o.rarrow != 0) and o.sw > 0.0 and o.color >= 0.0) {
        pik_remember_color(p, &p.hStroke, o.color);
        pik_remember_color(p, &p.hFgFill, o.color);
    }
    if (o.nTxt != 0 and o.textcolor >= 0.0) {
        pik_remember_color(p, &p.hFgFill, o.textcolor);
    }
    if (use_fill) {
        pik_remember_color(p, pik_style_fill_map(p, o, e_fill), o.fill);
    }

    // Check for transparency
    if (!use_fill) {
        p.mAttr |= ATTR_FILL_NO;
    }

    // Position block objects
    if (class.isLine == 0) {
        // A height or width less than or equal to zero means "autofit".
        // Change the height or width to be big enough to contain the text,
        if (o.h <= 0.0) {
            if (o.nTxt == 0) {
                o.h = 0.0;
            } else if (o.w <= 0.0) {
                pik_size_to_fit(p, &o.errTok, 3);
            } else {
                pik_size_to_fit(p, &o.errTok, 2);
            }
        }
        if (o.w <= 0.0) {
            if (o.nTxt == 0) {
                o.w = 0.0;
            } else {
                pik_size_to_fit(p, &o.errTok, 1);
            }
        }
        const ofst = pik_elem_offset(p, o, o.eWith);
        const dx = (o.with.x - ofst.x) - o.ptAt.x;
        const dy = (o.with.y - ofst.y) - o.ptAt.y;
        if (dx != 0.0 or dy != 0.0) {
            pik_elem_move(o, dx, dy);
        }
    }

    // For a line object with no movement specified, a single movement
    // of the default length in the current direction
    if (class.isLine != 0 and p.nTPath < 2) {
        _ = pik_next_rpath(p, null);
        std.debug.assert(p.nTPath == 2);
        switch (o.inDir) {
            DIR_DOWN => p.aTPath[1].y -= o.h,
            DIR_LEFT => p.aTPath[1].x -= o.w,
            DIR_UP => p.aTPath[1].y += o.h,
            else => p.aTPath[1].x += o.w,
        }
        if (class.xInit == arcInit) {
            const turn: i32 = if (o.cw != 0) 1 else 3;
            o.outDir = @mod(o.inDir + turn, 4);
            p.eDir = @intCast(o.outDir);
            switch (o.outDir) {
                DIR_DOWN => p.aTPath[1].y -= o.h,
                DIR_LEFT => p.aTPath[1].x -= o.w,
                DIR_UP => p.aTPath[1].y += o.h,
                else => p.aTPath[1].x += o.w,
            }
        }
    }

    // Initialize the bounding box prior to running xCheck
    pik_bbox_init(&o.bbox);

    // Run object-specific code
    if (class.xCheck) |xcheck| {
        xcheck(p, o);
        if (p.nErr != 0) return;
    }

    // Compute final bounding box, entry and exit points, center
    // point (ptAt) and path for the object
    if (class.isLine != 0) {
        o.nPath = p.nTPath;
        const n: usize = @intCast(p.nTPath);
        o.aPath = p.allocator.dupe(PPoint, p.aTPath[0..n]) catch {
            pik_error(p, &o.errTok, null);
            return;
        };

        // "chop" processing:
        // If the line goes to the center of an object with an
        // xChop method, then use the xChop method to trim the line.
        if (o.bChop != 0 and o.nPath >= 2) {
            pik_autochop(p, &o.aPath[n - 2], &o.aPath[n - 1], o.pTo);
            pik_autochop(p, &o.aPath[1], &o.aPath[0], o.pFrom);
        }

        o.ptEnter = o.aPath[0];
        o.ptExit = o.aPath[n - 1];

        // Compute the center of the line based on the bounding box over
        // the vertexes.  This is a difference from PIC.  In Pikchr, the
        // center of a line is the center of its bounding box. In PIC, the
        // center of a line is halfway between its .start and .end.  For
        // straight lines, this is the same point, but for multi-segment
        // lines the result is usually diferent
        for (o.aPath[0..n]) |*pt| {
            pik_bbox_add_xy(&o.bbox, pt.x, pt.y);
        }
        o.ptAt.x = (o.bbox.ne.x + o.bbox.sw.x) / 2.0;
        o.ptAt.y = (o.bbox.ne.y + o.bbox.sw.y) / 2.0;

        // Reset the width and height of the object to be the width and height
        // of the bounding box over vertexes
        o.w = o.bbox.ne.x - o.bbox.sw.x;
        o.h = o.bbox.ne.y - o.bbox.sw.y;

        // If this is a polygon (if it has the "close" attribute), then
        // adjust the exit point
        if (o.bClose != 0) {
            // For "closed" lines, the .end is one of the .e, .s, .w, or .n
            // points of the bounding box, as with block objects.
            pik_elem_set_exit(o, o.inDir);
        }
    } else {
        const w2 = o.w / 2.0;
        const h2 = o.h / 2.0;
        o.ptEnter = o.ptAt;
        o.ptExit = o.ptAt;
        switch (o.inDir) {
            DIR_LEFT => o.ptEnter.x += w2,
            DIR_UP => o.ptEnter.y -= h2,
            DIR_DOWN => o.ptEnter.y += h2,
            else => o.ptEnter.x -= w2,
        }
        switch (o.outDir) {
            DIR_LEFT => o.ptExit.x -= w2,
            DIR_UP => o.ptExit.y += h2,
            DIR_DOWN => o.ptExit.y -= h2,
            else => o.ptExit.x += w2,
        }
        pik_bbox_add_xy(&o.bbox, o.ptAt.x - w2, o.ptAt.y - h2);
        pik_bbox_add_xy(&o.bbox, o.ptAt.x + w2, o.ptAt.y + h2);
    }
    p.eDir = @intCast(o.outDir);
}

// Return the offset from an object's center to a named edge/compass point.
fn pik_elem_offset(p: *Pik, obj: *PObj, cp: i32) PPoint {
    if (obj.type) |class| {
        if (class.xOffset) |x| return x(p, obj, cp);
    }
    return cZeroPoint;
}

// Move all coordinates contained within an object (and within its
// substructure) by dx, dy
fn pik_elem_move(obj: *PObj, dx: PNum, dy: PNum) void {
    obj.ptAt.x += dx;
    obj.ptAt.y += dy;
    obj.ptEnter.x += dx;
    obj.ptEnter.y += dy;
    obj.ptExit.x += dx;
    obj.ptExit.y += dy;
    obj.bbox.ne.x += dx;
    obj.bbox.ne.y += dy;
    obj.bbox.sw.x += dx;
    obj.bbox.sw.y += dy;
    const n_path: usize = if (obj.nPath > 0) @intCast(obj.nPath) else 0;
    for (obj.aPath[0..@min(obj.aPath.len, n_path)]) |*pt| {
        pt.x += dx;
        pt.y += dy;
    }
    if (obj.pSublist) |sub| pik_elist_move(sub, dx, dy);
}

// Move all coordinates contained within a list of objects by dx, dy.
fn pik_elist_move(list: *PList, dx: PNum, dy: PNum) void {
    for (list.a[0..list.n]) |obj| pik_elem_move(obj, dx, dy);
}

fn hasKind(tok: *const PToken, kind: TokenKind) bool {
    return tok.eType == @intFromEnum(kind);
}

fn tokenCodeSigned(tok: *const PToken) i16 {
    return @bitCast(tok.eCode);
}

// Check to see if it is ok to set the value of parameter mThis.
// Return 0 if it is ok. If it not ok, generate an appropriate
// error message and return non-zero.
//
// Flags are set in pObj so that the same object or conflicting
// objects may not be set again.
//
// To be ok, bit mThis must be clear and no more than one of
// the bits identified by mBlockers may be set.
fn pik_param_ok(p: *Pik, obj: *PObj, id: *PToken, mask: u32) i32 {
    if ((obj.mProp & mask) != 0) {
        pik_error(p, id, "value is already set");
        return 1;
    }
    if ((obj.mCalc & mask) != 0) {
        pik_error(p, id, "value already fixed by prior constraints");
        return 1;
    }
    obj.mProp |= mask;
    return 0;
}

//
// Set a numeric property like "width 7" or "radius 200%".
//
// The rAbs term is an absolute value to add in.  rRel is
// a relative value by which to change the current value.
fn pik_set_numprop(p: *Pik, prop: *PToken, val: *PRel) void {
    const obj = p.cur orelse return;
    var target: *PNum = undefined;
    var mask: u32 = 0;
    if (hasKind(prop, .WIDTH)) {
        target = &obj.w;
        mask = A_WIDTH;
    } else if (hasKind(prop, .HEIGHT)) {
        target = &obj.h;
        mask = A_HEIGHT;
    } else if (hasKind(prop, .RADIUS)) {
        target = &obj.rad;
        mask = A_RADIUS;
    } else if (hasKind(prop, .DIAMETER)) {
        target = &obj.rad;
        mask = A_RADIUS;
        val.rAbs *= 0.5;
        val.rRel *= 0.5;
    } else if (hasKind(prop, .THICKNESS)) {
        target = &obj.sw;
        mask = A_THICKNESS;
    } else {
        return;
    }
    if (pik_param_ok(p, obj, prop, mask) != 0) return;
    target.* = val.rAbs + target.* * val.rRel;
    if (obj.type) |class| if (class.xNumProp) |x| x(p, obj, prop);
}

// Set a color property.  The argument is an RGB value.
fn pik_set_clrprop(p: *Pik, prop: *PToken, val: PNum) void {
    const obj = p.cur orelse return;
    if (hasKind(prop, .FILL)) {
        if (pik_param_ok(p, obj, prop, A_FILL) != 0) return;
        obj.fill = val;
    } else if (hasKind(prop, .COLOR)) {
        if (pik_param_ok(p, obj, prop, A_COLOR) != 0) return;
        obj.color = val;
        // without these lines we would have a breaking change
        if (comptime pik_pedantic) {
            // Probably, setting fg color should not set textcolor, tho
            if ((obj.mProp & A_TEXTCOLOR) == 0) {
                obj.textcolor = val;
            }
        }
    } else if (hasKind(prop, .TEXTCOLOR)) {
        if (pik_param_ok(p, obj, prop, A_TEXTCOLOR) != 0) return;
        obj.textcolor = val;
    }
    if (obj.type) |class| if (class.xNumProp) |x| x(p, obj, prop);
}

// Set a "dashed" property like "dash 0.05"
//
// Use the value supplied by pVal if available.  If pVal==0, use
// a default.
fn pik_set_dashed(p: *Pik, prop: *PToken, val: ?*PNum) void {
    const obj = p.cur orelse return;
    const x = if (val) |v| v.* else pik_value(p, "dashwid", null);
    if (hasKind(prop, .DOTTED)) {
        obj.dotted = x;
        obj.dashed = 0.0;
    } else {
        obj.dashed = x;
        obj.dotted = 0.0;
    }
}

// If the current path information came from a "same" or "same as"
// reset it.
fn pik_reset_samepath(p: *Pik) void {
    if (p.samePath != 0) {
        p.samePath = 0;
        p.nTPath = 1;
    }
}

// Advance to the next entry in p->aTPath.  Return its index.
fn pik_next_rpath(p: *Pik, err: ?*PToken) i32 {
    var n = p.nTPath - 1;
    if (n + 1 >= p.aTPath.len) {
        pik_error(p, err, "too many path elements");
        return n;
    }
    n += 1;
    p.nTPath += 1;
    p.aTPath[@intCast(n)] = p.aTPath[@intCast(n - 1)];
    p.mTPath = 0;
    return n;
}

// Add a direction term to an object.  "up 0.5", or "left 3", or "down"
// or "down 50%".
fn pik_add_direction(p: *Pik, dir: ?*PToken, val: *PRel) void {
    const obj = p.cur orelse return;
    if (obj.type == null or obj.type.?.isLine == 0) {
        if (dir) |d| pik_error(p, d, "use with line-oriented objects only") else pik_error(p, &obj.errTok, "syntax error");
        return;
    }
    pik_reset_samepath(p);
    var n = p.nTPath - 1;
    if (p.thenFlag != 0 or p.mTPath == 3 or n == 0) {
        n = pik_next_rpath(p, dir);
        p.thenFlag = 0;
    }
    const d: i32 = if (dir) |dd| @intCast(dd.eCode) else @intCast(p.eDir);
    switch (d) {
        DIR_UP => {
            if ((p.mTPath & 2) != 0) n = pik_next_rpath(p, dir);
            p.aTPath[@intCast(n)].y += val.rAbs + obj.h * val.rRel;
            p.mTPath |= 2;
        },
        DIR_DOWN => {
            if ((p.mTPath & 2) != 0) n = pik_next_rpath(p, dir);
            p.aTPath[@intCast(n)].y -= val.rAbs + obj.h * val.rRel;
            p.mTPath |= 2;
        },
        DIR_RIGHT => {
            if ((p.mTPath & 1) != 0) n = pik_next_rpath(p, dir);
            p.aTPath[@intCast(n)].x += val.rAbs + obj.w * val.rRel;
            p.mTPath |= 1;
        },
        DIR_LEFT => {
            if ((p.mTPath & 1) != 0) n = pik_next_rpath(p, dir);
            p.aTPath[@intCast(n)].x -= val.rAbs + obj.w * val.rRel;
            p.mTPath |= 1;
        },
        else => {},
    }
    obj.outDir = d;
    p.thenFlag = 0;
}

// Process a movement attribute of the form "right until even with ..."
//
// pDir is the first keyword, "right" or "left" or "up" or "down".
// The movement is in that direction until its closest approach to
// the point specified by pPoint.
fn pik_evenwith(p: *Pik, dir: *PToken, place: *PPoint) void {
    const obj = p.cur orelse return;
    if (obj.type == null or obj.type.?.isLine == 0) {
        pik_error(p, dir, "use with line-oriented objects only");
        return;
    }
    pik_reset_samepath(p);
    var n = p.nTPath - 1;
    if (p.thenFlag != 0 or p.mTPath == 3 or n == 0) {
        n = pik_next_rpath(p, dir);
        p.thenFlag = 0;
    }
    switch (@as(i32, dir.eCode)) {
        DIR_DOWN, DIR_UP => {
            if ((p.mTPath & 2) != 0) n = pik_next_rpath(p, dir);
            p.aTPath[@intCast(n)].y = place.y;
            p.mTPath |= 2;
        },
        DIR_RIGHT, DIR_LEFT => {
            if ((p.mTPath & 1) != 0) n = pik_next_rpath(p, dir);
            p.aTPath[@intCast(n)].x = place.x;
            p.mTPath |= 1;
        },
        else => {},
    }
    obj.outDir = @intCast(dir.eCode);
}

// Prepend an XML class to a PObj.
//
// We prepend, rather than appending, because it's an O(1) operation, and the
// order of class names in a class attribute is not significant.
fn pik_xml_class_prepend(obj: *PObj, xprepend: ?*PXmlClass) void {
    const xnext = xprepend orelse return;
    xnext.pNext = obj.pXmlClass;
    obj.pXmlClass = xnext;
}

// XML Class Methods

// Set a single XML class on an Object.
//
fn pik_set_xml_class(p: *Pik, tok: *PToken) void {
    const obj = p.cur orelse return;
    if ((obj.mProp & A_CLASS) != 0) {
        pik_error(p, tok, "value already set");
        return;
    }
    if (tok.z.len != 0 and (tok.z[0] == '_' or tok.z[0] == '$' or tok.z[0] == '@')) {
        pik_error(p, tok, "illegal first character (_, $, or @) for class token");
        return;
    }
    const xnext = p.allocator.create(PXmlClass) catch {
        pik_error(p, null, null);
        return;
    };
    const name = p.allocator.dupe(u8, tok.z) catch {
        p.allocator.destroy(xnext);
        pik_error(p, null, null);
        return;
    };
    for (name) |*c| {
        if (c.* == '_') c.* = '-';
    }
    xnext.* = .zero;
    xnext.zClass = name;
    obj.mProp |= A_CLASS;
    pik_xml_class_prepend(obj, xnext);
}

// Set a list of XML classes on an object.
//
fn pik_set_xml_classes(p: *Pik, tok: *PToken) void {
    const obj = p.cur orelse return;
    if ((obj.mProp & A_CLASS) != 0) {
        pik_error(p, tok, "value already set");
        return;
    }
    var st: usize = 1;
    var tok_count: i32 = -1; // one token already counted
    var i: usize = 1;
    while (i < tok.z.len) : (i += 1) {
        const c = tok.z[i];
        if (c != ' ' and c != '\'') continue;
        if (i == st) {
            st = i + 1;
            continue;
        }
        const xnext = p.allocator.create(PXmlClass) catch {
            pik_error(p, null, null);
            return;
        };
        const name = p.allocator.dupe(u8, tok.z[st..i]) catch {
            p.allocator.destroy(xnext);
            pik_error(p, null, null);
            return;
        };
        for (name) |*ch| {
            if (ch.* == '_') ch.* = '-';
        }
        tok_count += 1;
        // We only hash the tokens in a class list, because the single-class
        // token is hashed in the tokenizer
        p.shaDigest.update(name);
        xnext.* = .zero;
        xnext.zClass = name;
        pik_xml_class_prepend(obj, xnext);
        st = i + 1;
    }
    if (tok_count > 0) {
        obj.mProp |= A_CLASS; // `class ''` is bad style but does not set a class
        p.nToken += @intCast(tok_count);
    }
}

fn pik_close_path(p: *Pik, err: *PToken) void {
    const obj = p.cur orelse return;
    if (p.nTPath < 3) {
        pik_error(p, err, "need at least 3 vertexes in order to close the polygon");
        return;
    }
    if (obj.bClose != 0) {
        pik_error(p, err, "polygon already closed");
        return;
    }
    obj.bClose = 1;
}

// Set the "from" of an object
fn pik_set_from(p: *Pik, obj: ?*PObj, tok: *PToken, pt: *PPoint) void {
    const o = obj orelse return;
    if (o.type == null or o.type.?.isLine == 0) {
        pik_error(p, tok, "use \"at\" to position this object");
        return;
    }
    if ((o.mProp & A_FROM) != 0) {
        pik_error(p, tok, "line start location already fixed");
        return;
    }
    if (o.bClose != 0) {
        pik_error(p, tok, "polygon is closed");
        return;
    }
    if (p.nTPath > 1) {
        const dx = pt.x - p.aTPath[0].x;
        const dy = pt.y - p.aTPath[0].y;
        var i: usize = 1;
        while (i < @as(usize, @intCast(p.nTPath))) : (i += 1) {
            p.aTPath[i].x += dx;
            p.aTPath[i].y += dy;
        }
    }
    p.aTPath[0] = pt.*;
    p.mTPath = 3;
    o.mProp |= A_FROM;
    o.pFrom = pik_last_ref_object(p, pt);
}

// Set the "to" of an object
fn pik_add_to(p: *Pik, obj: ?*PObj, tok: *PToken, pt: *PPoint) void {
    const o = obj orelse return;
    if (o.type == null or o.type.?.isLine == 0) {
        pik_error(p, tok, "use \"at\" to position this object");
        return;
    }
    if (o.bClose != 0) {
        pik_error(p, tok, "polygon is closed");
        return;
    }
    pik_reset_samepath(p);
    var n = p.nTPath - 1;
    if (n == 0 or p.mTPath == 3 or p.thenFlag != 0) n = pik_next_rpath(p, tok);
    p.aTPath[@intCast(n)] = pt.*;
    p.mTPath = 3;
    o.pTo = pik_last_ref_object(p, pt);
}

// Add a new term to the path for a line-oriented object by transferring
// the information in the ptTo field over onto the path and into ptFrom
// resetting the ptTo.
fn pik_then(p: *Pik, tok: *PToken, obj: ?*PObj) void {
    if (obj) |o| {
        if (o.type == null or o.type.?.isLine == 0) {
            pik_error(p, tok, "use with line-oriented objects only");
            return;
        }
        const n = p.nTPath - 1;
        if (n < 1 and (o.mProp & A_FROM) == 0) {
            pik_error(p, tok, "no prior path points");
            return;
        }
    }
    p.thenFlag = 1;
}

// Process a movement attribute of one of these forms:
//
//         pDist   pHdgKW  rHdg    pEdgept
//     GO distance HEADING angle
//     GO distance               compasspoint
fn pik_move_hdg(
    p: *Pik,
    rel: *PRel,
    hdg: ?*PToken,
    angle: PNum,
    edge: ?*PToken,
    err: *PToken,
) void {
    const obj = p.cur orelse return;
    var r_hdg = angle;
    const r_dist = rel.rAbs + pik_value(p, "linewid", null) * rel.rRel;
    if (obj.type == null or obj.type.?.isLine == 0) {
        pik_error(p, err, "use with line-oriented objects only");
        return;
    }
    pik_reset_samepath(p);
    var n: i32 = 0;
    while (true) {
        n = pik_next_rpath(p, err);
        if (n >= 1) break;
    }
    if (hdg != null) {
        r_hdg = @mod(r_hdg, 360.0);
    } else if (edge.?.eEdge == CP_C) {
        pik_error(p, edge.?, "syntax error");
        return;
    } else {
        r_hdg = pik_hdg_angle[edge.?.eEdge];
    }
    if (r_hdg <= 45.0) {
        obj.outDir = DIR_UP;
    } else if (r_hdg <= 135.0) {
        obj.outDir = DIR_RIGHT;
    } else if (r_hdg <= 225.0) {
        obj.outDir = DIR_DOWN;
    } else if (r_hdg <= 315.0) {
        obj.outDir = DIR_LEFT;
    } else {
        obj.outDir = DIR_UP;
    }
    r_hdg *= 0.017453292519943295769; // degrees to radians
    p.aTPath[@intCast(n)].x += r_dist * @sin(r_hdg);
    p.aTPath[@intCast(n)].y += r_dist * @cos(r_hdg);
    p.mTPath = 2;
}

// Set the "at" of an object
fn pik_set_at(p: *Pik, edge: ?*PToken, at: *PPoint, err: *PToken) void {
    const e_dir_to_cp = [_]u8{ CP_E, CP_S, CP_W, CP_N };
    if (p.nErr != 0) return;
    const obj = p.cur orelse return;

    if (obj.type != null and obj.type.?.isLine != 0) {
        pik_error(p, err, "use \"from\" and \"to\" to position this object");
        return;
    }
    if ((obj.mProp & A_AT) != 0) {
        pik_error(p, err, "location fixed by prior \"at\"");
        return;
    }
    obj.mProp |= A_AT;
    obj.eWith = if (edge) |e| e.eEdge else CP_C;
    if (obj.eWith >= CP_END) {
        const dir = if (obj.eWith == CP_END) obj.outDir else @mod(obj.inDir + 2, 4);
        obj.eWith = e_dir_to_cp[@intCast(dir)];
    }
    obj.with = at.*;
}

// Change most of the settings for the current object to be the
// same as the pOther object, or the most recent object of the same
// type if pOther is NULL.
fn pik_same(p: *Pik, other: ?*PObj, err: *PToken) void {
    const obj = p.cur orelse return;
    if (p.nErr != 0) return;
    var same_obj = other;
    if (same_obj == null) {
        if (p.list) |list| {
            var i = list.n;
            while (i > 0) {
                i -= 1;
                const candidate = list.a[i];
                if (candidate.type == obj.type) {
                    same_obj = candidate;
                    break;
                }
            }
        }
        if (same_obj == null) {
            pik_error(p, err, "no prior objects of the same type");
            return;
        }
    }
    const src = same_obj.?;
    if (src.nPath != 0 and obj.type != null and obj.type.?.isLine != 0) {
        const dx = p.aTPath[0].x - src.aPath[0].x;
        const dy = p.aTPath[0].y - src.aPath[0].y;
        var i: usize = 1;
        const n: usize = @intCast(src.nPath);
        while (i < n and i < p.aTPath.len and i < src.aPath.len) : (i += 1) {
            p.aTPath[i].x = src.aPath[i].x + dx;
            p.aTPath[i].y = src.aPath[i].y + dy;
        }
        p.nTPath = src.nPath;
        p.mTPath = 3;
        p.samePath = 1;
    }
    if (obj.type == null or obj.type.?.isLine == 0) {
        obj.w = src.w;
        obj.h = src.h;
    }
    obj.rad = src.rad;
    obj.sw = src.sw;
    obj.dashed = src.dashed;
    obj.dotted = src.dotted;
    obj.fill = src.fill;
    obj.color = src.color;
    obj.textcolor = src.textcolor;
    obj.cw = src.cw;
    obj.larrow = src.larrow;
    obj.rarrow = src.rarrow;
    obj.bClose = src.bClose;
    obj.bChop = src.bChop;
    obj.iLayer = src.iLayer;
}

// Try to add a text attribute to an object
fn pik_add_txt(p: *Pik, txt: *PToken, pos: u16) void {
    const obj = p.cur orelse return;
    if (obj.nTxt >= obj.aTxt.len) {
        pik_error(p, txt, "too many text terms");
        return;
    }
    p.mAttr |= ATTR_BASELINE;
    if ((pos & TP_BOLD) != 0) p.mAttr |= ATTR_F_BOLD;
    if ((pos & TP_ITALIC) != 0) p.mAttr |= ATTR_F_ITALIC;
    if ((pos & TP_MONO) != 0) p.mAttr |= ATTR_F_MONO;
    if ((pos & TP_LJUST) != 0) {
        p.mAttr |= ATTR_T_START;
    } else if ((pos & TP_RJUST) != 0) {
        p.mAttr |= ATTR_T_END;
    } else {
        p.mAttr |= ATTR_T_MIDDLE;
    }
    obj.aTxt[obj.nTxt] = txt.*;
    obj.aTxt[obj.nTxt].eCode = pos;
    obj.nTxt += 1;
}

// Adjust the width, height, and/or radius of the object so that
// it fits around the text that has been added so far.
//
//    (1) Only text specified prior to this attribute is considered.
//    (2) The text size is estimated based on the charht and charwid
//        variable settings.
//    (3) The fitted attributes can be changed again after this
//        attribute, for example using "width 110%" if this auto-fit
//        underestimates the text size.
//    (4) Previously set attributes will not be altered.  In other words,
//        "width 1in fit" might cause the height to change, but the
//        width is now set.
//    (5) This only works for attributes that have an xFit method.
//
// The eWhich parameter is:
//
//    1:   Fit horizontally only
//    2:   Fit vertically only
//    3:   Fit both ways
fn pik_size_to_fit(p: *Pik, fit: *PToken, which: i32) void {
    const obj = p.cur orelse return;
    if (p.nErr != 0) return;
    if (obj.nTxt == 0) {
        pik_error(p, fit, "no text to fit to");
        return;
    }
    const class = obj.type orelse return;
    const xfit = class.xFit orelse return;
    var bbox: PBox = undefined;
    pik_bbox_init(&bbox);
    pik_compute_layout_settings(p);
    pik_append_txt(p, obj, &bbox);
    const w = if ((which & 1) != 0 or obj.bAltAutoFit != 0)
        (bbox.ne.x - bbox.sw.x) + p.charWidth
    else
        0.0;
    const h = if ((which & 2) != 0 or obj.bAltAutoFit != 0) blk: {
        const h1 = bbox.ne.y - obj.ptAt.y;
        const h2 = obj.ptAt.y - bbox.sw.y;
        break :blk 2.0 * @max(h1, h2) + 0.5 * p.charHeight;
    } else 0.0;
    xfit(p, obj, w, h);
    obj.mProp |= A_FIT;
}

// Lower the layer of the current object so that it is behind the
// given object.
fn pik_behind(p: *Pik, other: ?*PObj) void {
    const obj = p.cur orelse return;
    const o = other orelse return;
    if (p.nErr == 0 and obj.iLayer >= o.iLayer) {
        obj.iLayer = o.iLayer - 1;
    }
}

// Merge "text-position" flags
fn pik_text_position(prev: u16, flag: *PToken) u16 {
    var res: u16 = prev;
    switch (yyEnum(flag.eType)) {
        .LJUST => res = (res & ~TP_JMASK) | TP_LJUST,
        .RJUST => res = (res & ~TP_JMASK) | TP_RJUST,
        .ABOVE => res = (res & ~TP_VMASK) | TP_ABOVE,
        .CENTER => res = (res & ~TP_VMASK) | TP_CENTER,
        .BELOW => res = (res & ~TP_VMASK) | TP_BELOW,
        .ITALIC => res |= TP_ITALIC,
        .BOLD => res |= TP_BOLD,
        .MONO => res |= TP_MONO,
        .ALIGNED => res |= TP_ALIGN,
        .BIG => {
            if ((res & TP_BIG) != 0) res |= TP_XTRA else res = (res & ~TP_SZMASK) | TP_BIG;
        },
        .SMALL => {
            if ((res & TP_SMALL) != 0) res |= TP_XTRA else res = (res & ~TP_SZMASK) | TP_SMALL;
        },
        else => {},
    }
    return res;
}

// Do a linear interpolation of two positions.
fn pik_position_between(x: PNum, p1: PPoint, p2: PPoint) PPoint {
    return .{
        .x = p1.x + x * (p2.x - p1.x),
        .y = p1.y + x * (p2.y - p1.y),
    };
}

// Compute the position that is dist away from pt at an heading angle of r
//
// The angle is a compass heading in degrees.  North is 0 (or 360).
// East is 90.  South is 180.  West is 270.  And so forth.
fn pik_position_at_angle(dist: PNum, r: PNum, pt: PPoint) PPoint {
    const a = std.math.degreesToRadians(r);
    return .{ .x = pt.x + dist * @sin(a), .y = pt.y + dist * @cos(a) };
}

// Compute the position that is dist away at a compass point
fn pik_position_at_hdg(dist: PNum, d: *PToken, pt: PPoint) PPoint {
    return pik_position_at_angle(dist, pik_hdg_angle[d.eEdge], pt);
}

fn pik_rint(x: PNum) PNum {
    const f = @floor(x);
    const d = x - f;
    if (d < 0.5) return f;
    if (d > 0.5) return f + 1.0;
    const i: i64 = @intFromFloat(f);
    if (@mod(i, 2) == 0) return f;
    return f + 1.0;
}

// When a line runs from or to the center of an object, and "chop" is used
// the line is automatically truncated at the edge of the object.  Ex:
//
//        arrow from OBJ1 to OBJ2 chop
//
// The arrow object is normally just handed the coordinates of the
// centers for OBJ1 and OBJ2.  But we also want to know the specific
// object named in case there are multiple objects centered at the
// same point.
//
// See forum post 1d46e3a0bc
fn pik_last_ref_object(p: *Pik, pt: *PPoint) ?*PObj {
    var res: ?*PObj = null;
    const last = p.lastRef orelse return null;
    if (last.ptAt.x == pt.x and last.ptAt.y == pt.y) {
        res = last;
    }
    p.lastRef = null;
    return res;
}

// Return a "Place" associated with object pObj.  If pEdge is NULL
// return the center of the object.  Otherwise, return the corner
// described by pEdge.
fn pik_place_of_elem(p: *Pik, obj: ?*PObj, edge: ?*PToken) PPoint {
    const o = obj orelse return cZeroPoint;
    if (edge == null) return o.ptAt;
    const e = edge.?;
    if (hasKind(e, .START)) return o.ptEnter;
    if (hasKind(e, .END)) return o.ptExit;
    const cp = e.eEdge;
    const offset = pik_elem_offset(p, o, cp);
    p.lastRef = o;
    return .{ .x = o.ptAt.x + offset.x, .y = o.ptAt.y + offset.y };
}

// Return the coordinates for the n-th vertex of a line.
fn pik_nth_vertex(p: *Pik, nth: *PToken, err: *PToken, obj: ?*PObj) PPoint {
    if (p.nErr != 0 or obj == null) return p.aTPath[0];
    const o = obj.?;
    if (o.type == null or o.type.?.isLine == 0) {
        pik_error(p, err, "object is not a line");
        return cZeroPoint;
    }
    var n: i32 = 0;
    for (nth.z) |c| {
        if (!std.ascii.isDigit(c)) break;
        n = n * 10 + @as(i32, c - '0');
    }
    if (n < 1 or n > o.nPath) {
        pik_error(p, nth, "no such vertex");
        return cZeroPoint;
    }
    return o.aPath[@intCast(n - 1)];
}

// Search for the NTH object.
//
// If pBasis is not NULL then it should be a [] object.  Use the
// sublist of that [] object for the search.  If pBasis is not a []
// object, then throw an error.
//
// The pNth token describes the N-th search.  The pNth->eCode value
// is one more than the number of items to skip.  It is negative
// to search backwards.  If pNth->eType==T_ID, then it is the name
// of a class to search for.  If pNth->eType==T_LB, then
// search for a [] object.  If pNth->eType==T_LAST, then search for
// any type.
//
// Raise an error if the item is not found.
fn pik_find_nth(p: *Pik, basis: ?*PObj, nth: *PToken) ?*PObj {
    const list = if (basis) |b| b.pSublist else p.list;
    const l = list orelse {
        pik_error(p, nth, "no such object");
        return null;
    };
    const class: ?*const PClass = switch (yyEnum(nth.eType)) {
        .LAST => null,
        .LB => &sublistClass,
        else => pik_find_class(nth) orelse {
            pik_error(p, nth, "no such object type");
            return null;
        },
    };
    var n: i32 = tokenCodeSigned(nth);
    if (n < 0) {
        var i = l.n;
        while (i > 0) {
            i -= 1;
            const obj = l.a[i];
            if (class) |c| {
                if (obj.type != c) continue;
            }
            n += 1;
            if (n == 0) return obj;
        }
    } else {
        for (l.a[0..l.n]) |obj| {
            if (class) |c| {
                if (obj.type != c) continue;
            }
            n -= 1;
            if (n == 0) return obj;
        }
    }
    pik_error(p, nth, "no such object");
    return null;
}

// Search for an object by name.
//
// Search in pBasis->pSublist if pBasis is not NULL.  If pBasis is NULL
// then search in p->list.
fn pik_find_byname(p: *Pik, basis: ?*PObj, name: *PToken) ?*PObj {
    const list = if (basis) |b| b.pSublist else p.list;
    const l = list orelse {
        pik_error(p, name, "no such object");
        return null;
    };
    // First look explicitly tagged objects
    var i = l.n;
    while (i > 0) {
        i -= 1;
        const obj = l.a[i];
        if (std.mem.eql(u8, obj.zName, name.z)) {
            p.lastRef = obj;
            return obj;
        }
    }
    // If not found, do a second pass looking for any object containing
    // text which exactly matches pName
    i = l.n;
    while (i > 0) {
        i -= 1;
        const obj = l.a[i];
        for (obj.aTxt[0..obj.nTxt]) |txt| {
            if (txt.z.len == name.z.len + 2 and std.mem.eql(u8, txt.z[1 .. 1 + name.z.len], name.z)) {
                p.lastRef = obj;
                return obj;
            }
        }
    }
    pik_error(p, name, "no such object");
    return null;
}

// Convert a T_NTH token (ex: "2nd", "5th"} into a numeric value and
// return that value.  Throw an error if the value is too big.
fn pik_nth_value(p: *Pik, nth: *PToken) i16 {
    var i: usize = 0;
    while (i < nth.z.len and std.ascii.isDigit(nth.z[i])) : (i += 1) {}
    var v: i32 = if (i == 0) 0 else std.fmt.parseInt(i32, nth.z[0..i], 10) catch 0;
    if (v > 1000) {
        pik_error(p, nth, "value too big - max '1000th'");
        v = 1;
    }
    if (v == 0 and pik_token_eq(nth, "first") == 0) v = 1;
    return @intCast(v);
}

// Return the value of a property of an object.
fn pik_property_of(obj: ?*PObj, prop: *PToken) PNum {
    const o = obj orelse return 0.0;
    return switch (yyEnum(prop.eType)) {
        .HEIGHT => o.h,
        .WIDTH => o.w,
        .RADIUS => o.rad,
        .DIAMETER => o.rad * 2.0,
        .THICKNESS => o.sw,
        .DASHED => o.dashed,
        .DOTTED => o.dotted,
        .FILL => o.fill,
        .COLOR => o.color,
        .TEXTCOLOR => o.textcolor,
        .X => o.ptAt.x,
        .Y => o.ptAt.y,
        .TOP => o.bbox.ne.y,
        .BOTTOM => o.bbox.sw.y,
        .LEFT => o.bbox.sw.x,
        .RIGHT => o.bbox.ne.x,
        else => 0.0,
    };
}

// Compute one of the built-in functions
fn pik_func(p: *Pik, func: *PToken, x: PNum, y: PNum) PNum {
    return switch (func.eCode) {
        FN_ABS => if (x < 0.0) -x else x,
        FN_COS => @cos(x),
        FN_INT => pik_rint(x),
        FN_SIN => @sin(x),
        FN_SQRT => blk: {
            if (x < 0.0) {
                pik_error(p, func, "sqrt of negative value");
                break :blk 0.0;
            }
            break :blk @sqrt(x);
        },
        FN_MAX => @max(x, y),
        FN_MIN => @min(x, y),
        else => 0.0,
    };
}

// Compute the distance between two points
fn pik_dist(a: *PPoint, b: *PPoint) PNum {
    return std.math.hypot(a.x - b.x, a.y - b.y);
}

// Return true if a bounding box is empty.
fn pik_bbox_isempty(box: *PBox) bool {
    return box.sw.x > box.ne.x;
}

// Return true if point pPt is contained within the bounding box pBox
fn pik_bbox_contains_point(box: *PBox, pt: *PPoint) bool {
    if (pik_bbox_isempty(box)) return false;
    if (pt.x < box.sw.x) return false;
    if (pt.x > box.ne.x) return false;
    if (pt.y < box.sw.y) return false;
    if (pt.y > box.ne.y) return false;
    return true;
}

// Initialize a bounding box to an empty container
fn pik_bbox_init(box: *PBox) void {
    box.sw.x = 1.0;
    box.sw.y = 1.0;
    box.ne.x = 0.0;
    box.ne.y = 0.0;
}

// Enlarge the PBox of the first argument so that it fully
// covers the second PBox
fn pik_bbox_addbox(a: *PBox, b: *PBox) void {
    if (pik_bbox_isempty(a)) a.* = b.*;
    if (pik_bbox_isempty(b)) return;
    if (a.sw.x > b.sw.x) a.sw.x = b.sw.x;
    if (a.sw.y > b.sw.y) a.sw.y = b.sw.y;
    if (a.ne.x < b.ne.x) a.ne.x = b.ne.x;
    if (a.ne.y < b.ne.y) a.ne.y = b.ne.y;
}

// Enlarge the PBox of the first argument, if necessary, so that
// it contains the point described by the 2nd and 3rd arguments.
fn pik_bbox_add_xy(box: *PBox, x: PNum, y: PNum) void {
    if (pik_bbox_isempty(box)) {
        box.ne.x = x;
        box.ne.y = y;
        box.sw.x = x;
        box.sw.y = y;
        return;
    }
    if (box.sw.x > x) box.sw.x = x;
    if (box.sw.y > y) box.sw.y = y;
    if (box.ne.x < x) box.ne.x = x;
    if (box.ne.y < y) box.ne.y = y;
}

// Enlarge the PBox so that it is able to contain an ellipse
// centered at x,y and with radiuses rx and ry.
fn pik_bbox_addellipse(box: *PBox, x: PNum, y: PNum, rx: PNum, ry: PNum) void {
    if (pik_bbox_isempty(box)) {
        box.ne.x = x + rx;
        box.ne.y = y + ry;
        box.sw.x = x - rx;
        box.sw.y = y - ry;
        return;
    }
    if (box.sw.x > x - rx) box.sw.x = x - rx;
    if (box.sw.y > y - ry) box.sw.y = y - ry;
    if (box.ne.x < x + rx) box.ne.x = x + rx;
    if (box.ne.y < y + ry) box.ne.y = y + ry;
}

// Process an "assert( e1 == e2 )" statement.  Always return NULL.
fn pik_assert(p: *Pik, e1: PNum, eq: *PToken, e2: PNum) ?*PObj {
    if (e1 != e2) {
        var buf: [300]u8 = undefined;
        const msg = std.fmt.bufPrint(&buf, "{d} != {d}", .{ e1, e2 }) catch "";
        pik_error(p, eq, msg);
    }
    return null;
}

// Process an "assert( place1 == place2 )" statement.  Always return NULL.
fn pik_position_assert(p: *Pik, e1: *PPoint, eq: *PToken, e2: *PPoint) ?*PObj {
    if (e1.x != e2.x or e1.y != e2.y) {
        var buf: [210]u8 = undefined;
        const msg = std.fmt.bufPrint(&buf, "({d},{d}) != ({d},{d})", .{ e1.x, e1.y, e2.x, e2.y }) catch "";
        pik_error(p, eq, msg);
    }
    return null;
}

// If the ID token in the argument is the name of a macro, return
// the PMacro object for that macro
fn pik_find_macro(p: *Pik, id: *PToken) ?*PMacro {
    var mac = p.pMacros;
    while (mac) |m| : (mac = m.pNext) {
        if (std.mem.eql(u8, m.macroName.z, id.z)) {
            return m;
        }
    }
    return null;
}

// Add a new macro
fn pik_add_macro(p: *Pik, id: *PToken, code: *PToken) void {
    var new = pik_find_macro(p, id);
    if (new == null) {
        new = p.allocator.create(PMacro) catch {
            pik_error(p, null, null);
            return;
        };
        new.?.* = .zero;
        new.?.pNext = p.pMacros;
        new.?.macroName = id.*;
        p.pMacros = new;
    }
    new.?.macroBody = .zero;
    new.?.macroBody.z = if (code.z.len >= 2) code.z[1 .. code.z.len - 1] else "";
    new.?.inUse = 0;
}

fn setTokenType(token: *PToken, kind: TokenKind) void {
    token.eType = @intFromEnum(kind);
}

fn findKeyword(text: []const u8) ?PikWord {
    for (pik_keywords) |word| {
        if (std.mem.eql(u8, word.zWord, text)) return word;
    }
    return null;
}

fn isIdentChar(c: u8) bool {
    return std.ascii.isAlphanumeric(c) or c == '_';
}

fn tokenKind(token: *const PToken) TokenKind {
    return @enumFromInt(token.eType);
}

// Search a PikWordlist for the given keyword.  Return a pointer to the
// keyword entry found.  Or return 0 if not found.
fn pik_find_word(z_in: []const u8) ?PikWord {
    return findKeyword(z_in);
}

// Set a symbolic debugger breakpoint on this routine to receive a
// breakpoint when the "#breakpoint" token is parsed.
fn pik_breakpoint(z: []const u8) void {
    // Prevent C compilers from optimizing out this routine.
    if (z.len > 2 and z[2] == 'X') unreachable;
}

// Return the length of next token.  The token starts on
// the pToken->z character.  Fill in other fields of the
// pToken object as appropriate.
fn pik_token_length(token: *PToken, allow_codeblock: bool) usize {
    const z = token.z;
    if (z.len == 0) {
        setTokenType(token, .end_of_input);
        return 0;
    }
    switch (z[0]) {
        '\\' => {
            token.eType = T_WHITESPACE;
            var i: usize = 1;
            while (i < z.len and (z[i] == '\r' or z[i] == ' ' or z[i] == '\t')) : (i += 1) {}
            if (i < z.len and z[i] == '\n') return i + 1;
            token.eType = T_ERROR;
            return 1;
        },
        ';', '\n' => {
            setTokenType(token, .EOL);
            return 1;
        },
        '"' => {
            var i: usize = 1;
            while (i < z.len) : (i += 1) {
                if (z[i] == '\\') {
                    if (i + 1 >= z.len) break;
                    i += 1;
                    continue;
                }
                if (z[i] == '"') {
                    setTokenType(token, .STRING);
                    return i + 1;
                }
            }
            token.eType = T_ERROR;
            return i;
        },
        ' ', '\t', '\x0c', '\r' => {
            var i: usize = 1;
            while (i < z.len and (z[i] == ' ' or z[i] == '\t' or z[i] == '\r' or z[i] == '\x0c')) : (i += 1) {}
            token.eType = T_WHITESPACE;
            return i;
        },
        '#' => {
            var i: usize = 1;
            while (i < z.len and z[i] != '\n') : (i += 1) {}
            token.eType = T_WHITESPACE;
            // If the comment is "#breakpoint" then invoke the pik_breakpoint()
            // routine.  The pik_breakpoint() routie is a no-op that serves as
            // a convenient place to set a gdb breakpoint when debugging.
            if (std.mem.startsWith(u8, z, "#breakpoint")) pik_breakpoint(z);
            return i;
        },
        '/' => {
            if (z.len > 1 and z[1] == '*') {
                var i: usize = 2;
                while (i + 1 < z.len and !(z[i] == '*' and z[i + 1] == '/')) : (i += 1) {}
                if (i + 1 < z.len and z[i] == '*') {
                    token.eType = T_WHITESPACE;
                    return i + 2;
                }
                token.eType = T_ERROR;
                return i;
            } else if (z.len > 1 and z[1] == '/') {
                var i: usize = 2;
                while (i < z.len and z[i] != '\n') : (i += 1) {}
                token.eType = T_WHITESPACE;
                return i;
            } else if (z.len > 1 and z[1] == '=') {
                setTokenType(token, .ASSIGN);
                token.eCode = @intFromEnum(TokenKind.SLASH);
                return 2;
            }
            setTokenType(token, .SLASH);
            return 1;
        },
        '+' => {
            if (z.len > 1 and z[1] == '=') {
                setTokenType(token, .ASSIGN);
                token.eCode = @intFromEnum(TokenKind.PLUS);
                return 2;
            }
            setTokenType(token, .PLUS);
            return 1;
        },
        '*' => {
            if (z.len > 1 and z[1] == '=') {
                setTokenType(token, .ASSIGN);
                token.eCode = @intFromEnum(TokenKind.STAR);
                return 2;
            }
            setTokenType(token, .STAR);
            return 1;
        },
        '%' => { setTokenType(token, .PERCENT); return 1; },
        '(' => { setTokenType(token, .LP); return 1; },
        ')' => { setTokenType(token, .RP); return 1; },
        '[' => { setTokenType(token, .LB); return 1; },
        ']' => { setTokenType(token, .RB); return 1; },
        ',' => { setTokenType(token, .COMMA); return 1; },
        ':' => { setTokenType(token, .COLON); return 1; },
        '>' => { setTokenType(token, .GT); return 1; },
        '=' => {
            if (z.len > 1 and z[1] == '=') {
                setTokenType(token, .EQ);
                return 2;
            }
            setTokenType(token, .ASSIGN);
            token.eCode = @intFromEnum(TokenKind.ASSIGN);
            return 1;
        },
        '-' => {
            if (z.len > 1 and z[1] == '>') {
                setTokenType(token, .RARROW);
                return 2;
            } else if (z.len > 1 and z[1] == '=') {
                setTokenType(token, .ASSIGN);
                token.eCode = @intFromEnum(TokenKind.MINUS);
                return 2;
            }
            setTokenType(token, .MINUS);
            return 1;
        },
        '<' => {
            if (z.len > 1 and z[1] == '-') {
                if (z.len > 2 and z[2] == '>') {
                    setTokenType(token, .LRARROW);
                    return 3;
                }
                setTokenType(token, .LARROW);
                return 2;
            }
            setTokenType(token, .LT);
            return 1;
        },
        0xe2 => {
            if (z.len > 2 and z[1] == 0x86) {
                if (z[2] == 0x90) {
                    setTokenType(token, .LARROW); // <-
                    return 3;
                }
                if (z[2] == 0x92) {
                    setTokenType(token, .RARROW); // ->
                    return 3;
                }
                if (z[2] == 0x94) {
                    setTokenType(token, .LRARROW); // <->
                    return 3;
                }
            }
            token.eType = T_ERROR;
            return 1;
        },
        '{' => {
            var i: usize = 1;
            var depth: i32 = if (allow_codeblock) 1 else 0;
            while (i < z.len and depth > 0) {
                var x: PToken = .zero;
                x.z = z[i..];
                const len = pik_token_length(&x, false);
                if (len == 1) {
                    if (z[i] == '{') depth += 1;
                    if (z[i] == '}') depth -= 1;
                }
                i += len;
            }
            if (depth != 0) {
                token.eType = T_ERROR;
                return 1;
            }
            setTokenType(token, .CODEBLOCK);
            return i;
        },
        '&' => {
            const Entity = struct { text: []const u8, kind: TokenKind };
            const entities = [_]Entity{
                .{ .text = "&rarr;", .kind = .RARROW },
                .{ .text = "&rightarrow;", .kind = .RARROW },
                .{ .text = "&larr;", .kind = .LARROW },
                .{ .text = "&leftarrow;", .kind = .LARROW },
                .{ .text = "&leftrightarrow;", .kind = .LRARROW },
            };
            for (entities) |entity| {
                if (std.mem.startsWith(u8, z, entity.text)) {
                    setTokenType(token, entity.kind);
                    return entity.text.len;
                }
            }
            token.eType = T_ERROR;
            return 1;
        },
        '\'' => {
            // Each token must start with a lower letter
            var first = true;
            var i: usize = 1;
            while (i < z.len) : (i += 1) {
                if (z[i] == ' ') {
                    first = true;
                } else if (first and std.ascii.isLower(z[i])) {
                    first = false;
                } else if (!first and (std.ascii.isAlphanumeric(z[i]) or z[i] == '_')) {
                    continue;
                } else if (z[i] == '\'') {
                    setTokenType(token, .XML_CLASSES);
                    return i + 1;
                } else {
                    token.eType = T_ERROR;
                    return i;
                }
            }
            token.eType = T_ERROR;
            return i;
        },
        else => return pik_token_length_default(token),
    }
}

fn pik_token_length_default(token: *PToken) usize {
    const z = token.z;
    var c = z[0];
    var i: usize = 0;
    if (c == '.') {
        const c1 = if (z.len > 1) z[1] else 0;
        if (std.ascii.isLower(c1)) {
            i = 2;
            while (i < z.len and std.ascii.isLower(z[i])) : (i += 1) {}
            if (pik_find_word(z[1..i])) |found| {
                if (found.eEdge > 0 or found.eType == .EDGEPT or found.eType == .START or found.eType == .END) {
                    // Dot followed by something that is a 2-D place value
                    setTokenType(token, .DOT_E);
                } else if (found.eType == .X or found.eType == .Y) {
                    // Dot followed by "x" or "y"
                    setTokenType(token, .DOT_XY);
                } else {
                    // Any other "dot"
                    setTokenType(token, .DOT_L);
                }
            } else {
                setTokenType(token, .DOT_L);
            }
            return 1;
        } else if (std.ascii.isDigit(c1)) {
            i = 0;
        } else if (std.ascii.isUpper(c1)) {
            i = 2;
            while (i < z.len and isIdentChar(z[i])) : (i += 1) {}
            setTokenType(token, .DOT_U);
            return 1;
        } else {
            token.eType = T_ERROR;
            return 1;
        }
    }
    if (std.ascii.isDigit(c) or c == '.') {
        var n_digit: usize = 0;
        var is_int = true;
        if (c != '.') {
            n_digit = 1;
            i = 1;
            while (i < z.len and std.ascii.isDigit(z[i])) : (i += 1) n_digit += 1;
            c = if (i < z.len) z[i] else 0;
            if (i == 1 and (c == 'x' or c == 'X') and z[0] == '0') {
                i = 2;
                while (i < z.len and std.ascii.isHex(z[i])) : (i += 1) {}
                setTokenType(token, .NUMBER);
                return i;
            }
        } else {
            is_int = false;
            n_digit = 0;
            i = 0;
            c = '.';
        }
        if (c == '.') {
            is_int = false;
            i += 1;
            while (i < z.len and std.ascii.isDigit(z[i])) : (i += 1) n_digit += 1;
            c = if (i < z.len) z[i] else 0;
        }
        if (n_digit == 0) {
            token.eType = T_ERROR;
            return i;
        }
        if (c == 'e' or c == 'E') {
            const before = i;
            i += 1;
            var c2 = if (i < z.len) z[i] else 0;
            if (c2 == '+' or c2 == '-') {
                i += 1;
                c2 = if (i < z.len) z[i] else 0;
            }
            if (!std.ascii.isDigit(c2)) {
                i = before;
            } else {
                i += 1;
                is_int = false;
                while (i < z.len and std.ascii.isDigit(z[i])) : (i += 1) {}
            }
            c = if (i < z.len) z[i] else 0;
        }
        const c2 = if (i + 1 < z.len) z[i + 1] else 0;
        if (is_int and ((c == 't' and c2 == 'h') or (c == 'r' and c2 == 'd') or (c == 'n' and c2 == 'd') or (c == 's' and c2 == 't'))) {
            setTokenType(token, .NTH);
            return i + 2;
        }
        if ((c == 'i' and c2 == 'n') or (c == 'c' and c2 == 'm') or (c == 'm' and c2 == 'm') or (c == 'p' and (c2 == 't' or c2 == 'x' or c2 == 'c'))) {
            i += 2;
        }
        setTokenType(token, .NUMBER);
        return i;
    } else if (std.ascii.isLower(c)) {
        i = 1;
        while (i < z.len and isIdentChar(z[i])) : (i += 1) {}
        if (pik_find_word(z[0..i])) |found| {
            setTokenType(token, found.eType);
            token.eCode = found.eCode;
            token.eEdge = found.eEdge;
            return i;
        }
        token.z = z[0..i];
        if (pik_find_class(token) != null) {
            setTokenType(token, .CLASSNAME);
        } else {
            setTokenType(token, .ID);
        }
        return i;
    } else if (std.ascii.isUpper(c)) {
        i = 1;
        while (i < z.len and isIdentChar(z[i])) : (i += 1) {}
        setTokenType(token, .PLACENAME);
        return i;
    } else if (c == '$' and z.len > 1 and z[1] >= '1' and z[1] <= '9' and !(z.len > 2 and std.ascii.isDigit(z[2]))) {
        token.eType = T_PARAMETER;
        token.eCode = z[1] - '1';
        return 2;
    } else if (c == '_' or c == '$' or c == '@') {
        i = 1;
        while (i < z.len and isIdentChar(z[i])) : (i += 1) {}
        setTokenType(token, .ID);
        return i;
    }
    token.eType = T_ERROR;
    return 1;
}

var pikchr_call_count: u32 = 0;

fn pik_set_id(p: *Pik) void {
    var digest: [std.crypto.hash.Sha1.digest_length]u8 = undefined;
    var sha = p.shaDigest;
    sha.final(&digest);
    const id = p.allocator.alloc(u8, 11) catch {
        pik_error(p, null, null);
        return;
    };
    const hex = "0123456789abcdef";
    id[0] = '-';
    for (digest[0..5], 0..) |b, i| {
        id[1 + i * 2] = hex[(b >> 4) & 0x0f];
        id[2 + i * 2] = hex[b & 0x0f];
    }
    p.zID = id;
}

// Parser arguments to a macro invocation
//
//     (arg1, arg2, ...)
//
// Arguments are comma-separated, except that commas within string
// literals or with (...), {...}, or [...] do not count.  The argument
// list begins and ends with parentheses.  There can be at most 9
// arguments.
//
// Return the number of bytes in the argument list.
fn pik_parse_macro_args(
    p: *Pik,
    z: []const u8, // Start of the argument list
    args: []PToken, // Fill in with the arguments
    outer: ?[]PToken, // Arguments of the next outer context, or NULL
) usize {
    if (z.len == 0 or z[0] != '(') return 0;
    var n_arg: usize = 0;
    var i_start: usize = 1;
    var depth: i32 = 0;
    args[0].z = z[1..1];
    var i: usize = 1;
    while (i < z.len and z[i] != ')') {
        var x: PToken = .zero;
        x.z = z[i..];
        const sz = pik_token_length(&x, false);
        if (sz == 1) {
            if (z[i] == ',' and depth <= 0) {
                args[n_arg].z = z[i_start..i];
                if (n_arg == 8) {
                    var err: PToken = .zero;
                    err.z = z[0..1];
                    pik_error(p, &err, "too many macro arguments - max 9");
                    return 0;
                }
                n_arg += 1;
                args[n_arg].z = z[i + 1 .. i + 1];
                i_start = i + 1;
                depth = 0;
            } else if (z[i] == '(' or z[i] == '{' or z[i] == '[') {
                depth += 1;
            } else if (z[i] == ')' or z[i] == '}' or z[i] == ']') {
                depth -= 1;
            }
        }
        i += sz;
    }
    if (i < z.len and z[i] == ')') {
        args[n_arg].z = z[i_start..i];
        // Remove leading and trailing whitespace from each argument.
        // If what remains is one of $1, $2, ... $9 then transfer the
        // corresponding argument from the outer context
        for (args[0 .. n_arg + 1]) |*arg| {
            while (arg.z.len > 0 and std.ascii.isWhitespace(arg.z[0])) {
                arg.z = arg.z[1..];
            }
            while (arg.z.len > 0 and std.ascii.isWhitespace(arg.z[arg.z.len - 1])) {
                arg.z = arg.z[0 .. arg.z.len - 1];
            }
            if (arg.z.len == 2 and arg.z[0] == '$' and arg.z[1] >= '1' and arg.z[1] <= '9') {
                if (outer) |out| {
                    arg.* = out[arg.z[1] - '1'];
                } else {
                    arg.z = "";
                }
            }
            if (arg.z.len != 0) {
                p.shaDigest.update(arg.z);
            }
        }
        return i + 1;
    }
    var err: PToken = .zero;
    err.z = z[0..1];
    pik_error(p, &err, "unterminated macro argument list");
    return 0;
}

// Split up the content of a PToken into multiple tokens and
// send each to the parser.
fn pik_tokenize(p: *Pik, input: *PToken, parser: *PikParser, params: ?[]PToken) void {
    var i: usize = 0;
    var sz: usize = 0;
    while (i < input.z.len and input.z[i] != 0 and p.nErr == 0) : (i += sz) {
        var token: PToken = .zero;
        token.z = input.z[i..];
        sz = pik_token_length(&token, true);
        if (token.eType == T_WHITESPACE) {
            // no-op
        } else if (sz > 50000) {
            token.z = token.z[0..1];
            pik_error(p, &token, "token is too long - max length 50000 bytes");
            break;
        } else if (token.eType == T_ERROR) {
            token.z = token.z[0..@min(sz, 0xffff)];
            pik_error(p, &token, "unrecognized token");
            break;
        } else if (sz + i > input.z.len) {
            token.z = token.z[0 .. input.z.len - i];
            pik_error(p, &token, "syntax error");
            break;
        } else if (token.eType == T_PARAMETER) {
            // Substitute a parameter into the input stream
            const idx: usize = token.eCode;
            if (params == null or params.?[idx].z.len == 0) continue;
            token.z = token.z[0..@min(sz, 0xffff)];
            if (p.nCtx >= p.aCtx.len) {
                pik_error(p, &token, "macros nested too deep");
            } else {
                p.aCtx[p.nCtx] = token;
                p.nCtx += 1;
                pik_tokenize(p, &params.?[idx], parser, null);
                p.nCtx -= 1;
            }
        } else if (tokenKind(&token) == .ID and blk: {
            token.z = token.z[0..@min(sz, 0xffff)];
            break :blk pik_find_macro(p, &token) != null;
        }) {
            const mac = pik_find_macro(p, &token).?;
            var args = [_]PToken{.zero} ** 9;
            const j = i + sz;
            if (mac.inUse != 0) {
                pik_error(p, &mac.macroName, "recursive macro definition");
                break;
            }
            token.z = token.z[0..@min(sz, 0xffff)];
            if (p.nCtx >= p.aCtx.len) {
                pik_error(p, &token, "macros nested too deep");
                break;
            }
            mac.inUse = 1;
            p.aCtx[p.nCtx] = token;
            p.nCtx += 1;
            sz += pik_parse_macro_args(p, input.z[j..], &args, params);
            pik_tokenize(p, &mac.macroBody, parser, args[0..]);
            p.nCtx -= 1;
            mac.inUse = 0;
        } else {
            token.z = token.z[0..@min(sz, 0xffff)];
            if (p.nToken > PIKCHR_TOKEN_LIMIT) {
                pik_error(p, &token, "script is too complex");
                break;
            }
            p.nToken += 1;
            // only hash EOL once + normalize
            if (tokenKind(&token) == .EOL) {
                if (p.bEOL == 0) {
                    p.bEOL = 1;
                    // treat every EOL as a newline
                    p.shaDigest.update("\n");
                }
            } else {
                p.bEOL = 0;
                // Codeblocks (aka macros) we hash if and when they get used,
                // XML class lists are hashed individually to discount whitespace
                const kind = tokenKind(&token);
                if (kind != .CODEBLOCK and kind != .XML_CLASSES) {
                    p.shaDigest.update(token.z);
                }
            }
            parser.parse(tokenKind(&token), token) catch {
                pik_error(p, &token, null);
                break;
            };
        }
    }
}

pub const RenderResult = struct {
    text: []u8,
    width: i32,
    height: i32,
    n_err: u32,

    pub fn deinit(result: RenderResult, allocator: Allocator) void {
        allocator.free(result.text);
    }

    pub fn ok(result: RenderResult) bool {
        return result.width >= 0;
    }
};

pub const RenderError = OOM;

// Parse the PIKCHR script contained in zText[].  Return a rendering.  Or
// if an error is encountered, return the error text.  The error message
// is HTML formatted.  So regardless of what happens, the return text
// is safe to be insertd into an HTML output stream.
//
// If pnWidth and pnHeight are not NULL, then this routine writes the
// width and height of the <SVG> object into the integers that they
// point to.  A value of -1 is written if an error is seen.
//
// zClass is the class name to be included in the <SVG> markup.
//
// The returned string is contained in memory obtained from malloc()
// and should be released by the caller.
pub fn render(
    allocator: Allocator,
    source: []const u8,
    class: []const u8,
    flags: u32,
) RenderError!RenderResult {
    var pik = Pik.init(allocator, source, class, flags);
    defer pik.deinit();
    if ((flags & PIKCHR_DARK_MODE) != 0) {
        pik.shaDigest.update("darkmode");
    }
    if ((flags & PIKCHR_EXTRA_UNIQUE_ID) != 0) {
        pik.shaDigest.update(std.mem.asBytes(&pikchr_call_count));
    }
    pikchr_call_count += 1;

    var parser: PikParser = undefined;
    parser.init(allocator, &pik) catch return error.OutOfMemory;
    defer parser.deinit();
    pik_tokenize(&pik, &pik.sIn, &parser, null);
    // normalize end of diagram to hash as EOL
    if (pik.bEOL == 0) {
        pik.shaDigest.update("\n");
    }
    pik_set_id(&pik);
    if (pik.nErr == 0) {
        parser.finalize() catch {
            pik_error(&pik, null, null);
        };
    }
    if (pik.zOut.written().len == 0 and pik.nErr == 0) {
        pik_append(&pik, "<!-- empty pikchr diagram -->\n");
    }
    const text = allocator.dupe(u8, pik.zOut.written()) catch return error.OutOfMemory;
    return .{
        .text = text,
        .width = if (pik.nErr != 0) -1 else pik.wSVG,
        .height = if (pik.nErr != 0) -1 else pik.hSVG,
        .n_err = pik.nErr,
    };
}

test "Pik parser module carries translated state" {
    var pik = Pik.init(std.testing.allocator, "box", "pikchr", 0);
    defer pik.deinit();
    try std.testing.expectEqual(@as(u8, DIR_RIGHT), pik.eDir);
    try std.testing.expectEqualStrings("box", pik.sIn.z);
    try std.testing.expectEqualStrings("pikchr", pik.zClass);
    pik_append(&pik, "svg");
    try std.testing.expectEqualStrings("svg", pik.zOut.written());
}

test "Pik color tag generator advances with carry" {
    var one = [_]u8{ 'z', 0, 0, 0 };
    pik_next_color_tag(&one);
    try std.testing.expectEqualSlices(u8, &.{ 'a', 'a', 0, 0 }, &one);

    var two = [_]u8{ 'z', 'z', 0, 0 };
    pik_next_color_tag(&two);
    try std.testing.expectEqualSlices(u8, &.{ 'a', 'a', 'a', 0 }, &two);

    var three = [_]u8{ 'a', 'a', 'a', 0 };
    pik_next_color_tag(&three);
    try std.testing.expectEqualSlices(u8, &.{ 'a', 'a', 'b', 0 }, &three);

    var four = [_]u8{ 'z', 'z', 'z', 0 };
    pik_next_color_tag(&four);
    try std.testing.expectEqualSlices(u8, &.{ 'a', 'a', 'a', 'a' }, &four);
}

test "Pik after adding attributes records color tags" {
    var pik = Pik.init(std.testing.allocator, "box", "pikchr", 0);
    defer pik.deinit();
    var tok = classToken("box");
    const obj = pik_elem_new(&pik, &tok, null, null).?;
    obj.color = 0x112233;
    obj.textcolor = 0x445566;
    obj.fill = 0x778899;
    obj.nTxt = 1;
    pik_after_adding_attributes(&pik, obj);
    _ = pik_elist_append(&pik, null, obj);

    try std.testing.expectEqual(@as(ColorMap.Size, 1), pik.hStroke.count());
    try std.testing.expectEqual(@as(ColorMap.Size, 0), pik.hBgStroke.count());
    try std.testing.expectEqual(@as(ColorMap.Size, 1), pik.hFgFill.count());
    try std.testing.expectEqual(@as(ColorMap.Size, 1), pik.hFill.count());

    const stroke = pik.hStroke.get(obj.color).?;
    const text = pik.hFgFill.get(obj.textcolor).?;
    const fill = pik.hFill.get(obj.fill).?;
    try std.testing.expectEqualSlices(u8, &.{ 'a', 0, 0, 0 }, &stroke);
    try std.testing.expectEqualSlices(u8, &.{ 'b', 0, 0, 0 }, &text);
    try std.testing.expectEqualSlices(u8, &.{ 'c', 0, 0, 0 }, &fill);
    try std.testing.expectEqualSlices(u8, &.{ 'd', 0, 0, 0 }, &pik.varGen);
}

test "Pik after adding attributes records dot fill as foreground fill" {
    var pik = Pik.init(std.testing.allocator, "dot", "pikchr", 0);
    defer pik.deinit();
    var tok = classToken("dot");
    const obj = pik_elem_new(&pik, &tok, null, null).?;
    obj.color = 0x112233;
    obj.fill = obj.color;
    pik_after_adding_attributes(&pik, obj);
    _ = pik_elist_append(&pik, null, obj);

    try std.testing.expectEqual(@as(ColorMap.Size, 1), pik.hStroke.count());
    try std.testing.expectEqual(@as(ColorMap.Size, 0), pik.hBgStroke.count());
    try std.testing.expectEqual(@as(ColorMap.Size, 0), pik.hFill.count());
    try std.testing.expectEqual(@as(ColorMap.Size, 1), pik.hFgFill.count());

    const stroke = pik.hStroke.get(obj.color).?;
    const fill = pik.hFgFill.get(obj.fill).?;
    try std.testing.expectEqualSlices(u8, &.{ 'a', 0, 0, 0 }, &stroke);
    try std.testing.expectEqualSlices(u8, &.{ 'b', 0, 0, 0 }, &fill);
    try std.testing.expectEqualSlices(u8, &.{ 'c', 0, 0, 0 }, &pik.varGen);
}

test "Pik after adding attributes records matching box color as background stroke" {
    var pik = Pik.init(std.testing.allocator, "box", "pikchr", 0);
    defer pik.deinit();
    var tok = classToken("box");
    const obj = pik_elem_new(&pik, &tok, null, null).?;
    obj.color = 0x112233;
    obj.fill = obj.color;
