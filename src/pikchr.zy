    try std.testing.expectEqualSlices(u8, &.{ 'b', 0, 0, 0 }, &fill);
    try std.testing.expectEqualSlices(u8, &.{ 'c', 0, 0, 0 }, &pik.varGen);
}

test "Pik color class emission reports missing generated tags as internal error" {
    var pik = Pik.init(std.testing.allocator, "box", "pikchr", 0);
    defer pik.deinit();
    var tok = classToken("box");
    const obj = pik_elem_new(&pik, &tok, null, null).?;
    obj.sw = 1.0;
    obj.color = 0x112233;
    obj.fill = -1.0;
    _ = pik_elist_append(&pik, null, obj);

    boxRender(&pik, obj);

    try std.testing.expectEqual(@as(u32, 1), pik.nErr);
    try std.testing.expect(std.mem.indexOf(u8, pik.zOut.written(), "internal error: missing generated color class") != null);
}

test "Pik object allocation initializes class defaults" {
    var pik = Pik.init(std.testing.allocator, "box", "pikchr", 0);
    defer pik.deinit();
    var tok = classToken("box");
    const obj = pik_elem_new(&pik, &tok, null, null).?;
    try std.testing.expectEqualStrings("box", obj.type.?.zName);
    try std.testing.expectEqual(@as(PNum, 0.75), obj.w);
    try std.testing.expectEqual(@as(PNum, 0.5), obj.h);
    _ = pik_elist_append(&pik, null, obj);
}

test "Pik render consumes object list into allocating writer" {
    var pik = Pik.init(std.testing.allocator, "box", "pikchr", 0);
    defer pik.deinit();
    var tok = classToken("box");
    const obj = pik_elem_new(&pik, &tok, null, null).?;
    const list = pik_elist_append(&pik, null, obj);
    pik_render(&pik, list);
    try std.testing.expect(std.mem.startsWith(u8, pik.zOut.written(), "<svg "));
    try std.testing.expect(std.mem.indexOf(u8, pik.zOut.written(), "<path ") != null);
    try std.testing.expect(std.mem.endsWith(u8, pik.zOut.written(), "</svg>\n"));
    try std.testing.expect(pik.list == null);
}

test "Pik line direction builds path before render" {
    var pik = Pik.init(std.testing.allocator, "line", "pikchr", 0);
    defer pik.deinit();
    var tok = classToken("line");
    const obj = pik_elem_new(&pik, &tok, null, null).?;
    var rel: PRel = .start;
    pik_add_direction(&pik, null, &rel);
    pik_after_adding_attributes(&pik, obj);
    try std.testing.expectEqual(@as(i32, 2), obj.nPath);
    try std.testing.expect(obj.ptExit.x > obj.ptEnter.x);
    _ = pik_elist_append(&pik, null, obj);
}

test "Pik set at records edge placement" {
    var pik = Pik.init(std.testing.allocator, "box", "pikchr", 0);
    defer pik.deinit();
    var tok = classToken("box");
    const obj = pik_elem_new(&pik, &tok, null, null).?;
    var edge: PToken = .zero;
    edge.eEdge = CP_E;
    var err = classToken("at");
    var at = PPoint{ .x = 2.0, .y = 3.0 };
    pik_set_at(&pik, &edge, &at, &err);
    try std.testing.expect((obj.mProp & A_AT) != 0);
    try std.testing.expectEqual(@as(u8, CP_E), obj.eWith);
    try std.testing.expectEqual(@as(PNum, 2.0), obj.with.x);
    try std.testing.expectEqual(@as(PNum, 3.0), obj.with.y);
    pik_after_adding_attributes(&pik, obj);
    const east = pik_place_of_elem(&pik, obj, &edge);
    try std.testing.expectEqual(@as(PNum, 2.0), east.x);
    try std.testing.expectEqual(@as(PNum, 3.0), east.y);
    _ = pik_elist_append(&pik, null, obj);
}

test "Pik XML classes and macros preserve parser state" {
    var pik = Pik.init(std.testing.allocator, "box", "pikchr", 0);
    defer pik.deinit();
    var tok = classToken("box");
    const obj = pik_elem_new(&pik, &tok, null, null).?;
    var classes: PToken = .zero;
    classes.z = "'one_class two'";
    pik_set_xml_classes(&pik, &classes);
    try std.testing.expect((obj.mProp & A_CLASS) != 0);
    try std.testing.expectEqualStrings("two", obj.pXmlClass.?.zClass);
    try std.testing.expectEqualStrings("one-class", obj.pXmlClass.?.pNext.?.zClass);

    var id = classToken("M");
    var body: PToken = .zero;
    body.z = "{box}";
    pik_add_macro(&pik, &id, &body);
    try std.testing.expectEqualStrings("box", pik.pMacros.?.macroBody.z);
    _ = pik_elist_append(&pik, null, obj);
}

test "Pik lookup helpers find objects and properties" {
    var pik = Pik.init(std.testing.allocator, "box", "pikchr", 0);
    defer pik.deinit();
    var box = classToken("box");
    const obj = pik_elem_new(&pik, &box, null, null).?;
    var name = classToken("alpha");
    pik_elem_setname(&pik, obj, &name);
    _ = pik_elist_append(&pik, null, obj);

    var nth = classToken("box");
    nth.eCode = 1;
    try std.testing.expectEqual(obj, pik_find_nth(&pik, null, &nth).?);
    try std.testing.expectEqual(obj, pik_find_byname(&pik, null, &name).?);

    var width: PToken = .zero;
    width.eType = @intFromEnum(TokenKind.WIDTH);
    var height: PToken = .zero;
    height.eType = @intFromEnum(TokenKind.HEIGHT);
    try std.testing.expectEqual(obj.w, pik_property_of(obj, &width));
    try std.testing.expectEqual(obj.h, pik_property_of(obj, &height));
}

test "Pik math and text-position helpers follow token codes" {
    var pik = Pik.init(std.testing.allocator, "", "pikchr", 0);
    defer pik.deinit();
    var sqrt_tok: PToken = .zero;
    sqrt_tok.eCode = FN_SQRT;
    try std.testing.expectEqual(@as(PNum, 3.0), pik_func(&pik, &sqrt_tok, 9.0, 0.0));

    var left: PToken = .zero;
    left.eType = @intFromEnum(TokenKind.LJUST);
    var aligned: PToken = .zero;
    aligned.eType = @intFromEnum(TokenKind.ALIGNED);
    const pos = pik_text_position(@intCast(pik_text_position(0, &left)), &aligned);
    try std.testing.expect((pos & TP_LJUST) != 0);
    try std.testing.expect((pos & TP_ALIGN) != 0);
}

test "Pik tokenizer classifies core tokens" {
    const source = "box \"hi\" -> 2nd";
    var rest: []const u8 = source;
    var tok: PToken = .zero;
    tok.z = rest;
    var n = pik_token_length(&tok, true);
    try std.testing.expectEqual(@intFromEnum(TokenKind.CLASSNAME), tok.eType);
    try std.testing.expectEqual(@as(usize, 3), n);

    rest = rest[n + 1 ..];
    tok = .zero;
    tok.z = rest;
    n = pik_token_length(&tok, true);
    try std.testing.expectEqual(@intFromEnum(TokenKind.STRING), tok.eType);
    try std.testing.expectEqual(@as(usize, 4), n);

    rest = rest[n + 1 ..];
    tok = .zero;
    tok.z = rest;
    n = pik_token_length(&tok, true);
    try std.testing.expectEqual(@intFromEnum(TokenKind.RARROW), tok.eType);
    try std.testing.expectEqual(@as(usize, 2), n);

    rest = rest[n + 1 ..];
    tok = .zero;
    tok.z = rest;
    n = pik_token_length(&tok, true);
    try std.testing.expectEqual(@intFromEnum(TokenKind.NTH), tok.eType);
    try std.testing.expectEqual(@as(usize, 3), n);
}

test "Pik generated render entrypoint parses simple source" {
    const out = try render(std.testing.allocator, "box\n", "pikchr", 0);
    defer out.deinit(std.testing.allocator);
    try std.testing.expect(out.ok());
    try std.testing.expect(std.mem.startsWith(u8, out.text, "<svg "));
}

test "Pik generated render emits color class CSS" {
    const out = try render(std.testing.allocator, "box \"hi\" fill 0x778899 color 0x112233 textcolor 0x445566\n", "pikchr", 0);
    defer out.deinit(std.testing.allocator);
    try std.testing.expect(out.ok());
    try std.testing.expect(std.mem.indexOf(u8, out.text, "._sa {stroke:rgb(17,34,51)}") != null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "._fb {fill:rgb(68,85,102)}") != null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "._fc {fill:rgb(119,136,153)}") != null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "class=\"box _sa _fc\"") != null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "class=\"box _fb _D") != null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "._G") == null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "stroke=\"rgb(17,34,51)\"") == null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "fill=\"rgb(119,136,153)\"") == null);
}

test "Pik generated color class CSS uses existing dark color conversion" {
    const out = try render(std.testing.allocator, "box fill 0x778899 color 0x112233\n", "pikchr", PIKCHR_DARK_MODE);
    defer out.deinit(std.testing.allocator);
    try std.testing.expect(out.ok());
    try std.testing.expect(std.mem.indexOf(u8, out.text, "._sa {stroke:rgb(204,221,238)}") != null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "._fb {fill:rgb(95,111,127)}") != null);
}

test "Pik generated text color classes use foreground dark conversion" {
    const out = try render(std.testing.allocator, "box \"hi\" textcolor 0x445566\n", "pikchr", PIKCHR_DARK_MODE);
    defer out.deinit(std.testing.allocator);
    try std.testing.expect(out.ok());
    try std.testing.expect(std.mem.indexOf(u8, out.text, "._fb {fill:rgb(153,170,187)}") != null);
    try std.testing.expect(std.mem.indexOf(u8, out.text, "._G") == null);
}

test "Pik generated debug label color is registered before CSS" {
    const out = try render(std.testing.allocator, "debug_label_color = Red\nA: box\n", "pikchr", 0);
    defer out.deinit(std.testing.allocator);
    try std.testing.expect(out.ok());
