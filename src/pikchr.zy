    _ = pik_elist_append(&pik, null, obj);

    try std.testing.expectEqual(@as(ColorMap.Size, 0), pik.hStroke.count());
    try std.testing.expectEqual(@as(ColorMap.Size, 1), pik.hBgStroke.count());
    try std.testing.expectEqual(@as(ColorMap.Size, 1), pik.hFill.count());
    try std.testing.expectEqual(@as(ColorMap.Size, 0), pik.hFgFill.count());

    const stroke = pik.hBgStroke.get(obj.color).?;
    const fill = pik.hFill.get(obj.fill).?;
