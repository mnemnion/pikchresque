%include {
//! Pikchr grammar for the Zig port.
//!
//! This is derived from the modified `pikchr/pikchr.y` in this repository.
//! The reduce actions intentionally stay inline for now; do not split them
//! into Zitron `%impl @name(...)` blocks during this pass.


pub const pik_pedantic = true; // maximum compatibility
pub const pik_no_style = true;

pub const PNum = f64; // Numeric value

// Compass points
pub const CP_N = 1;
pub const CP_NE = 2;
pub const CP_E = 3;
pub const CP_SE = 4;
pub const CP_S = 5;
pub const CP_SW = 6;
pub const CP_W = 7;
pub const CP_NW = 8;
pub const CP_C = 9; // .center or .c
pub const CP_END = 10; // .end
pub const CP_START = 11; // .start

// Heading angles corresponding to compass points
pub const pik_hdg_angle = [_]PNum{
    0.0, // none
    0.0, // N
    45.0, // NE
    90.0, // E
    135.0, // SE
    180.0, // S
    225.0, // SW
    270.0, // W
    315.0, // NW
    0.0, // C
};

// Built-in functions
pub const FN_ABS: u16 = 0;
pub const FN_COS: u16 = 1;
pub const FN_INT: u16 = 2;
pub const FN_MAX: u16 = 3;
pub const FN_MIN: u16 = 4;
pub const FN_SIN: u16 = 5;
pub const FN_SQRT: u16 = 6;

// Text position and style flags.  Stored in PToken.eCode so limited
// to 15 bits.
pub const TP_LJUST: u16 = 0x0001; // left justify......
pub const TP_RJUST: u16 = 0x0002; //            ...Right justify
pub const TP_JMASK: u16 = 0x0003; // Mask for justification bits
pub const TP_ABOVE2: u16 = 0x0004; // Position text way above PObj.ptAt
pub const TP_ABOVE: u16 = 0x0008; // Position text above PObj.ptAt
pub const TP_CENTER: u16 = 0x0010; // On the line
pub const TP_BELOW: u16 = 0x0020; // Position text below PObj.ptAt
pub const TP_BELOW2: u16 = 0x0040; // Position text way below PObj.ptAt
pub const TP_VMASK: u16 = 0x007c; // Mask for text positioning flags
pub const TP_BIG: u16 = 0x0100; // Larger font
pub const TP_SMALL: u16 = 0x0200; // Smaller font
pub const TP_XTRA: u16 = 0x0400; // Amplify TP_BIG or TP_SMALL
pub const TP_SZMASK: u16 = 0x0700; // Font size mask
pub const TP_ITALIC: u16 = 0x1000; // Italic font
pub const TP_BOLD: u16 = 0x2000; // Bold font
pub const TP_MONO: u16 = 0x4000; // Monospace font family
pub const TP_FMASK: u16 = 0x7000; // Mask for font style
pub const TP_ALIGN: u16 = 0x8000; // Rotate to align with the line

// Style attribute flags.  These track when a presentation attribute
// such as dominant-baseline is needed.
pub const ATTR_BASELINE = 0x01; // Include dominant-baseline="central"
pub const ATTR_T_START = 0x02; // text-anchor="start"
pub const ATTR_T_MIDDLE = 0x04; // text-anchor="middle"
pub const ATTR_T_END = 0x08; // text-anchor="end"
pub const ATTR_F_ITALIC = 0x10; // font-style="italic"
pub const ATTR_F_BOLD = 0x20; // font-weight="bold"
pub const ATTR_F_MONO = 0x40; // font-family="monospace"
pub const ATTR_FILL_NO = 0x80; // fill="transparent"

// An object to hold a position in 2-D space
pub const PPoint = struct {
    x: PNum, // X coordinate
    y: PNum, // Y coordinate

    pub const zero: PPoint = .{ .x = 0.0, .y = 0.0 };
};
pub const cZeroPoint: PPoint = .zero;

// A bounding box
pub const PBox = struct {
    sw: PPoint, // Lower-left corner
    ne: PPoint, // Top-right corner

    pub const zero: PBox = .{ .sw = .zero, .ne = .zero };
};

// An Absolute or a relative distance.  The absolute distance
// is stored in rAbs and the relative distance is stored in rRel.
// Usually, one or the other will be 0.0.  When using a PRel to
// update an existing value, the computation is usually something
// like this:
//
//          value = PRel.rAbs + value*PRel.rRel
//
pub const PRel = struct {
    rAbs: PNum, // Absolute value
    rRel: PNum, // Value relative to current value

    pub const zero: PRel = .{ .rAbs = 0.0, .rRel = 0.0 };
    pub const start: PRel = .{ .rAbs = 0.0, .rRel = 1.0 };
};

// A node in a linked list of SVG classes.
//
pub const PXmlClass = struct {
    zClass: []u8, // Class identifier
    pNext: ?*PXmlClass, // Next class in an element's list

    pub const zero: PXmlClass = .{ .zClass = &.{}, .pNext = null };
};

// A variable created by the ID = EXPR construct of the PIKCHR script
//
// PIKCHR (and PIC) scripts do not use many variables, so it is reasonable
// to store them all on a linked list.
pub const PVar = struct {
    zName: []u8, // Name of the variable
    val: PNum, // Value of the variable
    pNext: ?*PVar, // Next variable in a list of them all

    pub const zero: PVar = .{ .zName = &.{}, .val = 0.0, .pNext = null };
};

const ColorTag = [4]u8;

const ColorContext = struct {
    pub fn hash(_: @This(), value: PNum) u64 {
        return std.hash.int(@as(u64, @bitCast(value)));
    }

    pub fn eql(_: @This(), a: PNum, b: PNum) bool {
        return a == b;
    }
};

const ColorMap = std.HashMapUnmanaged(PNum, ColorTag, ColorContext, std.hash_map.default_max_load_percentage);

// A single token in the parser input stream
pub const PToken = struct {
    z: []const u8, // Token text
    eCode: u16, // Auxiliary code
    eType: u8, // The numeric parser code
    eEdge: u8, // Corner value for corner keywords

    pub const zero: PToken = .{ .z = "", .eCode = 0, .eType = 0, .eEdge = 0 };
};

// Return negative, zero, or positive if pToken is less than, equal to
// or greater than the zero-terminated string z[]
fn pik_token_eq(pToken: *PToken, z: []const u8) i32 {
    const n = @min(pToken.z.len, z.len);
    const c = std.mem.order(u8, pToken.z[0..n], z[0..n]);
    if (c != .eq) return if (c == .lt) -1 else 1;
    if (pToken.z.len < z.len) return -1;
    if (pToken.z.len > z.len) return 1;
    return 0;
}

// Extra token types not generated by LEMON but needed by the
// tokenizer
pub const T_PARAMETER = 253; // $1, $2, ..., $9
pub const T_WHITESPACE = 254; // Whitespace or comments
pub const T_ERROR = 255; // Any text that is not a valid token

// Directions of movement
pub const DIR_RIGHT = 0;
pub const DIR_DOWN = 1;
pub const DIR_LEFT = 2;
pub const DIR_UP = 3;

fn ValidDir(x: anytype) bool {
    return x >= 0 and x <= 3;
}
fn IsUpDown(x: anytype) bool {
    return (x & 1) == 1;
}
fn IsLeftRight(x: anytype) bool {
    return (x & 1) == 0;
}

// Bitmask for the various attributes for PObj.  These bits are
// collected in PObj.mProp and PObj.mCalc to check for constraint
// errors.
pub const A_WIDTH = 0x0001;
pub const A_HEIGHT = 0x0002;
pub const A_RADIUS = 0x0004;
pub const A_THICKNESS = 0x0008;
pub const A_DASHED = 0x0010; // Includes "dotted"
pub const A_FILL = 0x0020;
pub const A_COLOR = 0x0040;
pub const A_ARROW = 0x0080;
pub const A_FROM = 0x0100;
pub const A_CW = 0x0200;
pub const A_AT = 0x0400;
pub const A_TO = 0x0800; // one or more movement attributes
pub const A_FIT = 0x1000;
pub const A_TEXTCOLOR = 0x2000;
pub const A_CLASS = 0x4000;

// Color properties for seenColor masking
pub const C_COLOR = 0x01;
pub const C_FILL = 0x02;
pub const C_TEXT = 0x04;

// A single graphics object
pub const PObj = struct {
    type: ?*const PClass,    // Object type or class
    errTok: PToken,          // Reference token for error messages
    ptAt: PPoint,            // Reference point for the object
    ptEnter: PPoint,         // Entry point
    ptExit: PPoint,          // Exit point
    pSublist: ?*PList,       // Substructure for [...] objects
    pXmlClass: ?*PXmlClass,  // Optional list of assigned XML classes
    zName: []const u8,       // Name assigned to this statement
    w: PNum,                 // "width" property
    h: PNum,                 // "height" property
    rad: PNum,               // "radius" property
    sw: PNum,                // "thickness" property. (Mnemonic: "stroke width")
    dotted: PNum,            // "dotted" property.   <=0.0 for off
    dashed: PNum,            // "dashed" property.   <=0.0 for off
    fill: PNum,              // "fill" property.  Negative for off
    color: PNum,             // "color" property
    textcolor: PNum,         // "textcolor" property
    with: PPoint,            // Position constraint from WITH clause
    eWith: u8,               // Type of heading point on WITH clause
    cw: u8,                  // True for clockwise arc
    larrow: u8,              // Arrow at beginning (<- or <->)
    rarrow: u8,              // Arrow at end  (-> or <->)
    bClose: u8,              // True if "close" is seen
    bChop: u8,               // True if "chop" is seen
    bAltAutoFit: u8,         // Always send both h and w into xFit()
    nTxt: usize,             // Number of text values
    mProp: u32,              // Masks of properties set so far
    mCalc: u32,              // Values computed from other constraints
    aTxt: [5]PToken,         // Text with .eCode holding TP flags
    iLayer: i32,             // Rendering order
    inDir: i32,              // Entry direction
    outDir: i32,             // Exit direction
    nPath: i32,              // Number of path points
    aPath: []PPoint,         // Array of path points
    pFrom: ?*PObj,           // End-point objects of a path
    pTo: ?*PObj,             // End-point objects of a path
    bbox: PBox,              // Bounding box

    pub const start: PObj = .{
        .type = null,
        .errTok = .zero,
        .ptAt = .zero,
        .ptEnter = .zero,
        .ptExit = .zero,
        .pSublist = null,
        .pXmlClass = null,
        .zName = "",
        .w = 0.0,
        .h = 0.0,
        .rad = 0.0,
        .sw = 0.0,
        .dotted = 0.0,
        .dashed = 0.0,
        .fill = 0.0,
        .color = 0.0,
        .textcolor = 0.0,
        .with = .zero,
        .eWith = 0,
        .cw = 0,
        .larrow = 0,
        .rarrow = 0,
        .bClose = 0,
        .bChop = 0,
        .bAltAutoFit = 0,
        .nTxt = 0,
        .mProp = 0,
        .mCalc = 0,
        .aTxt = [_]PToken{.zero} ** 5,
        .iLayer = 0,
        .inDir = 0,
        .outDir = 0,
        .nPath = 0,
        .aPath = &.{},
        .pFrom = null,
        .pTo = null,
        .bbox = .zero,
    };
};

// A list of graphics objects
pub const PList = struct {
    n: usize, // Number of statements in the list
    nAlloc: usize, // Allocated slots in a[]
    a: []*PObj, // Pointers to individual objects

    pub const zero: PList = .{ .n = 0, .nAlloc = 0, .a = &.{} };
};

// A macro definition
pub const PMacro = struct {
    pNext: ?*PMacro, // Next in the list
    macroName: PToken, // Name of the macro
    macroBody: PToken, // Body of the macro
    inUse: i32, // Do not allow recursion

    pub const zero: PMacro = .{ .pNext = null, .macroName = .zero, .macroBody = .zero, .inUse = 0 };
};

// zig fmt: off
const sha1_options = std.crypto.hash.Sha1.Options{};

// Each call to the pikchr() subroutine uses an instance of the following
// object to pass around context to all of its subroutines.
pub const Pik = struct {
    allocator: Allocator,             // Allocator for all per-render memory
    nErr: u32,                        // Number of errors seen
    nToken: u32,                      // Number of tokens parsed
    sIn: PToken,                      // Input Pikchr-language text
    zOut: std.Io.Writer.Allocating,   // Result accumulates here
    shaDigest: std.crypto.hash.Sha1,  // The hashing context for tokens
    eDir: u8,                         // Current direction
    mFlags: u32,                      // Flags passed to pikchr()
    cur: ?*PObj,                      // Object under construction
    lastRef: ?*PObj,                  // Last object references by name
    list: ?*PList,                    // Object list under construction
    pMacros: ?*PMacro,                // List of all defined macros
    pVar: ?*PVar,                     // Application-defined variables
    bbox: PBox,                       // Bounding box around all statements
    // Cache of layout values.  <=0.0 for unknown...
    rScale: PNum,                     // Multiply to convert inches to pixels
    fontScale: PNum,                  // Scale fonts by this percent
    charWidth: PNum,                  // Character width
    charHeight: PNum,                 // Character height
    wArrow: PNum,                     // Width of arrowhead at the fat end
    hArrow: PNum,                     // Ht of arrowhead - dist from tip to fat end
    bLayoutVars: u8,                  // True if cache is valid
    thenFlag: u8,                     // True if "then" seen
    bLabel: u8,                       // True if zTitle should be rendered as a label
    samePath: u8,                     // aTPath copied by "same"
    bEOL: u8,                         // Flag for if we're in a run of T_EOL (hashing)
    mAttr: u8,                        // Flags for when to include certain styles
    zClass: []const u8,               // Class name for the <svg>
    zID: []const u8,                  // Suffix for id fields
    zTitle: []const u8,               // Text of title or label
    zDesc: []const u8,                // Text of extended description
    wSVG: i32,                        // Width of the <svg>
    hSVG: i32,                        // Height of the <svg>
    fgcolor: i32,                     // foreground color value, or -1 for none
    bgcolor: i32,                     // background color value, or -1 for none
    seenColor: [150]u8,               // which built-in colors have been seen
    hFill: ColorMap,                  // background fill color to generated class tag
    hFgFill: ColorMap,                // foreground fill color to generated class tag
    hStroke: ColorMap,                // stroke color to generated class tag
    hBgStroke: ColorMap,              // background stroke color to generated class tag
    varGen: ColorTag,                 // Next generated color class tag
    // Paths for lines are constructed here first, then transferred into
    // the PObj object at the end:
    nTPath: i32,                      // Number of entries on aTPath[]
    mTPath: i32,                      // For last entry, 1: x set,  2: y set
    aTPath: [1000]PPoint,             // Path under construction
    // Error contexts
    nCtx: u32,                        // Number of error contexts
    aCtx: [10]PToken,                 // Nested error contexts
// zig fmt: on

    pub const start: Pik = .{
        .allocator = undefined,
        .nErr = 0,
        .nToken = 0,
        .sIn = .zero,
        .zOut = undefined,
        .shaDigest = std.crypto.hash.Sha1.init(sha1_options),
        .eDir = DIR_RIGHT,
        .mFlags = 0,
        .cur = null,
        .lastRef = null,
        .list = null,
        .pMacros = null,
        .pVar = null,
        .bbox = .zero,
        .rScale = 0.0,
        .fontScale = 0.0,
        .charWidth = 0.0,
        .charHeight = 0.0,
        .wArrow = 0.0,
        .hArrow = 0.0,
        .bLayoutVars = 0,
        .thenFlag = 0,
        .bLabel = 0,
        .samePath = 0,
        .bEOL = 0,
        .mAttr = 0,
        .zClass = "",
        .zID = "",
        .zTitle = "",
        .zDesc = "",
        .wSVG = 0,
        .hSVG = 0,
        .fgcolor = -1,
        .bgcolor = -1,
        .seenColor = [_]u8{0} ** 150,
        .hFill = .empty,
        .hFgFill = .empty,
        .hStroke = .empty,
        .hBgStroke = .empty,
        .varGen = .{ 'a', 0, 0, 0 },
        .nTPath = 0,
        .mTPath = 0,
        .aTPath = [_]PPoint{.zero} ** 1000,
        .nCtx = 0,
        .aCtx = [_]PToken{.zero} ** 10,
    };

    pub fn init(
        allocator: Allocator,
        source: []const u8,
        class: []const u8,
        flags: u32,
    ) Pik {
        var pik: Pik = .start;
        pik.allocator = allocator;
        pik.sIn.z = source;
        pik.zOut = .init(allocator);
        pik.zClass = class;
        pik.mFlags = flags;
        return pik;
    }

    pub fn deinit(p: *Pik) void {
        p.zOut.deinit();
        p.hFill.deinit(p.allocator);
        p.hFgFill.deinit(p.allocator);
        p.hStroke.deinit(p.allocator);
        p.hBgStroke.deinit(p.allocator);
        if (p.zID.len != 0) p.allocator.free(p.zID);
        if (p.zTitle.len != 0) p.allocator.free(p.zTitle);
        if (p.zDesc.len != 0) p.allocator.free(p.zDesc);
        var v = p.pVar;
        while (v) |vv| {
            const next = vv.pNext;
            p.allocator.free(vv.zName);
            p.allocator.destroy(vv);
            v = next;
        }
        var m = p.pMacros;
        while (m) |mm| {
            const next = mm.pNext;
            p.allocator.destroy(mm);
            m = next;
        }
        pik_elist_free(p, p.list);
    }
};

// Include PIKCHR_PLAINTEXT_ERRORS among the bits of mFlags on the 3rd
// argument to pikchr() in order to cause error message text to come out
// as text/plain instead of as text/html
pub const PIKCHR_PLAINTEXT_ERRORS = 0x0001;

// Include PIKCHR_DARK_MODE among the mFlag bits to invert colors.
pub const PIKCHR_DARK_MODE = 0x0002;

// Include PIKCHR_EXTRA_UNIQUE_ID among the mFlag bits to add a value
// to each hash of a call to `char *pikchr`.  This value is taken from
// a counter, meaning the id is based both on the tokens of the Pikchr
// script, and the order in which the diagram is produced.  This could
// be useful in settings like forums, where more than one copy of a
// diagram may appear.
pub const PIKCHR_EXTRA_UNIQUE_ID = 0x0004;

// The behavior of an object class is defined by an instance of
// this structure. This is the "virtual method" table.
pub const PClass = struct {
    zName: []const u8, // Name of class
    isLine: u8, // True if a line class
    eJust: u8, // Use box-style text justification
    xInit: ?*const fn (*Pik, *PObj) void, // Initializer
    xNumProp: ?*const fn (*Pik, *PObj, *PToken) void, // Value change notification
    xCheck: ?*const fn (*Pik, *PObj) void, // Checks to do after parsing
    xChop: ?*const fn (*Pik, *PObj, *PPoint) PPoint, // Chopper
    xOffset: ?*const fn (*Pik, *PObj, i32) PPoint, // Offset from .c to edge point
    xFit: ?*const fn (*Pik, *PObj, PNum, PNum) void, // Size to fit text
    xRender: ?*const fn (*Pik, *PObj) void, // Render
};

// Append text (that will go inside of a <pre>...</pre>) that
// shows the context of an error token.
fn pik_error_context(p: *Pik, token: *const PToken, n_context: i32) void {
    var i_err_pt: isize = 0; // Index of first byte of error from start of input
    var i_err_col: usize = 0; // Column of the error token on its line
    var i_start: usize = 0; // Start position of the error context
    var i_end: usize = 0; // End position of the error context
    var i_lineno: i32 = 1; // Line number of the error
    var i_first_lineno: i32 = 1; // Line number of start of error context
    var i_bump: usize = 0; // Bump the location of the error cursor
    var z_lineno: [24]u8 = undefined; // Buffer in which to generate line numbers

    if (p.sIn.z.len == 0) return;
    const in_start = @intFromPtr(p.sIn.z.ptr);
    const in_end = in_start + p.sIn.z.len;
    const tok_start = @intFromPtr(token.z.ptr);
    if (tok_start < in_start) {
        i_err_pt = 0;
    } else if (tok_start >= in_end) {
        i_err_pt = @intCast(p.sIn.z.len - 1);
        i_bump = 1;
    } else {
        i_err_pt = @intCast(tok_start - in_start);
        while (i_err_pt > 0 and (p.sIn.z[@intCast(i_err_pt)] == '\n' or p.sIn.z[@intCast(i_err_pt)] == '\r')) {
            i_err_pt -= 1;
            i_bump = 1;
        }
    }
    var i: usize = 0;
    while (i < @as(usize, @intCast(i_err_pt))) : (i += 1) {
        if (p.sIn.z[i] == '\n') i_lineno += 1;
    }
    while (i_first_lineno + n_context < i_lineno) {
        while (i_start < p.sIn.z.len and p.sIn.z[i_start] != '\n') i_start += 1;
        if (i_start < p.sIn.z.len) i_start += 1;
        i_first_lineno += 1;
    }
    i_end = @intCast(i_err_pt);
    while (i_end < p.sIn.z.len and p.sIn.z[i_end] != '\n') i_end += 1;
    if (i_end < i_start) i_start = i_end;
    while (i_first_lineno <= i_lineno) : (i_first_lineno += 1) {
        const lineno = std.fmt.bufPrint(&z_lineno, "{d}", .{i_first_lineno}) catch "";
        pik_append(p, "/* ");
        i = lineno.len;
        while (i < 4) : (i += 1) pik_append(p, " ");
        pik_append(p, lineno);
        pik_append(p, " */  ");
        i = i_start;
        while (i < p.sIn.z.len and p.sIn.z[i] != '\n') i += 1;
        pik_append_errtxt(p, p.sIn.z[i_start..i]);
        i_start = if (i < p.sIn.z.len) i + 1 else i;
        pik_append(p, "\n");
    }
    i = @intCast(i_err_pt);
    while (i > 0 and p.sIn.z[i] != '\n') : (i -= 1) {
        i_err_col += 1;
    }
    i = 0;
    while (i < i_err_col + 11 + i_bump) : (i += 1) pik_append(p, " ");
    i = 0;
    while (i < token.z.len) : (i += 1) pik_append(p, "^");
    pik_append(p, "\n");
}

// Append error message text.  This is either a raw append, or an append
// with HTML escapes, depending on whether the PIKCHR_PLAINTEXT_ERRORS flag
// is set.
fn pik_append_errtxt(p: *Pik, text: []const u8) void {
    if ((p.mFlags & PIKCHR_PLAINTEXT_ERRORS) != 0) {
        pik_append(p, text);
    } else {
        pik_append_text(p, text, 0);
    }
}

// Generate an error message for the output.  pErr is the token at which
// the error should point.  zMsg is the text of the error message. If
// either pErr or zMsg is NULL, generate an out-of-memory error message.
//
// This routine is a no-op if there has already been an error reported.
fn pik_error(p: *Pik, token: ?*const PToken, message: ?[]const u8) void {
    if (p.nErr != 0) return;
    p.nErr += 1;
    const msg = message orelse {
        if ((p.mFlags & PIKCHR_PLAINTEXT_ERRORS) != 0) {
            pik_append(p, "\nOut of memory\n");
        } else {
            pik_append(p, "\n<div><p>Out of memory</p></div>\n");
        }
        return;
    };
    const err = token orelse {
        pik_append(p, "\n");
        pik_append_errtxt(p, msg);
        return;
    };
    if ((p.mFlags & PIKCHR_PLAINTEXT_ERRORS) == 0) {
        pik_append(p, "<div><pre>\n");
    }
    pik_error_context(p, err, 5);
    pik_append(p, "ERROR: ");
    pik_append_errtxt(p, msg);
    pik_append(p, "\n");
    var i = p.nCtx;
    while (i > 0) {
        i -= 1;
        pik_append(p, "Called from:\n");
        pik_error_context(p, &p.aCtx[i], 0);
    }
    if ((p.mFlags & PIKCHR_PLAINTEXT_ERRORS) == 0) {
        pik_append(p, "</pre></div>\n");
    }
}

// Free a complete list of objects
fn pik_elist_free(p: *Pik, list: ?*PList) void {
    const l = list orelse return;
    if (p.list == l) p.list = null;
    for (l.a[0..l.n]) |obj| pik_elem_free(p, obj);
    p.allocator.free(l.a);
    p.allocator.destroy(l);
}

// Free a single object, and its substructure
fn pik_elem_free(p: *Pik, elem: ?*PObj) void {
    const obj = elem orelse return;
    if (obj.zName.len != 0) p.allocator.free(obj.zName);
    var xclass = obj.pXmlClass;
    while (xclass) |xc| {
        const next = xc.pNext;
        p.allocator.free(xc.zClass);
        p.allocator.destroy(xc);
        xclass = next;
    }
    pik_elist_free(p, obj.pSublist);
    p.allocator.free(obj.aPath);
    p.allocator.destroy(obj);
}
} // end include

%include{

const Allocator = std.mem.Allocator;
const OOM = Allocator.Error;

}

%name PikParser
%token_type PToken
%extra_context { p: *Pik }

%fallback ID EDGEPT.

// precedence rules.
%left OF.
%left PLUS MINUS.
%left STAR SLASH PERCENT.
%right UMINUS.

%type statement_list {?*PList}
%destructor statement_list {pik_elist_free(p,$$);}
%type statement {?*PObj}
%destructor statement {pik_elem_free(p,$$);}
%type unnamed_statement {?*PObj}
%destructor unnamed_statement {pik_elem_free(p,$$);}
%type basetype {?*PObj}
%destructor basetype {pik_elem_free(p,$$);}
%type expr PNum
%type numproperty PToken
%type edge PToken
%type direction PToken
%type dashproperty PToken
%type colorproperty PToken
%type locproperty PToken
%type position PPoint
%type place PPoint
%type object {?*PObj}
%type objectname {?*PObj}
%type nth PToken
%type textposition u16
%type rvalue PNum
%type lvalue PToken
%type even PToken
%type relexpr PRel
%type optrelexpr PRel

%syntax_error {
  if( err_token.z.len > 0 ){
    pik_error(p, &err_token, "syntax error");
  }else{
    pik_error(p, null, "syntax error");
  }
}
%stack_overflow {
  pik_error(p, null, "parser stack overflow");
}

document ::= statement_list(X).  { pik_render(p, X); }


statement_list(A) ::= statement(X).   { A = pik_elist_append(p, null, X); }
statement_list(A) ::= statement_list(B) EOL statement(X).
                      { A = pik_elist_append(p, B, X); }


statement(A) ::= .   { A = null; }
statement(A) ::= direction(D).  { pik_set_direction(p, D.eCode); A = null; }
statement(A) ::= lvalue(N) ASSIGN(OP) rvalue(X). { pik_set_var(p, &N, X, &OP); A = null; }
statement(A) ::= PLACENAME(N) COLON unnamed_statement(X).
               { A = X; pik_elem_setname(p, X, &N); }
statement(A) ::= PLACENAME(N) COLON position(P).
               { A = pik_elem_new(p, null, null, null);
                 if (A) |a| { a.ptAt = P; pik_elem_setname(p, a, &N); } }
statement(A) ::= TITLE STRING(S).{ pik_set_title(p, &S, 0); A = null; }
statement(A) ::= LABEL STRING(S). { pik_set_title(p, &S, 1); A = null; }
statement(A) ::= DESCRIBE STRING(S). { pik_set_description(p, &S); A = null; }
statement(A) ::= unnamed_statement(X).  { A = X; }
statement(A) ::= print prlist.  { pik_append(p, "<br>\n"); A = null; }

// assert() statements are undocumented and are intended for testing and
// debugging use only.  If the equality comparison of the assert() fails
// then an error message is generated.
statement(A) ::= ASSERT LP expr(X) EQ(OP) expr(Y) RP. { A = pik_assert(p, X, &OP, Y); }
statement(A) ::= ASSERT LP position(X) EQ(OP) position(Y) RP.
                                          { A = pik_position_assert(p, &X, &OP, &Y); }
statement(A) ::= DEFINE ID(ID) CODEBLOCK(C).  { A = null; pik_add_macro(p, &ID, &C); }

lvalue(A) ::= ID(A).
lvalue(A) ::= FILL(A).
lvalue(A) ::= COLOR(A).
lvalue(A) ::= TEXTCOLOR(A).
lvalue(A) ::= THICKNESS(A).

// PLACENAME might actually be a color name (ex: DarkBlue).  But we
// cannot make it part of expr due to parsing ambiguities.  The
// rvalue non-terminal means "general expression or a colorname"
rvalue(A) ::= expr(A).
rvalue(A) ::= PLACENAME(C).  { A = pik_lookup_color(p, &C); }

print ::= PRINT.
prlist ::= pritem.
prlist ::= prlist prsep pritem.
pritem ::= FILL(X).        { pik_append_num10(p, "", pik_value(p, X.z, null)); }
pritem ::= COLOR(X).       { pik_append_num10(p, "", pik_value(p, X.z, null)); }
pritem ::= THICKNESS(X).   { pik_append_num10(p, "", pik_value(p, X.z, null)); }
pritem ::= rvalue(X).      { pik_append_num10(p, "", X); }
pritem ::= STRING(S).      { pik_append_text(p, tokenInner(&S), 0); }
prsep  ::= COMMA.          { pik_append(p, " "); }

unnamed_statement(A) ::= basetype(X) attribute_list.
                          { A = X; pik_after_adding_attributes(p, A); }

basetype(A) ::= CLASSNAME(N).            { A = pik_elem_new(p, &N, null, null); }
basetype(A) ::= STRING(N) textposition(P).
                            { N.eCode = P; A = pik_elem_new(p, null, &N, null); }
basetype(A) ::= LB savelist(L) statement_list(X) RB(E).
      { p.list = L; A = pik_elem_new(p, null, null, X); if (A) |a| a.errTok = E; }

%type savelist {?*PList}
// No destructor required as this same PList is also held by
// an "statement" non-terminal deeper on the stack.
savelist(A) ::= .   { A = p.list; p.list = null; }

direction(A) ::= UP(A).
direction(A) ::= DOWN(A).
direction(A) ::= LEFT(A).
direction(A) ::= RIGHT(A).

relexpr(A) ::= expr(B).             { A.rAbs = B; A.rRel = 0; }
relexpr(A) ::= expr(B) PERCENT.     { A.rAbs = 0; A.rRel = B / 100; }
optrelexpr(A) ::= relexpr(A).
optrelexpr(A) ::= .                 { A.rAbs = 0; A.rRel = 1.0; }

attribute_list ::= relexpr(X) alist.    { pik_add_direction(p, null, &X); }
attribute_list ::= alist.
alist ::=.
alist ::= alist attribute.
attribute ::= numproperty(P) relexpr(X).     { pik_set_numprop(p, &P, &X); }
attribute ::= dashproperty(P) expr(X).       { pik_set_dashed(p, &P, &X); }
attribute ::= dashproperty(P).               { pik_set_dashed(p, &P, null); }
attribute ::= colorproperty(P) rvalue(X).    { pik_set_clrprop(p, &P, X); }
attribute ::= go direction(D) optrelexpr(X). { pik_add_direction(p, &D, &X); }
attribute ::= go direction(D) even position(P). { pik_evenwith(p, &D, &P); }
attribute ::= CLASS ID(C). {pik_set_xml_class(p, &C);}
attribute ::= CLASS XML_CLASSES(C). {pik_set_xml_classes(p, &C);}
attribute ::= CLOSE(E).             { pik_close_path(p, &E); }
attribute ::= CHOP.                 { p.cur.?.bChop = 1; }
attribute ::= FROM(T) position(X).  { pik_set_from(p, p.cur, &T, &X); }
attribute ::= TO(T) position(X).    { pik_add_to(p, p.cur, &T, &X); }
attribute ::= THEN(T).              { pik_then(p, &T, p.cur); }
attribute ::= THEN(E) optrelexpr(D) HEADING(H) expr(A).
                                                { pik_move_hdg(p, &D, &H, A, null, &E); }
attribute ::= THEN(E) optrelexpr(D) EDGEPT(C).  { pik_move_hdg(p, &D, null, 0, &C, &E); }
attribute ::= GO(E) optrelexpr(D) HEADING(H) expr(A).
                                                { pik_move_hdg(p, &D, &H, A, null, &E); }
attribute ::= GO(E) optrelexpr(D) EDGEPT(C).    { pik_move_hdg(p, &D, null, 0, &C, &E); }
attribute ::= boolproperty.
attribute ::= AT(A) position(P).                    { pik_set_at(p, null, &P, &A); }
attribute ::= WITH withclause.
attribute ::= SAME(E).                          { pik_same(p, null, &E); }
attribute ::= SAME(E) AS object(X).             { pik_same(p, X, &E); }
attribute ::= STRING(T) textposition(P).        { pik_add_txt(p, &T, P); }
attribute ::= FIT(E).                           { pik_size_to_fit(p, &E, 3); }
attribute ::= BEHIND object(X).                 { pik_behind(p, X); }

go ::= GO.
go ::= .

even ::= UNTIL EVEN WITH.
even ::= EVEN WITH.

withclause ::=  DOT_E edge(E) AT(A) position(P).{ pik_set_at(p, &E, &P, &A); }
withclause ::=  edge(E) AT(A) position(P).      { pik_set_at(p, &E, &P, &A); }

// Properties that require an argument
numproperty(A) ::= HEIGHT|WIDTH|RADIUS|DIAMETER|THICKNESS(P).  { A = P; }

// Properties with optional arguments
dashproperty(A) ::= DOTTED(A).
dashproperty(A) ::= DASHED(A).

// Color properties
colorproperty(A) ::= FILL(A).
colorproperty(A) ::= COLOR(A).
colorproperty(A) ::= TEXTCOLOR(A).

// Properties with no argument
boolproperty ::= CW.          { p.cur.?.cw = 1; }
boolproperty ::= CCW.         { p.cur.?.cw = 0; }
boolproperty ::= LARROW.      { p.cur.?.larrow = 1; p.cur.?.rarrow = 0; }
boolproperty ::= RARROW.      { p.cur.?.larrow = 0; p.cur.?.rarrow = 1; }
boolproperty ::= LRARROW.     { p.cur.?.larrow = 1; p.cur.?.rarrow = 1; }
boolproperty ::= INVIS.       { p.cur.?.sw = -0.00001; }
boolproperty ::= THICK.       { p.cur.?.sw *= 1.5; }
boolproperty ::= THIN.        { p.cur.?.sw *= 0.67; }
boolproperty ::= SOLID.       { p.cur.?.sw = pik_value(p, "thickness", null);
                               p.cur.?.dotted = 0.0; p.cur.?.dashed = 0.0; }

textposition(A) ::= .   { A = 0; }
textposition(A) ::= textposition(B)
   CENTER|LJUST|RJUST|ABOVE|BELOW|ITALIC|BOLD|MONO|ALIGNED|BIG|SMALL(F).
                        { A = pik_text_position(B, &F); }


position(A) ::= expr(X) COMMA expr(Y).                { A.x = X; A.y = Y; }
position(A) ::= place(A).
position(A) ::= place(B) PLUS expr(X) COMMA expr(Y).  { A.x = B.x + X; A.y = B.y + Y; }
position(A) ::= place(B) MINUS expr(X) COMMA expr(Y). { A.x = B.x - X; A.y = B.y - Y; }
position(A) ::= place(B) PLUS LP expr(X) COMMA expr(Y) RP.
                                                      { A.x = B.x + X; A.y = B.y + Y; }
position(A) ::= place(B) MINUS LP expr(X) COMMA expr(Y) RP.
                                                      { A.x = B.x - X; A.y = B.y - Y; }
position(A) ::= LP position(X) COMMA position(Y) RP.  { A.x = X.x; A.y = Y.y; }
position(A) ::= LP position(X) RP.                    { A = X; }
position(A) ::= expr(X) between position(P1) AND position(P2).
                                       { A = pik_position_between(X, P1, P2); }
position(A) ::= expr(X) LT position(P1) COMMA position(P2) GT.
                                       { A = pik_position_between(X, P1, P2); }
position(A) ::= expr(X) ABOVE position(B).    { A = B; A.y += X; }
position(A) ::= expr(X) BELOW position(B).    { A = B; A.y -= X; }
position(A) ::= expr(X) LEFT OF position(B).  { A = B; A.x -= X; }
position(A) ::= expr(X) RIGHT OF position(B). { A = B; A.x += X; }
position(A) ::= expr(D) ON HEADING EDGEPT(E) OF position(P).
                                        { A = pik_position_at_hdg(D, &E, P); }
position(A) ::= expr(D) HEADING EDGEPT(E) OF position(P).
                                        { A = pik_position_at_hdg(D, &E, P); }
position(A) ::= expr(D) EDGEPT(E) OF position(P).
                                        { A = pik_position_at_hdg(D, &E, P); }
position(A) ::= expr(D) ON HEADING expr(G) FROM position(P).
                                        { A = pik_position_at_angle(D, G, P); }
position(A) ::= expr(D) HEADING expr(G) FROM position(P).
                                        { A = pik_position_at_angle(D, G, P); }

between ::= WAY BETWEEN.
between ::= BETWEEN.
between ::= OF THE WAY BETWEEN.

// place2 is the same as place, but excludes the forms like
// "RIGHT of object" to avoid a parsing ambiguity with "place .x"
// and "place .y" expressions
%type place2 PPoint

place(A) ::= place2(A).
place(A) ::= edge(X) OF object(O).           { A = pik_place_of_elem(p, O, &X); }
place2(A) ::= object(O).                     { A = pik_place_of_elem(p, O, null); }
place2(A) ::= object(O) DOT_E edge(X).       { A = pik_place_of_elem(p, O, &X); }
place2(A) ::= NTH(N) VERTEX(E) OF object(X). { A = pik_nth_vertex(p, &N, &E, X); }

edge(A) ::= CENTER(A).
edge(A) ::= EDGEPT(A).
edge(A) ::= TOP(A).
edge(A) ::= BOTTOM(A).
edge(A) ::= START(A).
edge(A) ::= END(A).
edge(A) ::= RIGHT(A).
edge(A) ::= LEFT(A).

object(A) ::= objectname(A).
object(A) ::= nth(N).                     { A = pik_find_nth(p, null, &N); }
object(A) ::= nth(N) OF|IN object(B).     { A = pik_find_nth(p, B, &N); }

objectname(A) ::= THIS.                   { A = p.cur; }
objectname(A) ::= PLACENAME(N).           { A = pik_find_byname(p, null, &N); }
objectname(A) ::= objectname(B) DOT_U PLACENAME(N).
                                          { A = pik_find_byname(p, B, &N); }

nth(A) ::= NTH(N) CLASSNAME(ID).      { A = ID; A.eCode = @intCast(pik_nth_value(p, &N)); }
nth(A) ::= NTH(N) LAST CLASSNAME(ID). { A = ID; A.eCode = @bitCast(-pik_nth_value(p, &N)); }
nth(A) ::= LAST CLASSNAME(ID).        { A = ID; A.eCode = @bitCast(@as(i16, -1)); }
nth(A) ::= LAST(ID).                  { A = ID; A.eCode = @bitCast(@as(i16, -1)); }
nth(A) ::= NTH(N) LB(ID) RB.          { A = ID; A.eCode = @intCast(pik_nth_value(p, &N)); }
nth(A) ::= NTH(N) LAST LB(ID) RB.     { A = ID; A.eCode = @bitCast(-pik_nth_value(p, &N)); }
nth(A) ::= LAST LB(ID) RB.            { A = ID; A.eCode = @bitCast(@as(i16, -1)); }

expr(A) ::= expr(X) PLUS expr(Y).                 { A = X + Y; }
expr(A) ::= expr(X) MINUS expr(Y).                { A = X - Y; }
expr(A) ::= expr(X) STAR expr(Y).                 { A = X * Y; }
expr(A) ::= expr(X) SLASH(E) expr(Y).             {
  if (Y == 0.0) { pik_error(p, &E, "division by zero"); A = 0.0; }
  else { A = X / Y; }
}
expr(A) ::= MINUS expr(X). [UMINUS]               { A = -X; }
expr(A) ::= PLUS expr(X). [UMINUS]                { A = X; }
expr(A) ::= LP expr(X) RP.                        { A = X; }
expr(A) ::= LP FILL|COLOR|TEXTCOLOR|THICKNESS(X) RP. { A = pik_get_var(p, &X); }
expr(A) ::= NUMBER(N).                            { A = pik_atof(&N); }
expr(A) ::= ID(N).                                { A = pik_get_var(p, &N); }
expr(A) ::= FUNC1(F) LP expr(X) RP.               { A = pik_func(p, &F, X, 0.0); }
expr(A) ::= FUNC2(F) LP expr(X) COMMA expr(Y) RP. { A = pik_func(p, &F, X, Y); }
expr(A) ::= DIST LP position(X) COMMA position(Y) RP. { A = pik_dist(&X, &Y); }
expr(A) ::= place2(B) DOT_XY X.                   { A = B.x; }
expr(A) ::= place2(B) DOT_XY Y.                   { A = B.y; }
expr(A) ::= object(B) DOT_L numproperty(P).       { A = pik_property_of(B, &P); }
expr(A) ::= object(B) DOT_L dashproperty(P).      { A = pik_property_of(B, &P); }
expr(A) ::= object(B) DOT_L colorproperty(P).     { A = pik_property_of(B, &P); }

%code {

// Return the contents of a STRING token without the outer quote marks.
fn tokenInner(t: *const PToken) []const u8 {
    if (t.z.len < 2) return "";
    return t.z[1 .. t.z.len - 1];
}

const Builtin = struct {
    zName: []const u8,
    val: PNum,
};

// Built-in variable names.
//
// This array is constant.  When a script changes the value of one of
// these built-ins, a new PVar record is added at the head of
// the Pik.pVar list, which is searched first.  Thus the new PVar entry
// will override this default value.
//
// Units are in inches, except for "color" and "fill" which are
// interpreted as 24-bit RGB values.
//
// Binary search used.  Must be kept in sorted order.
const aBuiltin = [_]Builtin{
    .{ .zName = "arcrad", .val = 0.25 },
    .{ .zName = "arrowhead", .val = 2.0 },
    .{ .zName = "arrowht", .val = 0.08 },
    .{ .zName = "arrowwid", .val = 0.06 },
    .{ .zName = "boxht", .val = 0.5 },
    .{ .zName = "boxrad", .val = 0.0 },
    .{ .zName = "boxwid", .val = 0.75 },
    .{ .zName = "charht", .val = 0.14 },
    .{ .zName = "charwid", .val = 0.08 },
    .{ .zName = "circlerad", .val = 0.25 },
    .{ .zName = "color", .val = 0.0 },
    .{ .zName = "cylht", .val = 0.5 },
    .{ .zName = "cylrad", .val = 0.075 },
    .{ .zName = "cylwid", .val = 0.75 },
    .{ .zName = "dashwid", .val = 0.05 },
    .{ .zName = "diamondht", .val = 0.75 },
    .{ .zName = "diamondwid", .val = 1.0 },
    .{ .zName = "dotrad", .val = 0.015 },
    .{ .zName = "ellipseht", .val = 0.5 },
    .{ .zName = "ellipsewid", .val = 0.75 },
    .{ .zName = "fileht", .val = 0.75 },
    .{ .zName = "filerad", .val = 0.15 },
    .{ .zName = "filewid", .val = 0.5 },
    .{ .zName = "fill", .val = -1.0 },
    .{ .zName = "lineht", .val = 0.5 },
    .{ .zName = "linewid", .val = 0.5 },
    .{ .zName = "movewid", .val = 0.5 },
    .{ .zName = "ovalht", .val = 0.5 },
    .{ .zName = "ovalwid", .val = 1.0 },
    .{ .zName = "scale", .val = 1.0 },
    .{ .zName = "textcolor", .val = 0.0 },
    .{ .zName = "textht", .val = 0.5 },
    .{ .zName = "textwid", .val = 0.75 },
    .{ .zName = "thickness", .val = 0.015 },
};

const Color = struct {
    zName: []const u8,
    val: i32,
};

// Chart of the 148 official CSS color names with their
// corresponding RGB values thru Color Module Level 4:
// https://developer.mozilla.org/en-US/docs/Web/CSS/color_value
//
// Two new names "None" and "Off" are added with a value
// of -1.
const aColor = [_]Color{
    .{ .zName = "AliceBlue", .val = 0xf0f8ff },
    .{ .zName = "AntiqueWhite", .val = 0xfaebd7 },
    .{ .zName = "Aqua", .val = 0x00ffff },
    .{ .zName = "Aquamarine", .val = 0x7fffd4 },
    .{ .zName = "Azure", .val = 0xf0ffff },
    .{ .zName = "Beige", .val = 0xf5f5dc },
    .{ .zName = "Bisque", .val = 0xffe4c4 },
    .{ .zName = "Black", .val = 0x000000 },
    .{ .zName = "BlanchedAlmond", .val = 0xffebcd },
    .{ .zName = "Blue", .val = 0x0000ff },
    .{ .zName = "BlueViolet", .val = 0x8a2be2 },
    .{ .zName = "Brown", .val = 0xa52a2a },
    .{ .zName = "BurlyWood", .val = 0xdeb887 },
    .{ .zName = "CadetBlue", .val = 0x5f9ea0 },
    .{ .zName = "Chartreuse", .val = 0x7fff00 },
    .{ .zName = "Chocolate", .val = 0xd2691e },
    .{ .zName = "Coral", .val = 0xff7f50 },
    .{ .zName = "CornflowerBlue", .val = 0x6495ed },
    .{ .zName = "Cornsilk", .val = 0xfff8dc },
    .{ .zName = "Crimson", .val = 0xdc143c },
    .{ .zName = "Cyan", .val = 0x00ffff },
    .{ .zName = "DarkBlue", .val = 0x00008b },
    .{ .zName = "DarkCyan", .val = 0x008b8b },
    .{ .zName = "DarkGoldenrod", .val = 0xb8860b },
    .{ .zName = "DarkGray", .val = 0xa9a9a9 },
    .{ .zName = "DarkGreen", .val = 0x006400 },
    .{ .zName = "DarkGrey", .val = 0xa9a9a9 },
    .{ .zName = "DarkKhaki", .val = 0xbdb76b },
    .{ .zName = "DarkMagenta", .val = 0x8b008b },
    .{ .zName = "DarkOliveGreen", .val = 0x556b2f },
    .{ .zName = "DarkOrange", .val = 0xff8c00 },
    .{ .zName = "DarkOrchid", .val = 0x9932cc },
    .{ .zName = "DarkRed", .val = 0x8b0000 },
    .{ .zName = "DarkSalmon", .val = 0xe9967a },
    .{ .zName = "DarkSeaGreen", .val = 0x8fbc8f },
    .{ .zName = "DarkSlateBlue", .val = 0x483d8b },
    .{ .zName = "DarkSlateGray", .val = 0x2f4f4f },
    .{ .zName = "DarkSlateGrey", .val = 0x2f4f4f },
    .{ .zName = "DarkTurquoise", .val = 0x00ced1 },
    .{ .zName = "DarkViolet", .val = 0x9400d3 },
    .{ .zName = "DeepPink", .val = 0xff1493 },
    .{ .zName = "DeepSkyBlue", .val = 0x00bfff },
    .{ .zName = "DimGray", .val = 0x696969 },
    .{ .zName = "DimGrey", .val = 0x696969 },
    .{ .zName = "DodgerBlue", .val = 0x1e90ff },
