%include {
//! Pikchr grammar for the Zig port.
//!
//! This is derived from the modified `pikchr/pikchr.y` in this repository.
//! The reduce actions intentionally stay inline for now; do not split them
//! into Zitron `%impl @name(...)` blocks during this pass.

pub const PNum = f64; // Numeric value

// Compass points
pub const CP_N = 1;
pub const CP_NE = 2;
pub const CP_E = 3;
pub const CP_SE = 4;
pub const CP_S = 5;
pub const CP_SW = 6;
pub const CP_W = 7;
pub const CP_NW = 8;
pub const CP_C = 9; // .center or .c
pub const CP_END = 10; // .end
pub const CP_START = 11; // .start

// Heading angles corresponding to compass points
pub const pik_hdg_angle = [_]PNum{
    0.0, // none
    0.0, // N
    45.0, // NE
    90.0, // E
    135.0, // SE
    180.0, // S
    225.0, // SW
    270.0, // W
    315.0, // NW
    0.0, // C
};

// Built-in functions
pub const FN_ABS = 0;
pub const FN_COS = 1;
pub const FN_INT = 2;
pub const FN_MAX = 3;
pub const FN_MIN = 4;
pub const FN_SIN = 5;
pub const FN_SQRT = 6;

// Text position and style flags.  Stored in PToken.eCode so limited
// to 15 bits.
pub const TP_LJUST = 0x0001; // left justify......
pub const TP_RJUST = 0x0002; //            ...Right justify
pub const TP_JMASK = 0x0003; // Mask for justification bits
pub const TP_ABOVE2 = 0x0004; // Position text way above PObj.ptAt
pub const TP_ABOVE = 0x0008; // Position text above PObj.ptAt
pub const TP_CENTER = 0x0010; // On the line
pub const TP_BELOW = 0x0020; // Position text below PObj.ptAt
pub const TP_BELOW2 = 0x0040; // Position text way below PObj.ptAt
pub const TP_VMASK = 0x007c; // Mask for text positioning flags
pub const TP_BIG = 0x0100; // Larger font
pub const TP_SMALL = 0x0200; // Smaller font
pub const TP_XTRA = 0x0400; // Amplify TP_BIG or TP_SMALL
pub const TP_SZMASK = 0x0700; // Font size mask
pub const TP_ITALIC = 0x1000; // Italic font
pub const TP_BOLD = 0x2000; // Bold font
pub const TP_MONO = 0x4000; // Monospace font family
pub const TP_FMASK = 0x7000; // Mask for font style
pub const TP_ALIGN = 0x8000; // Rotate to align with the line

// Style attribute flags.  These track when a presentation attribute
// such as dominant-baseline is needed.
pub const ATTR_BASELINE = 0x01; // Include dominant-baseline="central"
pub const ATTR_T_START = 0x02; // text-anchor="start"
pub const ATTR_T_MIDDLE = 0x04; // text-anchor="middle"
pub const ATTR_T_END = 0x08; // text-anchor="end"
pub const ATTR_F_ITALIC = 0x10; // font-style="italic"
pub const ATTR_F_BOLD = 0x20; // font-weight="bold"
pub const ATTR_F_MONO = 0x40; // font-family="monospace"
pub const ATTR_FILL_NO = 0x80; // fill="transparent"

// An object to hold a position in 2-D space
pub const PPoint = struct {
    x: PNum = 0.0, // X coordinate
    y: PNum = 0.0, // Y coordinate
};
pub const cZeroPoint = PPoint{ .x = 0.0, .y = 0.0 };

// A bounding box
pub const PBox = struct {
    sw: PPoint = .{}, // Lower-left corner
    ne: PPoint = .{}, // Top-right corner
};

// An Absolute or a relative distance.  The absolute distance
// is stored in rAbs and the relative distance is stored in rRel.
// Usually, one or the other will be 0.0.  When using a PRel to
// update an existing value, the computation is usually something
// like this:
//
//          value = PRel.rAbs + value*PRel.rRel
//
pub const PRel = struct {
    rAbs: PNum = 0.0, // Absolute value
    rRel: PNum = 0.0, // Value relative to current value
};

// A node in a linked list of SVG classes.
//
pub const PXmlClass = struct {
    zClass: []u8 = &.{}, // Class identifier
    pNext: ?*PXmlClass = null, // Next class in an element's list
};

// A variable created by the ID = EXPR construct of the PIKCHR script
//
// PIKCHR (and PIC) scripts do not use many variables, so it is reasonable
// to store them all on a linked list.
pub const PVar = struct {
    zName: []u8 = &.{}, // Name of the variable
    val: PNum = 0.0, // Value of the variable
    pNext: ?*PVar = null, // Next variable in a list of them all
};

// A single token in the parser input stream
pub const PToken = struct {
    z: []const u8 = "", // Pointer to the token text
    n: usize = 0, // Length of the token in bytes
    eCode: i16 = 0, // Auxiliary code
    eType: u8 = 0, // The numeric parser code
    eEdge: u8 = 0, // Corner value for corner keywords
};

// Return negative, zero, or positive if pToken is less than, equal to
// or greater than the zero-terminated string z[]
fn pik_token_eq(pToken: *PToken, z: []const u8) i32 {
    const n = @min(pToken.n, z.len);
    const c = std.mem.order(u8, pToken.z[0..n], z[0..n]);
    if (c != .eq) return if (c == .lt) -1 else 1;
    if (pToken.n < z.len) return -1;
    if (pToken.n > z.len) return 1;
    return 0;
}

// Extra token types not generated by LEMON but needed by the
// tokenizer
pub const T_PARAMETER = 253; // $1, $2, ..., $9
pub const T_WHITESPACE = 254; // Whitespace or comments
pub const T_ERROR = 255; // Any text that is not a valid token

// Directions of movement
pub const DIR_RIGHT = 0;
pub const DIR_DOWN = 1;
pub const DIR_LEFT = 2;
pub const DIR_UP = 3;
fn ValidDir(x: anytype) bool {
    return x >= 0 and x <= 3;
}
fn IsUpDown(x: anytype) bool {
    return (x & 1) == 1;
}
fn IsLeftRight(x: anytype) bool {
    return (x & 1) == 0;
}

// Bitmask for the various attributes for PObj.  These bits are
// collected in PObj.mProp and PObj.mCalc to check for constraint
// errors.
pub const A_WIDTH = 0x0001;
pub const A_HEIGHT = 0x0002;
pub const A_RADIUS = 0x0004;
pub const A_THICKNESS = 0x0008;
pub const A_DASHED = 0x0010; // Includes "dotted"
pub const A_FILL = 0x0020;
pub const A_COLOR = 0x0040;
pub const A_ARROW = 0x0080;
pub const A_FROM = 0x0100;
pub const A_CW = 0x0200;
pub const A_AT = 0x0400;
pub const A_TO = 0x0800; // one or more movement attributes
pub const A_FIT = 0x1000;
pub const A_TEXTCOLOR = 0x2000;
pub const A_CLASS = 0x4000;

// Color properties for seenColor masking
pub const C_COLOR = 0x01;
pub const C_FILL = 0x02;
pub const C_TEXT = 0x04;

// A single graphics object
pub const PObj = struct {
    type: ?*const PClass = null, // Object type or class
    errTok: PToken = .{}, // Reference token for error messages
    ptAt: PPoint = .{}, // Reference point for the object
    ptEnter: PPoint = .{}, // Entry point
    ptExit: PPoint = .{}, // Exit point
    pSublist: ?*PList = null, // Substructure for [...] objects
    pXmlClass: ?*PXmlClass = null, // Optional list of assigned XML classes
    zName: ?[]u8 = null, // Name assigned to this statement
    w: PNum = 0.0, // "width" property
    h: PNum = 0.0, // "height" property
    rad: PNum = 0.0, // "radius" property
    sw: PNum = 0.0, // "thickness" property. (Mnemonic: "stroke width")
    dotted: PNum = 0.0, // "dotted" property.   <=0.0 for off
    dashed: PNum = 0.0, // "dashed" property.   <=0.0 for off
    fill: PNum = 0.0, // "fill" property.  Negative for off
    color: PNum = 0.0, // "color" property
    textcolor: PNum = 0.0, // "textcolor" property
    with: PPoint = .{}, // Position constraint from WITH clause
    eWith: u8 = 0, // Type of heading point on WITH clause
    cw: u8 = 0, // True for clockwise arc
    larrow: u8 = 0, // Arrow at beginning (<- or <->)
    rarrow: u8 = 0, // Arrow at end  (-> or <->)
    bClose: u8 = 0, // True if "close" is seen
    bChop: u8 = 0, // True if "chop" is seen
    bAltAutoFit: u8 = 0, // Always send both h and w into xFit()
    nTxt: usize = 0, // Number of text values
    mProp: u32 = 0, // Masks of properties set so far
    mCalc: u32 = 0, // Values computed from other constraints
    aTxt: [5]PToken = [_]PToken{.{}} ** 5, // Text with .eCode holding TP flags
    iLayer: i32 = 0, // Rendering order
    inDir: i32 = 0, // Entry direction
    outDir: i32 = 0, // Exit direction
    nPath: i32 = 0, // Number of path points
    aPath: []PPoint = &.{}, // Array of path points
    pFrom: ?*PObj = null, // End-point objects of a path
    pTo: ?*PObj = null, // End-point objects of a path
    bbox: PBox = .{}, // Bounding box
};

// A list of graphics objects
pub const PList = struct {
    n: usize = 0, // Number of statements in the list
    nAlloc: usize = 0, // Allocated slots in a[]
    a: []*PObj = &.{}, // Pointers to individual objects
};

// A macro definition
pub const PMacro = struct {
    pNext: ?*PMacro = null, // Next in the list
    macroName: PToken = .{}, // Name of the macro
    macroBody: PToken = .{}, // Body of the macro
    inUse: i32 = 0, // Do not allow recursion
};

// Each call to the pikchr() subroutine uses an instance of the following
// object to pass around context to all of its subroutines.
pub const Pik = struct {
    allocator: std.mem.Allocator, // Allocator for all per-render memory
    io: std.Io, // I/O provider used by parser/render helpers
    nErr: u32 = 0, // Number of errors seen
    nToken: u32 = 0, // Number of tokens parsed
    sIn: PToken = .{}, // Input Pikchr-language text
    zOut: std.Io.Writer.Allocating, // Result accumulates here
    shaDigest: std.crypto.hash.Sha1 = std.crypto.hash.Sha1.init(.{}), // The hashing context for tokens
    eDir: u8 = DIR_RIGHT, // Current direction
    mFlags: u32 = 0, // Flags passed to pikchr()
    cur: ?*PObj = null, // Object under construction
    lastRef: ?*PObj = null, // Last object references by name
    list: ?*PList = null, // Object list under construction
    pMacros: ?*PMacro = null, // List of all defined macros
    pVar: ?*PVar = null, // Application-defined variables
    bbox: PBox = .{}, // Bounding box around all statements
    // Cache of layout values.  <=0.0 for unknown...
    rScale: PNum = 0.0, // Multiply to convert inches to pixels
    fontScale: PNum = 0.0, // Scale fonts by this percent
    charWidth: PNum = 0.0, // Character width
    charHeight: PNum = 0.0, // Character height
    wArrow: PNum = 0.0, // Width of arrowhead at the fat end
    hArrow: PNum = 0.0, // Ht of arrowhead - dist from tip to fat end
    bLayoutVars: u8 = 0, // True if cache is valid
    thenFlag: u8 = 0, // True if "then" seen
    bLabel: u8 = 0, // True if zTitle should be rendered as a label
    samePath: u8 = 0, // aTPath copied by "same"
    bEOL: u8 = 0, // Flag for if we're in a run of T_EOL (hashing)
    mAttr: u8 = 0, // Flags for when to include certain styles
    zClass: ?[]const u8 = null, // Class name for the <svg>
    zID: ?[]u8 = null, // Suffix for id fields
    zTitle: ?[]u8 = null, // Text of title or label
    zDesc: ?[]u8 = null, // Text of extended description
    wSVG: i32 = 0, // Width of the <svg>
    hSVG: i32 = 0, // Height of the <svg>
    fgcolor: i32 = -1, // foreground color value, or -1 for none
    bgcolor: i32 = -1, // background color value, or -1 for none
    seenColor: [150]u8 = [_]u8{0} ** 150, // which built-in colors have been seen
    // Paths for lines are constructed here first, then transferred into
    // the PObj object at the end:
    nTPath: i32 = 0, // Number of entries on aTPath[]
    mTPath: i32 = 0, // For last entry, 1: x set,  2: y set
    aTPath: [1000]PPoint = [_]PPoint{.{}} ** 1000, // Path under construction
    // Error contexts
    nCtx: u32 = 0, // Number of error contexts
    aCtx: [10]PToken = [_]PToken{.{}} ** 10, // Nested error contexts

    pub fn init(
        allocator: std.mem.Allocator,
        io: std.Io,
        source: []const u8,
        class: ?[]const u8,
        flags: u32,
    ) Pik {
        return .{
            .allocator = allocator,
            .io = io,
            .sIn = .{ .z = source, .n = source.len },
            .zOut = .init(allocator),
            .zClass = class,
            .mFlags = flags,
        };
    }

    pub fn deinit(p: *Pik) void {
        p.zOut.deinit();
        if (p.zID) |z| p.allocator.free(z);
        if (p.zTitle) |z| p.allocator.free(z);
        if (p.zDesc) |z| p.allocator.free(z);
        var v = p.pVar;
        while (v) |vv| {
            const next = vv.pNext;
            p.allocator.free(vv.zName);
            p.allocator.destroy(vv);
            v = next;
        }
        var m = p.pMacros;
        while (m) |mm| {
            const next = mm.pNext;
            p.allocator.destroy(mm);
            m = next;
        }
        pik_elist_free(p, p.list);
    }
};

// Include PIKCHR_PLAINTEXT_ERRORS among the bits of mFlags on the 3rd
// argument to pikchr() in order to cause error message text to come out
// as text/plain instead of as text/html
pub const PIKCHR_PLAINTEXT_ERRORS = 0x0001;

// Include PIKCHR_DARK_MODE among the mFlag bits to invert colors.
pub const PIKCHR_DARK_MODE = 0x0002;

// Include PIKCHR_EXTRA_UNIQUE_ID among the mFlag bits to add a value
// to each hash of a call to `char *pikchr`.  This value is taken from
// a counter, meaning the id is based both on the tokens of the Pikchr
// script, and the order in which the diagram is produced.  This could
// be useful in settings like forums, where more than one copy of a
// diagram may appear.
pub const PIKCHR_EXTRA_UNIQUE_ID = 0x0004;

// The behavior of an object class is defined by an instance of
// this structure. This is the "virtual method" table.
pub const PClass = struct {
    zName: []const u8, // Name of class
    isLine: u8, // True if a line class
    eJust: u8, // Use box-style text justification
    xInit: ?*const fn (*Pik, *PObj) void, // Initializer
    xNumProp: ?*const fn (*Pik, *PObj, *PToken) void, // Value change notification
    xCheck: ?*const fn (*Pik, *PObj) void, // Checks to do after parsing
    xChop: ?*const fn (*Pik, *PObj, *PPoint) PPoint, // Chopper
    xOffset: ?*const fn (*Pik, *PObj, i32) PPoint, // Offset from .c to edge point
    xFit: ?*const fn (*Pik, *PObj, PNum, PNum) void, // Size to fit text
    xRender: ?*const fn (*Pik, *PObj) void, // Render
};

fn pik_error(p: *Pik, token: ?*const PToken, message: ?[]const u8) void {
    if (p.nErr != 0) return;
    p.nErr += 1;
    const msg = message orelse {
        if ((p.mFlags & PIKCHR_PLAINTEXT_ERRORS) != 0) {
            pik_append(p, "\nOut of memory\n");
        } else {
            pik_append(p, "\n<div><p>Out of memory</p></div>\n");
        }
        return;
    };
    if ((p.mFlags & PIKCHR_PLAINTEXT_ERRORS) == 0) {
        pik_append(p, "<div><pre>\n");
    }
    if (token) |_| {}
    pik_append(p, "ERROR: ");
    pik_append_text(p, msg, 2);
    pik_append(p, "\n");
    if ((p.mFlags & PIKCHR_PLAINTEXT_ERRORS) == 0) {
        pik_append(p, "</pre></div>\n");
    }
}

fn pik_elist_free(p: *Pik, list: ?*PList) void {
    const l = list orelse return;
    for (l.a[0..l.n]) |obj| pik_elem_free(p, obj);
    p.allocator.free(l.a);
    p.allocator.destroy(l);
}

fn pik_elem_free(p: *Pik, elem: ?*PObj) void {
    const obj = elem orelse return;
    if (obj.zName) |z| p.allocator.free(z);
    var xclass = obj.pXmlClass;
    while (xclass) |xc| {
        const next = xc.pNext;
        p.allocator.free(xc.zClass);
        p.allocator.destroy(xc);
        xclass = next;
    }
    pik_elist_free(p, obj.pSublist);
    p.allocator.free(obj.aPath);
    p.allocator.destroy(obj);
}
} /* end include */

%name PikParser
%token_type PToken
%extra_context { p: *Pik }

%fallback ID EDGEPT.

// precedence rules.
%left OF.
%left PLUS MINUS.
%left STAR SLASH PERCENT.
%right UMINUS.

%type statement_list {?*PList}
%destructor statement_list {pik_elist_free(p,$$);}
%type statement {?*PObj}
%destructor statement {pik_elem_free(p,$$);}
%type unnamed_statement {?*PObj}
%destructor unnamed_statement {pik_elem_free(p,$$);}
%type basetype {?*PObj}
%destructor basetype {pik_elem_free(p,$$);}
%type expr PNum
%type numproperty PToken
%type edge PToken
%type direction PToken
%type dashproperty PToken
%type colorproperty PToken
%type locproperty PToken
%type position PPoint
%type place PPoint
%type object {?*PObj}
%type objectname {?*PObj}
%type nth PToken
%type textposition i16
%type rvalue PNum
%type lvalue PToken
%type even PToken
%type relexpr PRel
%type optrelexpr PRel

%syntax_error {
  if( err_token.z.len > 0 ){
    pik_error(p, &err_token, "syntax error");
  }else{
    pik_error(p, null, "syntax error");
  }
}
%stack_overflow {
  pik_error(p, null, "parser stack overflow");
}

document ::= statement_list(X).  { pik_render(p, X); }


statement_list(A) ::= statement(X).   { A = pik_elist_append(p, null, X); }
statement_list(A) ::= statement_list(B) EOL statement(X).
                      { A = pik_elist_append(p, B, X); }


statement(A) ::= .   { A = null; }
statement(A) ::= direction(D).  { pik_set_direction(p, D.eCode); A = null; }
statement(A) ::= lvalue(N) ASSIGN(OP) rvalue(X). { pik_set_var(p, &N, X, &OP); A = null; }
statement(A) ::= PLACENAME(N) COLON unnamed_statement(X).
               { A = X; pik_elem_setname(p, X, &N); }
statement(A) ::= PLACENAME(N) COLON position(P).
               { A = pik_elem_new(p, null, null, null);
                 if (A) |a| { a.ptAt = P; pik_elem_setname(p, a, &N); } }
statement(A) ::= TITLE STRING(S).{ pik_set_title(p, &S, 0); A = null; }
statement(A) ::= LABEL STRING(S). { pik_set_title(p, &S, 1); A = null; }
statement(A) ::= DESCRIBE STRING(S). { pik_set_description(p, &S); A = null; }
statement(A) ::= unnamed_statement(X).  { A = X; }
statement(A) ::= print prlist.  { pik_append(p, "<br>\n"); A = null; }

// assert() statements are undocumented and are intended for testing and
// debugging use only.  If the equality comparison of the assert() fails
// then an error message is generated.
statement(A) ::= ASSERT LP expr(X) EQ(OP) expr(Y) RP. { A = pik_assert(p, X, &OP, Y); }
statement(A) ::= ASSERT LP position(X) EQ(OP) position(Y) RP.
                                          { A = pik_position_assert(p, &X, &OP, &Y); }
statement(A) ::= DEFINE ID(ID) CODEBLOCK(C).  { A = null; pik_add_macro(p, &ID, &C); }

lvalue(A) ::= ID(A).
lvalue(A) ::= FILL(A).
lvalue(A) ::= COLOR(A).
lvalue(A) ::= TEXTCOLOR(A).
lvalue(A) ::= THICKNESS(A).

// PLACENAME might actually be a color name (ex: DarkBlue).  But we
// cannot make it part of expr due to parsing ambiguities.  The
// rvalue non-terminal means "general expression or a colorname"
rvalue(A) ::= expr(A).
rvalue(A) ::= PLACENAME(C).  { A = pik_lookup_color(p, &C); }

print ::= PRINT.
prlist ::= pritem.
prlist ::= prlist prsep pritem.
pritem ::= FILL(X).        { pik_append_num(p, "", pik_value(p, X.z, null)); }
pritem ::= COLOR(X).       { pik_append_num(p, "", pik_value(p, X.z, null)); }
pritem ::= THICKNESS(X).   { pik_append_num(p, "", pik_value(p, X.z, null)); }
pritem ::= rvalue(X).      { pik_append_num(p, "", X); }
pritem ::= STRING(S).      { pik_append_text(p, tokenInner(&S), 0); }
prsep  ::= COMMA.          { pik_append(p, " "); }

unnamed_statement(A) ::= basetype(X) attribute_list.
                          { A = X; pik_after_adding_attributes(p, A); }

basetype(A) ::= CLASSNAME(N).            { A = pik_elem_new(p, &N, null, null); }
basetype(A) ::= STRING(N) textposition(P).
                            { N.eCode = P; A = pik_elem_new(p, null, &N, null); }
basetype(A) ::= LB savelist(L) statement_list(X) RB(E).
      { p.list = L; A = pik_elem_new(p, null, null, X); if (A) |a| a.errTok = E; }

%type savelist {?*PList}
// No destructor required as this same PList is also held by
// an "statement" non-terminal deeper on the stack.
savelist(A) ::= .   { A = p.list; p.list = null; }

direction(A) ::= UP(A).
direction(A) ::= DOWN(A).
direction(A) ::= LEFT(A).
direction(A) ::= RIGHT(A).

relexpr(A) ::= expr(B).             { A.rAbs = B; A.rRel = 0; }
relexpr(A) ::= expr(B) PERCENT.     { A.rAbs = 0; A.rRel = B / 100; }
optrelexpr(A) ::= relexpr(A).
optrelexpr(A) ::= .                 { A.rAbs = 0; A.rRel = 1.0; }

attribute_list ::= relexpr(X) alist.    { pik_add_direction(p, null, &X); }
attribute_list ::= alist.
alist ::=.
alist ::= alist attribute.
attribute ::= numproperty(P) relexpr(X).     { pik_set_numprop(p, &P, &X); }
attribute ::= dashproperty(P) expr(X).       { pik_set_dashed(p, &P, &X); }
attribute ::= dashproperty(P).               { pik_set_dashed(p, &P, null); }
attribute ::= colorproperty(P) rvalue(X).    { pik_set_clrprop(p, &P, X); }
attribute ::= go direction(D) optrelexpr(X). { pik_add_direction(p, &D, &X); }
attribute ::= go direction(D) even position(P). { pik_evenwith(p, &D, &P); }
attribute ::= CLASS ID(C). {pik_set_xml_class(p, &C);}
attribute ::= CLASS XML_CLASSES(C). {pik_set_xml_classes(p, &C);}
attribute ::= CLOSE(E).             { pik_close_path(p, &E); }
attribute ::= CHOP.                 { p.cur.?.bChop = 1; }
attribute ::= FROM(T) position(X).  { pik_set_from(p, p.cur, &T, &X); }
attribute ::= TO(T) position(X).    { pik_add_to(p, p.cur, &T, &X); }
attribute ::= THEN(T).              { pik_then(p, &T, p.cur); }
attribute ::= THEN(E) optrelexpr(D) HEADING(H) expr(A).
                                                { pik_move_hdg(p, &D, &H, A, null, &E); }
attribute ::= THEN(E) optrelexpr(D) EDGEPT(C).  { pik_move_hdg(p, &D, null, 0, &C, &E); }
attribute ::= GO(E) optrelexpr(D) HEADING(H) expr(A).
                                                { pik_move_hdg(p, &D, &H, A, null, &E); }
attribute ::= GO(E) optrelexpr(D) EDGEPT(C).    { pik_move_hdg(p, &D, null, 0, &C, &E); }
attribute ::= boolproperty.
attribute ::= AT(A) position(P).                    { pik_set_at(p, null, &P, &A); }
attribute ::= WITH withclause.
attribute ::= SAME(E).                          { pik_same(p, null, &E); }
attribute ::= SAME(E) AS object(X).             { pik_same(p, X, &E); }
attribute ::= STRING(T) textposition(P).        { pik_add_txt(p, &T, P); }
attribute ::= FIT(E).                           { pik_size_to_fit(p, &E, 3); }
attribute ::= BEHIND object(X).                 { pik_behind(p, X); }

go ::= GO.
go ::= .

even ::= UNTIL EVEN WITH.
even ::= EVEN WITH.

withclause ::=  DOT_E edge(E) AT(A) position(P).{ pik_set_at(p, &E, &P, &A); }
withclause ::=  edge(E) AT(A) position(P).      { pik_set_at(p, &E, &P, &A); }

// Properties that require an argument
numproperty(A) ::= HEIGHT|WIDTH|RADIUS|DIAMETER|THICKNESS(P).  { A = P; }

// Properties with optional arguments
dashproperty(A) ::= DOTTED(A).
dashproperty(A) ::= DASHED(A).

// Color properties
colorproperty(A) ::= FILL(A).
colorproperty(A) ::= COLOR(A).
colorproperty(A) ::= TEXTCOLOR(A).

// Properties with no argument
boolproperty ::= CW.          { p.cur.?.cw = 1; }
boolproperty ::= CCW.         { p.cur.?.cw = 0; }
boolproperty ::= LARROW.      { p.cur.?.larrow = 1; p.cur.?.rarrow = 0; }
boolproperty ::= RARROW.      { p.cur.?.larrow = 0; p.cur.?.rarrow = 1; }
boolproperty ::= LRARROW.     { p.cur.?.larrow = 1; p.cur.?.rarrow = 1; }
boolproperty ::= INVIS.       { p.cur.?.sw = -0.00001; }
boolproperty ::= THICK.       { p.cur.?.sw *= 1.5; }
boolproperty ::= THIN.        { p.cur.?.sw *= 0.67; }
boolproperty ::= SOLID.       { p.cur.?.sw = pik_value(p, "thickness", null);
                               p.cur.?.dotted = 0.0; p.cur.?.dashed = 0.0; }

textposition(A) ::= .   { A = 0; }
textposition(A) ::= textposition(B)
   CENTER|LJUST|RJUST|ABOVE|BELOW|ITALIC|BOLD|MONO|ALIGNED|BIG|SMALL(F).
                        { A = @intCast(pik_text_position(B, &F)); }


position(A) ::= expr(X) COMMA expr(Y).                { A.x = X; A.y = Y; }
position(A) ::= place(A).
position(A) ::= place(B) PLUS expr(X) COMMA expr(Y).  { A.x = B.x + X; A.y = B.y + Y; }
position(A) ::= place(B) MINUS expr(X) COMMA expr(Y). { A.x = B.x - X; A.y = B.y - Y; }
position(A) ::= place(B) PLUS LP expr(X) COMMA expr(Y) RP.
                                                      { A.x = B.x + X; A.y = B.y + Y; }
position(A) ::= place(B) MINUS LP expr(X) COMMA expr(Y) RP.
                                                      { A.x = B.x - X; A.y = B.y - Y; }
position(A) ::= LP position(X) COMMA position(Y) RP.  { A.x = X.x; A.y = Y.y; }
position(A) ::= LP position(X) RP.                    { A = X; }
position(A) ::= expr(X) between position(P1) AND position(P2).
                                       { A = pik_position_between(X, P1, P2); }
position(A) ::= expr(X) LT position(P1) COMMA position(P2) GT.
                                       { A = pik_position_between(X, P1, P2); }
position(A) ::= expr(X) ABOVE position(B).    { A = B; A.y += X; }
position(A) ::= expr(X) BELOW position(B).    { A = B; A.y -= X; }
position(A) ::= expr(X) LEFT OF position(B).  { A = B; A.x -= X; }
position(A) ::= expr(X) RIGHT OF position(B). { A = B; A.x += X; }
position(A) ::= expr(D) ON HEADING EDGEPT(E) OF position(P).
                                        { A = pik_position_at_hdg(D, &E, P); }
position(A) ::= expr(D) HEADING EDGEPT(E) OF position(P).
                                        { A = pik_position_at_hdg(D, &E, P); }
position(A) ::= expr(D) EDGEPT(E) OF position(P).
                                        { A = pik_position_at_hdg(D, &E, P); }
position(A) ::= expr(D) ON HEADING expr(G) FROM position(P).
                                        { A = pik_position_at_angle(D, G, P); }
position(A) ::= expr(D) HEADING expr(G) FROM position(P).
                                        { A = pik_position_at_angle(D, G, P); }

between ::= WAY BETWEEN.
between ::= BETWEEN.
between ::= OF THE WAY BETWEEN.

// place2 is the same as place, but excludes the forms like
// "RIGHT of object" to avoid a parsing ambiguity with "place .x"
// and "place .y" expressions
%type place2 PPoint

place(A) ::= place2(A).
place(A) ::= edge(X) OF object(O).           { A = pik_place_of_elem(p, O, &X); }
place2(A) ::= object(O).                     { A = pik_place_of_elem(p, O, null); }
place2(A) ::= object(O) DOT_E edge(X).       { A = pik_place_of_elem(p, O, &X); }
place2(A) ::= NTH(N) VERTEX(E) OF object(X). { A = pik_nth_vertex(p, &N, &E, X); }

edge(A) ::= CENTER(A).
edge(A) ::= EDGEPT(A).
edge(A) ::= TOP(A).
edge(A) ::= BOTTOM(A).
edge(A) ::= START(A).
edge(A) ::= END(A).
edge(A) ::= RIGHT(A).
edge(A) ::= LEFT(A).

object(A) ::= objectname(A).
object(A) ::= nth(N).                     { A = pik_find_nth(p, null, &N); }
object(A) ::= nth(N) OF|IN object(B).     { A = pik_find_nth(p, B, &N); }

objectname(A) ::= THIS.                   { A = p.cur; }
objectname(A) ::= PLACENAME(N).           { A = pik_find_byname(p, null, &N); }
objectname(A) ::= objectname(B) DOT_U PLACENAME(N).
                                          { A = pik_find_byname(p, B, &N); }

nth(A) ::= NTH(N) CLASSNAME(ID).      { A = ID; A.eCode = pik_nth_value(p, &N); }
nth(A) ::= NTH(N) LAST CLASSNAME(ID). { A = ID; A.eCode = -pik_nth_value(p, &N); }
nth(A) ::= LAST CLASSNAME(ID).        { A = ID; A.eCode = -1; }
nth(A) ::= LAST(ID).                  { A = ID; A.eCode = -1; }
nth(A) ::= NTH(N) LB(ID) RB.          { A = ID; A.eCode = pik_nth_value(p, &N); }
nth(A) ::= NTH(N) LAST LB(ID) RB.     { A = ID; A.eCode = -pik_nth_value(p, &N); }
nth(A) ::= LAST LB(ID) RB.            { A = ID; A.eCode = -1; }

expr(A) ::= expr(X) PLUS expr(Y).                 { A = X + Y; }
expr(A) ::= expr(X) MINUS expr(Y).                { A = X - Y; }
expr(A) ::= expr(X) STAR expr(Y).                 { A = X * Y; }
expr(A) ::= expr(X) SLASH(E) expr(Y).             {
  if (Y == 0.0) { pik_error(p, &E, "division by zero"); A = 0.0; }
  else { A = X / Y; }
}
expr(A) ::= MINUS expr(X). [UMINUS]               { A = -X; }
expr(A) ::= PLUS expr(X). [UMINUS]                { A = X; }
expr(A) ::= LP expr(X) RP.                        { A = X; }
expr(A) ::= LP FILL|COLOR|TEXTCOLOR|THICKNESS(X) RP. { A = pik_get_var(p, &X); }
expr(A) ::= NUMBER(N).                            { A = pik_atof(&N); }
expr(A) ::= ID(N).                                { A = pik_get_var(p, &N); }
expr(A) ::= FUNC1(F) LP expr(X) RP.               { A = pik_func(p, &F, X, 0.0); }
expr(A) ::= FUNC2(F) LP expr(X) COMMA expr(Y) RP. { A = pik_func(p, &F, X, Y); }
expr(A) ::= DIST LP position(X) COMMA position(Y) RP. { A = pik_dist(&X, &Y); }
expr(A) ::= place2(B) DOT_XY X.                   { A = B.x; }
expr(A) ::= place2(B) DOT_XY Y.                   { A = B.y; }
expr(A) ::= object(B) DOT_L numproperty(P).       { A = pik_property_of(B, &P); }
expr(A) ::= object(B) DOT_L dashproperty(P).      { A = pik_property_of(B, &P); }
expr(A) ::= object(B) DOT_L colorproperty(P).     { A = pik_property_of(B, &P); }

%code {

fn tokenInner(t: *const PToken) []const u8 {
    if (t.n < 2) return "";
    return t.z[1 .. t.n - 1];
}

const Builtin = struct {
    zName: []const u8,
    val: PNum,
};

// Built-in variable names.
//
// This array is constant.  When a script changes the value of one of
// these built-ins, a new PVar record is added at the head of
// the Pik.pVar list, which is searched first.  Thus the new PVar entry
// will override this default value.
//
// Units are in inches, except for "color" and "fill" which are
// interpreted as 24-bit RGB values.
const aBuiltin = [_]Builtin{
    .{ .zName = "arcrad", .val = 0.25 },
    .{ .zName = "arrowhead", .val = 2.0 },
    .{ .zName = "arrowht", .val = 0.08 },
    .{ .zName = "arrowwid", .val = 0.06 },
    .{ .zName = "boxht", .val = 0.5 },
    .{ .zName = "boxrad", .val = 0.0 },
    .{ .zName = "boxwid", .val = 0.75 },
    .{ .zName = "charht", .val = 0.14 },
    .{ .zName = "charwid", .val = 0.08 },
    .{ .zName = "circlerad", .val = 0.25 },
    .{ .zName = "color", .val = 0.0 },
    .{ .zName = "cylht", .val = 0.5 },
    .{ .zName = "cylrad", .val = 0.075 },
    .{ .zName = "cylwid", .val = 0.75 },
    .{ .zName = "dashwid", .val = 0.05 },
    .{ .zName = "diamondht", .val = 0.75 },
    .{ .zName = "diamondwid", .val = 1.0 },
    .{ .zName = "dotrad", .val = 0.015 },
    .{ .zName = "ellipseht", .val = 0.5 },
    .{ .zName = "ellipsewid", .val = 0.75 },
    .{ .zName = "fileht", .val = 0.75 },
    .{ .zName = "filerad", .val = 0.15 },
    .{ .zName = "filewid", .val = 0.5 },
    .{ .zName = "fill", .val = -1.0 },
    .{ .zName = "lineht", .val = 0.5 },
    .{ .zName = "linewid", .val = 0.5 },
    .{ .zName = "movewid", .val = 0.5 },
    .{ .zName = "ovalht", .val = 0.5 },
    .{ .zName = "ovalwid", .val = 1.0 },
    .{ .zName = "scale", .val = 1.0 },
    .{ .zName = "textcolor", .val = 0.0 },
    .{ .zName = "textht", .val = 0.5 },
    .{ .zName = "textwid", .val = 0.75 },
    .{ .zName = "thickness", .val = 0.015 },
};

const Color = struct {
    zName: []const u8,
    val: i32,
};

// Chart of CSS color names.  Two new names "None" and "Off" are
// added with a value of -1.
const aColor = [_]Color{
    .{ .zName = "Black", .val = 0x000000 },
    .{ .zName = "Blue", .val = 0x0000ff },
    .{ .zName = "Green", .val = 0x008000 },
    .{ .zName = "None", .val = -1 },
    .{ .zName = "Off", .val = -1 },
    .{ .zName = "Red", .val = 0xff0000 },
    .{ .zName = "White", .val = 0xffffff },
};

fn classToken(name: []const u8) PToken {
    return .{ .z = name, .n = name.len };
}

fn nullRender(p: *Pik, obj: *PObj) void {
    _ = p;
    _ = obj;
}

fn arcInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "arcrad", null);
    obj.h = obj.w;
}

fn arrowInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "linewid", null);
    obj.h = pik_value(p, "lineht", null);
    obj.rad = pik_value(p, "linerad", null);
    obj.rarrow = 1;
}

fn boxInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "boxwid", null);
    obj.h = pik_value(p, "boxht", null);
    obj.rad = pik_value(p, "boxrad", null);
}

fn boxOffset(p: *Pik, obj: *PObj, cp: i32) PPoint {
    _ = p;
    var pt = cZeroPoint;
    const w2 = 0.5 * obj.w;
    const h2 = 0.5 * obj.h;
    var rad = obj.rad;
    const rx = blk: {
        if (rad <= 0.0) break :blk 0.0;
        if (rad > w2) rad = w2;
        if (rad > h2) rad = h2;
        break :blk 0.29289321881345252392 * rad;
    };
    switch (cp) {
        CP_C => {},
        CP_N => pt = .{ .x = 0.0, .y = h2 },
        CP_NE => pt = .{ .x = w2 - rx, .y = h2 - rx },
        CP_E => pt = .{ .x = w2, .y = 0.0 },
        CP_SE => pt = .{ .x = w2 - rx, .y = rx - h2 },
        CP_S => pt = .{ .x = 0.0, .y = -h2 },
        CP_SW => pt = .{ .x = rx - w2, .y = rx - h2 },
        CP_W => pt = .{ .x = -w2, .y = 0.0 },
        CP_NW => pt = .{ .x = rx - w2, .y = h2 - rx },
        else => {},
    }
    return pt;
}

fn boxChop(p: *Pik, obj: *PObj, pt: *PPoint) PPoint {
    var cp: i32 = CP_C;
    var chop = obj.ptAt;
    if (obj.w <= 0.0 or obj.h <= 0.0) return chop;
    const dx = (pt.x - obj.ptAt.x) * obj.h / obj.w;
    const dy = pt.y - obj.ptAt.y;
    if (dx > 0.0) {
        if (dy >= 2.414 * dx) cp = CP_N
        else if (dy >= 0.414 * dx) cp = CP_NE
        else if (dy >= -0.414 * dx) cp = CP_E
        else if (dy > -2.414 * dx) cp = CP_SE
        else cp = CP_S;
    } else {
        if (dy >= -2.414 * dx) cp = CP_N
        else if (dy >= -0.414 * dx) cp = CP_NW
        else if (dy >= 0.414 * dx) cp = CP_W
        else if (dy > 2.414 * dx) cp = CP_SW
        else cp = CP_S;
    }
    chop = obj.type.?.xOffset.?(p, obj, cp);
    chop.x += obj.ptAt.x;
    chop.y += obj.ptAt.y;
    return chop;
}

fn boxFit(p: *Pik, obj: *PObj, w: PNum, h: PNum) void {
    _ = p;
    if (w > 0) obj.w = w;
    if (h > 0) obj.h = h;
}

fn circleInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "circlerad", null) * 2;
    obj.h = obj.w;
    obj.rad = 0.5 * obj.w;
}

fn circleNumProp(p: *Pik, obj: *PObj, id: *PToken) void {
    _ = p;
    const name = id.z[0..id.n];
    if (std.mem.eql(u8, name, "diameter") or std.mem.eql(u8, name, "radius")) {
        obj.w = 2.0 * obj.rad;
        obj.h = obj.w;
    } else if (std.mem.eql(u8, name, "width")) {
        obj.h = obj.w;
        obj.rad = 0.5 * obj.w;
    } else if (std.mem.eql(u8, name, "height")) {
        obj.w = obj.h;
        obj.rad = 0.5 * obj.w;
    }
}

fn circleChop(p: *Pik, obj: *PObj, pt: *PPoint) PPoint {
    _ = p;
    const dx = pt.x - obj.ptAt.x;
    const dy = pt.y - obj.ptAt.y;
    const dist = std.math.hypot(dx, dy);
    if (dist < obj.rad or dist <= 0) return obj.ptAt;
    return .{ .x = obj.ptAt.x + dx * obj.rad / dist, .y = obj.ptAt.y + dy * obj.rad / dist };
}

fn circleFit(p: *Pik, obj: *PObj, w: PNum, h: PNum) void {
    _ = p;
    var mx: PNum = 0.0;
    if (w > 0) mx = w;
    if (h > mx) mx = h;
    if (w * h > 0 and (w * w + h * h) > mx * mx) mx = std.math.hypot(w, h);
    if (mx > 0.0) {
        obj.rad = 0.5 * mx;
        obj.w = mx;
        obj.h = mx;
    }
}

fn cylinderInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "cylwid", null);
    obj.h = pik_value(p, "cylht", null);
    obj.rad = pik_value(p, "cylrad", null);
}

fn cylinderFit(p: *Pik, obj: *PObj, w: PNum, h: PNum) void {
    _ = p;
    if (w > 0) obj.w = w;
    if (h > 0) obj.h = h + 0.25 * obj.rad + obj.sw;
}

fn dotInit(p: *Pik, obj: *PObj) void {
    obj.rad = pik_value(p, "dotrad", null);
    obj.h = obj.rad * 6;
    obj.w = obj.h;
    obj.fill = obj.color;
}

fn dotNumProp(p: *Pik, obj: *PObj, id: *PToken) void {
    _ = p;
    const name = id.z[0..id.n];
    if (std.mem.eql(u8, name, "color")) obj.fill = obj.color;
    if (std.mem.eql(u8, name, "fill")) obj.color = obj.fill;
}

fn dotCheck(p: *Pik, obj: *PObj) void {
    _ = p;
    obj.w = 0;
    obj.h = 0;
    pik_bbox_addellipse(&obj.bbox, obj.ptAt.x, obj.ptAt.y, obj.rad, obj.rad);
}

fn dotOffset(p: *Pik, obj: *PObj, cp: i32) PPoint {
    _ = p;
    _ = obj;
    _ = cp;
    return cZeroPoint;
}

fn diamondInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "diamondwid", null);
    obj.h = pik_value(p, "diamondht", null);
    obj.bAltAutoFit = 1;
}

fn ellipseInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "ellipsewid", null);
    obj.h = pik_value(p, "ellipseht", null);
}

fn lineInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "linewid", null);
    obj.h = pik_value(p, "lineht", null);
    obj.rad = pik_value(p, "linerad", null);
}

fn moveInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "movewid", null);
    obj.h = obj.w;
    obj.fill = -1.0;
    obj.color = -1.0;
    obj.sw = -1.0;
}

fn ovalInit(p: *Pik, obj: *PObj) void {
    obj.h = pik_value(p, "ovalht", null);
    obj.w = pik_value(p, "ovalwid", null);
    obj.rad = 0.5 * @min(obj.h, obj.w);
}

fn ovalNumProp(p: *Pik, obj: *PObj, id: *PToken) void {
    _ = p;
    _ = id;
    obj.rad = 0.5 * @min(obj.h, obj.w);
}

fn splineInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "linewid", null);
    obj.h = pik_value(p, "lineht", null);
    obj.rad = 1000;
}

fn textInit(p: *Pik, obj: *PObj) void {
    _ = pik_value(p, "textwid", null);
    _ = pik_value(p, "textht", null);
    obj.sw = 0.0;
}

fn sublistInit(p: *Pik, obj: *PObj) void {
    _ = p;
    const list = obj.pSublist orelse return;
    pik_bbox_init(&obj.bbox);
    for (list.a[0..list.n]) |child| pik_bbox_addbox(&obj.bbox, &child.bbox);
    obj.w = obj.bbox.ne.x - obj.bbox.sw.x;
    obj.h = obj.bbox.ne.y - obj.bbox.sw.y;
    obj.ptAt.x = 0.5 * (obj.bbox.ne.x + obj.bbox.sw.x);
    obj.ptAt.y = 0.5 * (obj.bbox.ne.y + obj.bbox.sw.y);
    obj.mCalc |= A_WIDTH | A_HEIGHT | A_RADIUS;
}

const sublistClass = PClass{
    .zName = "[]",
    .isLine = 0,
    .eJust = 0,
    .xInit = sublistInit,
    .xNumProp = null,
    .xCheck = null,
    .xChop = null,
    .xOffset = boxOffset,
    .xFit = null,
    .xRender = null,
};

const noopClass = PClass{
    .zName = "noop",
    .isLine = 0,
    .eJust = 0,
    .xInit = null,
    .xNumProp = null,
    .xCheck = null,
    .xChop = null,
    .xOffset = boxOffset,
    .xFit = null,
    .xRender = null,
};

const aClass = [_]PClass{
    .{ .zName = "arc", .isLine = 1, .eJust = 0, .xInit = arcInit, .xNumProp = null, .xCheck = null, .xChop = null, .xOffset = boxOffset, .xFit = null, .xRender = nullRender },
    .{ .zName = "arrow", .isLine = 1, .eJust = 0, .xInit = arrowInit, .xNumProp = null, .xCheck = null, .xChop = null, .xOffset = boxOffset, .xFit = null, .xRender = nullRender },
    .{ .zName = "box", .isLine = 0, .eJust = 1, .xInit = boxInit, .xNumProp = null, .xCheck = null, .xChop = boxChop, .xOffset = boxOffset, .xFit = boxFit, .xRender = nullRender },
    .{ .zName = "circle", .isLine = 0, .eJust = 0, .xInit = circleInit, .xNumProp = circleNumProp, .xCheck = null, .xChop = circleChop, .xOffset = boxOffset, .xFit = circleFit, .xRender = nullRender },
    .{ .zName = "cylinder", .isLine = 0, .eJust = 1, .xInit = cylinderInit, .xNumProp = null, .xCheck = null, .xChop = boxChop, .xOffset = boxOffset, .xFit = cylinderFit, .xRender = nullRender },
    .{ .zName = "diamond", .isLine = 0, .eJust = 0, .xInit = diamondInit, .xNumProp = null, .xCheck = null, .xChop = boxChop, .xOffset = boxOffset, .xFit = boxFit, .xRender = nullRender },
    .{ .zName = "dot", .isLine = 0, .eJust = 0, .xInit = dotInit, .xNumProp = dotNumProp, .xCheck = dotCheck, .xChop = circleChop, .xOffset = dotOffset, .xFit = null, .xRender = nullRender },
    .{ .zName = "ellipse", .isLine = 0, .eJust = 0, .xInit = ellipseInit, .xNumProp = null, .xCheck = null, .xChop = circleChop, .xOffset = boxOffset, .xFit = boxFit, .xRender = nullRender },
    .{ .zName = "file", .isLine = 0, .eJust = 1, .xInit = boxInit, .xNumProp = null, .xCheck = null, .xChop = boxChop, .xOffset = boxOffset, .xFit = boxFit, .xRender = nullRender },
    .{ .zName = "line", .isLine = 1, .eJust = 0, .xInit = lineInit, .xNumProp = null, .xCheck = null, .xChop = null, .xOffset = boxOffset, .xFit = null, .xRender = nullRender },
    .{ .zName = "move", .isLine = 1, .eJust = 0, .xInit = moveInit, .xNumProp = null, .xCheck = null, .xChop = null, .xOffset = boxOffset, .xFit = null, .xRender = nullRender },
    .{ .zName = "oval", .isLine = 0, .eJust = 1, .xInit = ovalInit, .xNumProp = ovalNumProp, .xCheck = null, .xChop = boxChop, .xOffset = boxOffset, .xFit = boxFit, .xRender = nullRender },
    .{ .zName = "spline", .isLine = 1, .eJust = 0, .xInit = splineInit, .xNumProp = null, .xCheck = null, .xChop = null, .xOffset = boxOffset, .xFit = null, .xRender = nullRender },
    .{ .zName = "text", .isLine = 0, .eJust = 0, .xInit = textInit, .xNumProp = null, .xCheck = null, .xChop = boxChop, .xOffset = boxOffset, .xFit = boxFit, .xRender = nullRender },
};

fn pik_find_class(id: *PToken) ?*const PClass {
    for (&aClass) |*class| {
        if (std.mem.eql(u8, class.zName, id.z[0..id.n])) return class;
    }
    return null;
}

fn pik_compute_layout_settings(p: *Pik) void {
    if (p.bLayoutVars != 0) return;
    var thickness = pik_value(p, "thickness", null);
    if (thickness <= 0.01) thickness = 0.01;
    const w_arrow = 0.5 * pik_value(p, "arrowwid", null);
    p.wArrow = w_arrow / thickness;
    p.hArrow = pik_value(p, "arrowht", null) / thickness;
    p.fontScale = pik_value(p, "fontscale", null);
    if (p.fontScale <= 0.0) p.fontScale = 1.0;
    p.rScale = 144.0;
    p.charWidth = pik_value(p, "charwid", null) * p.fontScale;
    p.charHeight = pik_value(p, "charht", null) * p.fontScale;
    p.bLayoutVars = 1;
}

fn pik_bbox_add_elist(p: *Pik, list: *PList, w_arrow: PNum) void {
    _ = w_arrow;
    for (list.a[0..list.n]) |obj| {
        if (obj.type) |class| if (class.xCheck) |x| x(p, obj);
        if (pik_bbox_isempty(&obj.bbox)) {
            pik_bbox_add_xy(&obj.bbox, obj.ptAt.x - 0.5 * obj.w, obj.ptAt.y - 0.5 * obj.h);
            pik_bbox_add_xy(&obj.bbox, obj.ptAt.x + 0.5 * obj.w, obj.ptAt.y + 0.5 * obj.h);
        }
        pik_bbox_addbox(&p.bbox, &obj.bbox);
    }
}

fn pik_elem_render(p: *Pik, obj: *PObj) void {
    if (obj.type) |class| {
        if (class.xRender) |x| x(p, obj);
    }
}

fn pik_elist_render(p: *Pik, list: *PList) void {
    for (list.a[0..list.n]) |obj| pik_elem_render(p, obj);
}

fn pik_render(p: *Pik, list: ?*PList) void {
    const l = list orelse return;
    defer {
        pik_elist_free(p, l);
        if (p.list == l) p.list = null;
    }
    if (p.nErr != 0) {
        p.wSVG = -1;
        p.hSVG = -1;
        return;
    }
    pik_compute_layout_settings(p);
    var thickness = pik_value(p, "thickness", null);
    if (thickness <= 0.01) thickness = 0.01;
    var margin = pik_value(p, "margin", null);
    margin += thickness;
    const w_arrow = p.wArrow * thickness;
    pik_bbox_init(&p.bbox);
    pik_bbox_add_elist(p, l, w_arrow);
    p.bbox.ne.x += margin + pik_value(p, "rightmargin", null);
    p.bbox.ne.y += margin + pik_value(p, "topmargin", null);
    p.bbox.sw.x -= margin + pik_value(p, "leftmargin", null);
    p.bbox.sw.y -= margin + pik_value(p, "bottommargin", null);
    const w = p.bbox.ne.x - p.bbox.sw.x;
    const h = p.bbox.ne.y - p.bbox.sw.y;
    p.wSVG = pik_round(p.rScale * w);
    p.hSVG = pik_round(p.rScale * h);
    pik_append(p, "<svg xmlns='http://www.w3.org/2000/svg' style='font-size:initial;'");
    if (p.zClass) |class| {
        pik_append(p, " class=\"");
        pik_append_text(p, class, 4);
        pik_append(p, "\" id=\"");
        pik_append_text(p, class, 4);
        pik_append(p, "\"");
    } else {
        pik_append(p, " id=\"id-pikchr\"");
    }
    pik_append(p, " role=\"img\"");
    pik_append_num(p, " width=\"", p.wSVG);
    pik_append_num(p, "\" height=\"", p.hSVG);
    pik_append(p, "\"");
    pik_append_num(p, " viewBox=\"0 0 ", w);
    pik_append_num(p, " ", h);
    pik_append(p, "\">\n");
    if (p.zTitle) |title| {
        if (p.bLabel == 0) {
            pik_append(p, "<title>");
            pik_append_text(p, title, 2);
            pik_append(p, "</title>\n");
        }
    }
    if (p.zDesc) |desc| {
        pik_append(p, "<desc>");
        pik_append_text(p, desc, 2);
        pik_append(p, "</desc>\n");
    }
    pik_elist_render(p, l);
    pik_append(p, "</svg>\n");
}

fn pik_elist_append(p: *Pik, list: ?*PList, obj: ?*PObj) ?*PList {
    const o = obj orelse return list;
    const l = list orelse p.allocator.create(PList) catch {
        pik_error(p, null, null);
        return null;
    };
    if (list == null) l.* = .{};
    if (l.n >= l.nAlloc) {
        const n_new = (l.n + 5) * 2;
        l.a = p.allocator.realloc(l.a, n_new) catch {
            pik_error(p, null, null);
            pik_elem_free(p, o);
            return l;
        };
        l.nAlloc = n_new;
    }
    l.a[l.n] = o;
    l.n += 1;
    p.list = l;
    return l;
}

fn pik_elem_new(p: *Pik, id: ?*PToken, str: ?*PToken, sublist: ?*PList) ?*PObj {
    if (p.nErr != 0) return null;
    const obj = p.allocator.create(PObj) catch {
        pik_error(p, null, null);
        pik_elist_free(p, sublist);
        return null;
    };
    obj.* = .{};
    p.nTPath = 1;
    p.thenFlag = 0;
    if (p.list == null or p.list.?.n == 0) {
        obj.ptAt = cZeroPoint;
        obj.eWith = CP_C;
    } else {
        const prior = p.list.?.a[p.list.?.n - 1];
        obj.ptAt = prior.ptExit;
        obj.eWith = switch (p.eDir) {
            DIR_LEFT => CP_E,
            DIR_UP => CP_S,
            DIR_DOWN => CP_N,
            else => CP_W,
        };
    }
    p.aTPath[0] = obj.ptAt;
    obj.with = obj.ptAt;
    obj.outDir = p.eDir;
    obj.inDir = p.eDir;
    obj.pSublist = sublist;
    var miss: i32 = 0;
    obj.iLayer = @intCast(pik_round(pik_value(p, "layer", &miss)));
    if (miss != 0) obj.iLayer = 1000;
    if (obj.iLayer < 0) obj.iLayer = 0;
    if (sublist != null) {
        obj.type = &sublistClass;
        sublistClass.xInit.?(p, obj);
        p.cur = obj;
        return obj;
    }
    if (str) |s| {
        var n = classToken("text");
        obj.type = pik_find_class(&n).?;
        obj.errTok = s.*;
        obj.type.?.xInit.?(p, obj);
        pik_add_txt(p, s, s.eCode);
        p.cur = obj;
        return obj;
    }
    if (id) |i| {
        obj.errTok = i.*;
        if (pik_find_class(i)) |class| {
            obj.type = class;
            obj.sw = pik_value(p, "thickness", null);
            obj.fill = pik_value(p, "fill", null);
            obj.color = pik_value(p, "color", null);
            obj.textcolor = pik_value(p, "textcolor", null);
            if (class.xInit) |initFn| initFn(p, obj);
            p.cur = obj;
            return obj;
        }
        pik_error(p, i, "unknown object type");
        pik_elem_free(p, obj);
        return null;
    }
    obj.type = &noopClass;
    obj.ptEnter = obj.ptAt;
    obj.ptExit = obj.ptAt;
    p.cur = obj;
    return obj;
}

fn pik_set_title(p: *Pik, title: *PToken, label: i32) void {
    if (p.zTitle) |old| p.allocator.free(old);
    p.zTitle = p.allocator.dupe(u8, tokenInner(title)) catch {
        pik_error(p, title, null);
        return;
    };
    p.bLabel = if (label != 0) 1 else 0;
}

fn pik_set_description(p: *Pik, desc: *PToken) void {
    if (p.zDesc) |old| p.allocator.free(old);
    p.zDesc = p.allocator.dupe(u8, tokenInner(desc)) catch {
        pik_error(p, desc, null);
        return;
    };
}

fn pik_set_direction(p: *Pik, dir: i16) void {
    if (ValidDir(dir)) p.eDir = @intCast(dir);
}

fn pik_elem_setname(p: *Pik, obj: ?*PObj, name: *PToken) void {
    const o = obj orelse return;
    if (o.zName) |old| p.allocator.free(old);
    o.zName = p.allocator.dupe(u8, name.z[0..name.n]) catch {
        pik_error(p, name, null);
        return;
    };
}

fn pik_set_var(p: *Pik, id: *PToken, val: PNum, op: *PToken) void {
    var found = p.pVar;
    while (found) |v| : (found = v.pNext) {
        if (pik_token_eq(id, v.zName) == 0) {
            const old_val = v.val;
            switch (op.eCode) {
                else => v.val = val,
            }
            if (std.mem.eql(u8, v.zName, "color")) pik_sync_textcolor(p, old_val, v.val);
            p.bLayoutVars = 0;
            return;
        }
    }
    const v = p.allocator.create(PVar) catch {
        pik_error(p, id, null);
        return;
    };
    const name = p.allocator.dupe(u8, id.z[0..id.n]) catch {
        p.allocator.destroy(v);
        pik_error(p, id, null);
        return;
    };
    v.* = .{
        .zName = name,
        .val = pik_value(p, id.z[0..id.n], null),
        .pNext = p.pVar,
    };
    p.pVar = v;
    const old_val = v.val;
    switch (op.eCode) {
        else => v.val = val,
    }
    if (std.mem.eql(u8, v.zName, "color")) pik_sync_textcolor(p, old_val, v.val);
    p.bLayoutVars = 0;
}

fn pik_sync_textcolor(p: *Pik, old_val: PNum, new_val: PNum) void {
    var textcolor = p.pVar;
    while (textcolor) |v| : (textcolor = v.pNext) {
        if (std.mem.eql(u8, v.zName, "textcolor")) {
            if (v.val == old_val) v.val = new_val;
            return;
        }
    }
    const v = p.allocator.create(PVar) catch {
        pik_error(p, null, null);
        return;
    };
    const name = p.allocator.dupe(u8, "textcolor") catch {
        p.allocator.destroy(v);
        pik_error(p, null, null);
        return;
    };
    v.* = .{ .zName = name, .val = new_val, .pNext = p.pVar };
    p.pVar = v;
}

fn pik_round(v: PNum) i32 {
    if (std.math.isNan(v)) return 0;
    if (v < -2147483647) return -2147483648;
    if (v >= 2147483647) return 2147483647;
    return @intFromFloat(v);
}

fn pik_value(p: *Pik, z: []const u8, miss: ?*i32) PNum {
    var v = p.pVar;
    while (v) |vv| : (v = vv.pNext) {
        if (std.mem.eql(u8, vv.zName, z)) {
            if (miss) |m| m.* = 0;
            return vv.val;
        }
    }
    for (aBuiltin) |bi| {
        if (std.mem.eql(u8, bi.zName, z)) {
            if (miss) |m| m.* = 0;
            return bi.val;
        }
    }
    if (std.mem.eql(u8, z, "nTokens")) {
        if (miss) |m| m.* = 0;
        return @floatFromInt(p.nToken);
    }
    if (miss) |m| m.* = 1;
    return 0.0;
}

fn pik_lookup_color(p: ?*Pik, id: *PToken) PNum {
    for (aColor) |color| {
        if (std.ascii.eqlIgnoreCase(id.z[0..id.n], color.zName)) {
            return @floatFromInt(color.val);
        }
    }
    if (p) |pp| pik_error(pp, id, "not a known color name");
    return -99.0;
}

fn pik_get_var(p: *Pik, id: *PToken) PNum {
    var miss: i32 = 0;
    const v = pik_value(p, id.z[0..id.n], &miss);
    if (miss == 0) return v;
    const c = pik_lookup_color(null, id);
    if (c > -90.0) return c;
    pik_error(p, id, "no such variable");
    return 0.0;
}

fn pik_atof(t: *PToken) PNum {
    const text = t.z[0..t.n];
    if (text.len >= 3 and text[0] == '0' and (text[1] == 'x' or text[1] == 'X')) {
        return @floatFromInt(std.fmt.parseInt(i64, text[2..], 16) catch 0);
    }
    var num_end: usize = 0;
    while (num_end < text.len) : (num_end += 1) {
        const c = text[num_end];
        if (!(std.ascii.isDigit(c) or c == '+' or c == '-' or c == '.' or c == 'e' or c == 'E')) break;
    }
    var ans = std.fmt.parseFloat(PNum, text[0..num_end]) catch 0.0;
    if (text.len - num_end == 2) {
        const unit = text[num_end..];
        if (std.mem.eql(u8, unit, "cm")) ans /= 2.54
        else if (std.mem.eql(u8, unit, "mm")) ans /= 25.4
        else if (std.mem.eql(u8, unit, "px")) ans /= 96
        else if (std.mem.eql(u8, unit, "pt")) ans /= 72
        else if (std.mem.eql(u8, unit, "pc")) ans /= 6;
    }
    return ans;
}

fn pik_append(p: *Pik, text: []const u8) void {
    p.zOut.writer.writeAll(text) catch pik_error(p, null, null);
}

fn pik_isentity(text: []const u8) bool {
    if (text.len < 4 or text[0] != '&') return false;
    if (text[1] == '#') {
        var i: usize = 2;
        while (i < text.len) : (i += 1) {
            if (i > 3 and text[i] == ';') return true;
            if (!std.ascii.isDigit(text[i])) return false;
        }
    } else {
        var i: usize = 1;
        while (i < text.len) : (i += 1) {
            if (i > 2 and text[i] == ';') return true;
            if (i > 1 and std.ascii.isDigit(text[i])) continue;
            if (!std.ascii.isAlphabetic(text[i])) return false;
        }
    }
    return false;
}

fn pik_append_text(p: *Pik, text: []const u8, flags: i32) void {
    const b_q_space = (flags & 1) != 0;
    const b_q_amp = (flags & 2) != 0;
    const b_q_attr = (flags & 4) != 0;
    var rest = text;
    while (rest.len > 0) {
        var i: usize = 0;
        while (i < rest.len) : (i += 1) {
            const c = rest[i];
            if (c == '<' or c == '>') break;
            if (c == ' ' and b_q_space) break;
            if (c == '&' and b_q_amp) break;
            if (c == '"' and b_q_attr) break;
            if (c == '\n' and b_q_attr) break;
        }
        if (i != 0) pik_append(p, rest[0..i]);
        if (i == rest.len) break;
        switch (rest[i]) {
            '<' => pik_append(p, "&lt;"),
            '>' => pik_append(p, "&gt;"),
            ' ' => pik_append(p, "\xc2\xa0"),
            '\n' => pik_append(p, " "),
            '"' => pik_append(p, "&quot;"),
            '&' => {
                if (pik_isentity(rest[i..])) pik_append(p, "&") else pik_append(p, "&amp;");
            },
            else => {},
        }
        rest = rest[i + 1 ..];
    }
}

fn pik_append_num(p: *Pik, prefix: []const u8, v: PNum) void {
    pik_append(p, prefix);
    p.zOut.writer.print("{d}", .{v}) catch pik_error(p, null, null);
}

fn pik_after_adding_attributes(p: *Pik, obj: ?*PObj) void {
    _ = p;
    _ = obj;
}

fn hasKind(tok: *const PToken, kind: TokenKind) bool {
    return tok.eType == @intFromEnum(kind);
}

fn pik_set_numprop(p: *Pik, prop: *PToken, val: *PRel) void {
    const obj = p.cur orelse return;
    var target: *PNum = undefined;
    var mask: u32 = 0;
    if (hasKind(prop, .WIDTH)) {
        target = &obj.w;
        mask = A_WIDTH;
    } else if (hasKind(prop, .HEIGHT)) {
        target = &obj.h;
        mask = A_HEIGHT;
    } else if (hasKind(prop, .RADIUS)) {
        target = &obj.rad;
        mask = A_RADIUS;
    } else if (hasKind(prop, .DIAMETER)) {
        target = &obj.rad;
        mask = A_RADIUS;
        val.rAbs *= 0.5;
        val.rRel *= 0.5;
    } else if (hasKind(prop, .THICKNESS)) {
        target = &obj.sw;
        mask = A_THICKNESS;
    } else {
        return;
    }
    if ((obj.mProp & mask) != 0) {
        pik_error(p, prop, "value already set");
        return;
    }
    target.* = val.rAbs + target.* * val.rRel;
    obj.mProp |= mask;
    if (obj.type) |class| if (class.xNumProp) |x| x(p, obj, prop);
}

fn pik_set_clrprop(p: *Pik, prop: *PToken, val: PNum) void {
    const obj = p.cur orelse return;
    if (hasKind(prop, .FILL)) {
        if ((obj.mProp & A_FILL) != 0) {
            pik_error(p, prop, "value already set");
            return;
        }
        obj.fill = val;
        obj.mProp |= A_FILL;
    } else if (hasKind(prop, .COLOR)) {
        if ((obj.mProp & A_COLOR) != 0) {
            pik_error(p, prop, "value already set");
            return;
        }
        obj.color = val;
        obj.mProp |= A_COLOR;
    } else if (hasKind(prop, .TEXTCOLOR)) {
        if ((obj.mProp & A_TEXTCOLOR) != 0) {
            pik_error(p, prop, "value already set");
            return;
        }
        obj.textcolor = val;
        obj.mProp |= A_TEXTCOLOR;
    }
    if (obj.type) |class| if (class.xNumProp) |x| x(p, obj, prop);
}

fn pik_set_dashed(p: *Pik, prop: *PToken, val: ?*PNum) void {
    const obj = p.cur orelse return;
    if ((obj.mProp & A_DASHED) != 0) {
        pik_error(p, prop, "value already set");
        return;
    }
    const x = if (val) |v| v.* else pik_value(p, "dashwid", null);
    if (hasKind(prop, .DOTTED)) obj.dotted = x else obj.dashed = x;
    obj.mProp |= A_DASHED;
}

fn pik_add_direction(p: *Pik, dir: ?*PToken, val: *PRel) void {
    _ = dir;
    _ = val;
    p.thenFlag = 0;
}

fn pik_evenwith(p: *Pik, dir: *PToken, place: *PPoint) void {
    _ = p;
    _ = dir;
    _ = place;
}

fn pik_set_xml_class(p: *Pik, tok: *PToken) void {
    _ = p;
    _ = tok;
}

fn pik_set_xml_classes(p: *Pik, tok: *PToken) void {
    _ = p;
    _ = tok;
}

fn pik_close_path(p: *Pik, err: *PToken) void {
    _ = err;
    if (p.cur) |obj| obj.bClose = 1;
}

fn pik_set_from(p: *Pik, obj: ?*PObj, tok: *PToken, pt: *PPoint) void {
    _ = p;
    _ = tok;
    if (obj) |o| o.ptEnter = pt.*;
}

fn pik_add_to(p: *Pik, obj: ?*PObj, tok: *PToken, pt: *PPoint) void {
    _ = p;
    _ = tok;
    if (obj) |o| o.ptExit = pt.*;
}

fn pik_then(p: *Pik, tok: *PToken, obj: ?*PObj) void {
    _ = tok;
    _ = obj;
    p.thenFlag = 1;
}

fn pik_move_hdg(
    p: *Pik,
    rel: *PRel,
    hdg: ?*PToken,
    angle: PNum,
    edge: ?*PToken,
    err: *PToken,
) void {
    _ = p;
    _ = rel;
    _ = hdg;
    _ = angle;
    _ = edge;
    _ = err;
}

fn pik_set_at(p: *Pik, edge: ?*PToken, at: *PPoint, err: *PToken) void {
    _ = edge;
    _ = err;
    if (p.cur) |obj| obj.ptAt = at.*;
}

fn pik_same(p: *Pik, other: ?*PObj, err: *PToken) void {
    _ = p;
    _ = other;
    _ = err;
}

fn pik_add_txt(p: *Pik, txt: *PToken, pos: i16) void {
    const obj = p.cur orelse return;
    if (obj.nTxt >= obj.aTxt.len) {
        pik_error(p, txt, "too many text values");
        return;
    }
    obj.aTxt[obj.nTxt] = txt.*;
    obj.aTxt[obj.nTxt].eCode = pos;
    obj.nTxt += 1;
}

fn pik_size_to_fit(p: *Pik, fit: *PToken, which: i32) void {
    _ = p;
    _ = fit;
    _ = which;
}

fn pik_behind(p: *Pik, other: ?*PObj) void {
    _ = p;
    _ = other;
}

fn pik_text_position(prev: i16, flag: *PToken) i32 {
    _ = flag;
    return prev;
}

fn pik_position_between(x: PNum, p1: PPoint, p2: PPoint) PPoint {
    return .{
        .x = p1.x + x * (p2.x - p1.x),
        .y = p1.y + x * (p2.y - p1.y),
    };
}

fn pik_position_at_angle(dist: PNum, r: PNum, pt: PPoint) PPoint {
    const a = std.math.degreesToRadians(r);
    return .{ .x = pt.x + dist * @sin(a), .y = pt.y + dist * @cos(a) };
}

fn pik_position_at_hdg(dist: PNum, d: *PToken, pt: PPoint) PPoint {
    return pik_position_at_angle(dist, d.eCode, pt);
}

fn pik_place_of_elem(p: *Pik, obj: ?*PObj, edge: ?*PToken) PPoint {
    _ = p;
    _ = edge;
    return if (obj) |o| o.ptAt else cZeroPoint;
}

fn pik_nth_vertex(p: *Pik, nth: *PToken, err: *PToken, obj: ?*PObj) PPoint {
    _ = p;
    _ = nth;
    _ = err;
    return if (obj) |o| o.ptAt else cZeroPoint;
}

fn pik_find_nth(p: *Pik, basis: ?*PObj, nth: *PToken) ?*PObj {
    _ = nth;
    if (basis) |b| return b;
    return p.cur;
}

fn pik_find_byname(p: *Pik, basis: ?*PObj, name: *PToken) ?*PObj {
    _ = basis;
    _ = name;
    return p.cur;
}

fn pik_nth_value(p: *Pik, nth: *PToken) i16 {
    var i: usize = 0;
    while (i < nth.n and std.ascii.isDigit(nth.z[i])) : (i += 1) {}
    var v: i32 = if (i == 0) 0 else std.fmt.parseInt(i32, nth.z[0..i], 10) catch 0;
    if (v > 1000) {
        pik_error(p, nth, "value too big - max '1000th'");
        v = 1;
    }
    if (v == 0 and pik_token_eq(nth, "first") == 0) v = 1;
    return @intCast(v);
}

fn pik_property_of(obj: ?*PObj, prop: *PToken) PNum {
    const o = obj orelse return 0.0;
    _ = prop;
    return o.w;
}

fn pik_func(p: *Pik, func: *PToken, x: PNum, y: PNum) PNum {
    _ = p;
    _ = func;
    _ = y;
    return x;
}

fn pik_dist(a: *PPoint, b: *PPoint) PNum {
    return std.math.hypot(a.x - b.x, a.y - b.y);
}

fn pik_bbox_isempty(box: *PBox) bool {
    return box.sw.x > box.ne.x;
}

fn pik_bbox_contains_point(box: *PBox, pt: *PPoint) bool {
    if (pik_bbox_isempty(box)) return false;
    if (pt.x < box.sw.x) return false;
    if (pt.x > box.ne.x) return false;
    if (pt.y < box.sw.y) return false;
    if (pt.y > box.ne.y) return false;
    return true;
}

fn pik_bbox_init(box: *PBox) void {
    box.sw.x = 1.0;
    box.sw.y = 1.0;
    box.ne.x = 0.0;
    box.ne.y = 0.0;
}

fn pik_bbox_addbox(a: *PBox, b: *PBox) void {
    if (pik_bbox_isempty(a)) a.* = b.*;
    if (pik_bbox_isempty(b)) return;
    if (a.sw.x > b.sw.x) a.sw.x = b.sw.x;
    if (a.sw.y > b.sw.y) a.sw.y = b.sw.y;
    if (a.ne.x < b.ne.x) a.ne.x = b.ne.x;
    if (a.ne.y < b.ne.y) a.ne.y = b.ne.y;
}

fn pik_bbox_add_xy(box: *PBox, x: PNum, y: PNum) void {
    if (pik_bbox_isempty(box)) {
        box.ne.x = x;
        box.ne.y = y;
        box.sw.x = x;
        box.sw.y = y;
        return;
    }
    if (box.sw.x > x) box.sw.x = x;
    if (box.sw.y > y) box.sw.y = y;
    if (box.ne.x < x) box.ne.x = x;
    if (box.ne.y < y) box.ne.y = y;
}

fn pik_bbox_addellipse(box: *PBox, x: PNum, y: PNum, rx: PNum, ry: PNum) void {
    if (pik_bbox_isempty(box)) {
        box.ne.x = x + rx;
        box.ne.y = y + ry;
        box.sw.x = x - rx;
        box.sw.y = y - ry;
        return;
    }
    if (box.sw.x > x - rx) box.sw.x = x - rx;
    if (box.sw.y > y - ry) box.sw.y = y - ry;
    if (box.ne.x < x + rx) box.ne.x = x + rx;
    if (box.ne.y < y + ry) box.ne.y = y + ry;
}

fn pik_assert(p: *Pik, e1: PNum, eq: *PToken, e2: PNum) ?*PObj {
    if (e1 != e2) pik_error(p, eq, "assertion failed");
    return null;
}

fn pik_position_assert(p: *Pik, e1: *PPoint, eq: *PToken, e2: *PPoint) ?*PObj {
    if (e1.x != e2.x or e1.y != e2.y) pik_error(p, eq, "assertion failed");
    return null;
}

fn pik_add_macro(p: *Pik, id: *PToken, code: *PToken) void {
    _ = p;
    _ = id;
    _ = code;
}

test "Pik parser module carries translated state" {
    var pik = Pik.init(std.testing.allocator, std.testing.io, "box", "pikchr", 0);
    defer pik.deinit();
    try std.testing.expectEqual(@as(u8, DIR_RIGHT), pik.eDir);
    try std.testing.expectEqualStrings("box", pik.sIn.z);
    try std.testing.expectEqualStrings("pikchr", pik.zClass.?);
    pik_append(&pik, "svg");
    try std.testing.expectEqualStrings("svg", pik.zOut.written());
}

test "Pik object allocation initializes class defaults" {
    var pik = Pik.init(std.testing.allocator, std.testing.io, "box", null, 0);
    defer pik.deinit();
    var tok = classToken("box");
    const obj = pik_elem_new(&pik, &tok, null, null).?;
    try std.testing.expectEqualStrings("box", obj.type.?.zName);
    try std.testing.expectEqual(@as(PNum, 0.75), obj.w);
    try std.testing.expectEqual(@as(PNum, 0.5), obj.h);
    _ = pik_elist_append(&pik, null, obj);
}

test "Pik render consumes object list into allocating writer" {
    var pik = Pik.init(std.testing.allocator, std.testing.io, "box", "pikchr", 0);
    defer pik.deinit();
    var tok = classToken("box");
    const obj = pik_elem_new(&pik, &tok, null, null).?;
    const list = pik_elist_append(&pik, null, obj);
    pik_render(&pik, list);
    try std.testing.expect(std.mem.startsWith(u8, pik.zOut.written(), "<svg "));
    try std.testing.expect(std.mem.endsWith(u8, pik.zOut.written(), "</svg>\n"));
    try std.testing.expect(pik.list == null);
}
}
