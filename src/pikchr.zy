// Reduce the length of the line segment by amt (if possible) by
// modifying the location of *t.
fn pik_chop(f: *PPoint, t: *PPoint, amt: PNum) void {
    const dx = t.x - f.x;
    const dy = t.y - f.y;
    const dist = std.math.hypot(dx, dy);
    var r: PNum = undefined;
    if (dist <= amt) {
        t.* = f.*;
        return;
    }
    r = 1.0 - amt / dist;
    t.x = f.x + r * dx;
    t.y = f.y + r * dy;
}

// Draw an arrowhead on the end of the line segment from pFrom to pTo.
// Also, shorten the line segment (by changing the value of pTo) so that
// the shaft of the arrow does not extend into the arrowhead.
fn pik_draw_arrowhead(p: *Pik, f: *PPoint, t: *PPoint, obj: *PObj) void {
    var dx = t.x - f.x;
    var dy = t.y - f.y;
    const dist = std.math.hypot(dx, dy);
    var h = p.hArrow * obj.sw;
    const w = p.wArrow * obj.sw;
    var e1: PNum = undefined;
    var ddx: PNum = undefined;
    var ddy: PNum = undefined;
    var bx: PNum = undefined;
    var by: PNum = undefined;
    if (obj.color < 0.0) return;
    if (obj.sw <= 0.0) return;
    if (dist <= 0.0) return; // Unable
    dx /= dist;
    dy /= dist;
    e1 = dist - h;
    if (e1 < 0.0) {
        e1 = 0.0;
        h = dist;
    }
    ddx = -w * dy;
    ddy = w * dx;
    bx = f.x + e1 * dx;
    by = f.y + e1 * dy;
    pik_append_tag_open(p, obj, "polygon");
    if (comptime pik_no_style) {
        if (obj.sw >= 0.0 and obj.color >= 0.0) {
            if (p.hStroke.get(obj.color)) |tag| {
                pik_append(p, " _s");
                pik_append_color_tag(p, tag);
            } else {
                pik_error(p, null, "internal error: missing generated color class");
                return;
            }
            if (p.hFgFill.get(obj.color)) |tag| {
                pik_append(p, " _f");
                pik_append_color_tag(p, tag);
            } else {
                pik_error(p, null, "internal error: missing generated color class");
                return;
            }
        }
    }
    pik_append(p, "\" ");
    pik_append_xy(p, "points=\"", t.x, t.y);
    pik_append_xy(p, " ", bx - ddx, by - ddy);
    pik_append_xy(p, " ", bx + ddx, by + ddy);
    if (comptime pik_no_style) {
        pik_append(p, "\" />\n");
    } else {
        pik_append_clr(p, "\" fill=\"", obj.color, "\" />\n", false);
    }
    pik_chop(f, t, h / 2.0);
}

// Make a group for the object if: we have a compound, and we didn't make
// a group with .id already.
// Returns a sentinel flag so we know whether to close a <g>:
//   - 0: no close (not compound)
//   - 1: close (group made here)
fn pik_append_group(p: *Pik, obj: *PObj) i32 {
    var needs_group: i32 = if (obj.zName.len == 0 and (obj.larrow != 0 or obj.rarrow != 0 or obj.pSublist != null)) 1 else 0;
    if (needs_group != 0) {
        needs_group = 1;
        pik_append_tag_open(p, obj, "g");
        pik_append(p, "\" ");
        pik_append(p, ">\n");
    }
    return needs_group;
}

// Methods for the "line" class
fn lineRender(p: *Pik, obj: *PObj) void {
    const enclosed = pik_append_group(p, obj);
    if (obj.sw > 0.0) {
        pik_append_tag_open(p, obj, "path");
        if ((obj.bClose != 0 and obj.fill < 0.0) or obj.bClose == 0) pik_append(p, " _T");
        if (obj.sw >= 0.0 and obj.color >= 0.0) {
            if (pik_style_stroke_map(p, obj, if (obj.bClose != 0) 3 else 0).get(obj.color)) |tag| {
                pik_append(p, " _s");
                pik_append_color_tag(p, tag);
            } else {
                pik_error(p, null, "internal error: missing generated color class");
                return;
            }
        }
        if (obj.bClose != 0 and obj.fill >= 0.0) {
            if (pik_style_fill_map(p, obj, if (obj.bClose != 0) 3 else 0).get(obj.fill)) |tag| {
                pik_append(p, " _f");
                pik_append_color_tag(p, tag);
            } else {
                pik_error(p, null, "internal error: missing generated color class");
                return;
            }
        }
        pik_append(p, "\" ");
        pik_append(p, "d=\"M");
        if (obj.nPath > 0 and obj.aPath.len > 0) {
            const n: usize = @min(@as(usize, @intCast(obj.nPath)), obj.aPath.len);
            var i: usize = 0;
            while (i < n) : (i += 1) {
                pik_append_xy(p, if (i == 0) "" else "L", obj.aPath[i].x, obj.aPath[i].y);
            }
        } else {
            pik_append_xy(p, "", obj.ptEnter.x, obj.ptEnter.y);
            pik_append_xy(p, "L", obj.ptExit.x, obj.ptExit.y);
        }
        if (obj.bClose != 0) {
            pik_append(p, "Z");
        } else {
            obj.fill = -1.0;
        }
        pik_append(p, "\" ");
        pik_append_style(p, obj, if (obj.bClose != 0) 3 else 0);
        pik_append(p, " />\n");
        const n: usize = @intCast(obj.nPath);
        if (obj.larrow != 0 and n >= 2 and obj.aPath.len >= n) {
            pik_draw_arrowhead(p, &obj.aPath[1], &obj.aPath[0], obj);
        }
        if (obj.rarrow != 0 and n >= 2 and obj.aPath.len >= n) {
            pik_draw_arrowhead(p, &obj.aPath[n - 2], &obj.aPath[n - 1], obj);
        }
    }
    if (enclosed != 0) {
        pik_append(p, "</g>\n");
    }
    pik_append_txt(p, obj, null);
}

// Return a point along the path from "f" to "t" that is r units
// prior to reaching "t", except if the path is less than 2*r total,
// return the midpoint.
fn radiusMidpoint(f: PPoint, t: PPoint, r_in: PNum, pb_mid: *i32) PPoint {
    var dx = t.x - f.x;
    var dy = t.y - f.y;
    const dist = std.math.hypot(dx, dy);
    var m: PPoint = undefined;
    var r = r_in;
    if (dist <= 0.0) return t;
    dx /= dist;
    dy /= dist;
    if (r > 0.5 * dist) {
        r = 0.5 * dist;
        pb_mid.* = 1;
    } else {
        pb_mid.* = 0;
    }
    m.x = t.x - r * dx;
    m.y = t.y - r * dy;
    return m;
}

fn radiusPath(p: *Pik, obj: *PObj, r: PNum) void {
    const n: usize = @intCast(obj.nPath);
    const a = obj.aPath;
    var m: PPoint = undefined;
    var an = a[n - 1];
    var is_mid: i32 = 0;
    const i_last: usize = if (obj.bClose != 0) n else n - 1;
    pik_append_tag_open(p, obj, "path");
    if (obj.bClose == 0) {
        pik_append(p, " _T");
    }
    if (obj.sw >= 0.0 and obj.color >= 0.0) {
        if (pik_style_stroke_map(p, obj, if (obj.bClose != 0) 3 else 0).get(obj.color)) |tag| {
            pik_append(p, " _s");
            pik_append_color_tag(p, tag);
        } else {
            pik_error(p, null, "internal error: missing generated color class");
            return;
        }
    }
    if (obj.bClose != 0 and obj.fill >= 0.0) {
        if (pik_style_fill_map(p, obj, if (obj.bClose != 0) 3 else 0).get(obj.fill)) |tag| {
            pik_append(p, " _f");
            pik_append_color_tag(p, tag);
        } else {
            pik_error(p, null, "internal error: missing generated color class");
            return;
        }
    }
    pik_append(p, "\" ");
    pik_append_xy(p, "d=\"M", a[0].x, a[0].y);
    m = radiusMidpoint(a[0], a[1], r, &is_mid);
    pik_append_xy(p, " L ", m.x, m.y);
    var i: usize = 1;
    while (i < i_last) : (i += 1) {
        an = if (i < n - 1) a[i + 1] else a[0];
        m = radiusMidpoint(an, a[i], r, &is_mid);
        pik_append_xy(p, " Q ", a[i].x, a[i].y);
        pik_append_xy(p, " ", m.x, m.y);
        if (is_mid == 0) {
            m = radiusMidpoint(a[i], an, r, &is_mid);
            pik_append_xy(p, " L ", m.x, m.y);
        }
    }
    pik_append_xy(p, " L ", an.x, an.y);
    if (obj.bClose != 0) {
        pik_append(p, "Z");
    } else {
        obj.fill = -1.0;
    }
    pik_append(p, "\" ");
    pik_append_style(p, obj, if (obj.bClose != 0) 3 else 0);
    pik_append(p, " />\n");
}

fn splineRender(p: *Pik, obj: *PObj) void {
    if (obj.sw > 0.0) {
        const n: usize = @intCast(obj.nPath);
        const r = obj.rad;
        if (n < 3 or r <= 0.0) {
            lineRender(p, obj);
            return;
        }
        const enclosed = pik_append_group(p, obj);
        radiusPath(p, obj, r);
        if (obj.larrow != 0) {
            pik_draw_arrowhead(p, &obj.aPath[1], &obj.aPath[0], obj);
        }
        if (obj.rarrow != 0) {
            pik_draw_arrowhead(p, &obj.aPath[n - 2], &obj.aPath[n - 1], obj);
        }
        if (enclosed != 0) {
            pik_append(p, "</g>\n");
        }
    }
    pik_append_txt(p, obj, null);
}

// Methods for the "diamond" class
fn diamondInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "diamondwid", null);
    obj.h = pik_value(p, "diamondht", null);
    obj.bAltAutoFit = 1;
}

// Return offset from the center of the box to the compass point
// given by parameter cp
fn diamondOffset(p: *Pik, obj: *PObj, cp: i32) PPoint {
    _ = p;
    var pt = cZeroPoint;
    const w2 = 0.5 * obj.w;
    const w4 = 0.25 * obj.w;
    const h2 = 0.5 * obj.h;
    const h4 = 0.25 * obj.h;
    switch (cp) {
        CP_C => {},
        CP_N => pt = .{ .x = 0.0, .y = h2 },
        CP_NE => pt = .{ .x = w4, .y = h4 },
        CP_E => pt = .{ .x = w2, .y = 0.0 },
        CP_SE => pt = .{ .x = w4, .y = -h4 },
        CP_S => pt = .{ .x = 0.0, .y = -h2 },
        CP_SW => pt = .{ .x = -w4, .y = -h4 },
        CP_W => pt = .{ .x = -w2, .y = 0.0 },
        CP_NW => pt = .{ .x = -w4, .y = h4 },
        else => std.debug.assert(false),
    }
    return pt;
}

fn diamondFit(p: *Pik, obj: *PObj, w: PNum, h: PNum) void {
    _ = p;
    if (obj.w <= 0.0) obj.w = w * 1.5;
    if (obj.h <= 0.0) obj.h = h * 1.5;
    if (obj.w > 0.0 and obj.h > 0.0) {
        const x = obj.w * h / obj.h + w;
        const y = obj.h * x / obj.w;
        obj.w = x;
        obj.h = y;
    }
}

// Methods for the "ellipse" class
fn ellipseInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "ellipsewid", null);
    obj.h = pik_value(p, "ellipseht", null);
}

// Methods for the "file" object
fn fileInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "filewid", null);
    obj.h = pik_value(p, "fileht", null);
    obj.rad = pik_value(p, "filerad", null);
}

// Return offset from the center of the file to the compass point
// given by parameter cp
fn fileOffset(p: *Pik, obj: *PObj, cp: i32) PPoint {
    _ = p;
    var pt = cZeroPoint;
    const w2 = 0.5 * obj.w;
    const h2 = 0.5 * obj.h;
    var rx = obj.rad;
    const mn = if (w2 < h2) w2 else h2;
    if (rx > mn) rx = mn;
    if (rx < mn * 0.25) rx = mn * 0.25;
    rx *= 0.5;
    switch (cp) {
        CP_C => {},
        CP_N => pt = .{ .x = 0.0, .y = h2 },
        CP_NE => pt = .{ .x = w2 - rx, .y = h2 - rx },
        CP_E => pt = .{ .x = w2, .y = 0.0 },
        CP_SE => pt = .{ .x = w2, .y = -h2 },
        CP_S => pt = .{ .x = 0.0, .y = -h2 },
        CP_SW => pt = .{ .x = -w2, .y = -h2 },
        CP_W => pt = .{ .x = -w2, .y = 0.0 },
        CP_NW => pt = .{ .x = -w2, .y = h2 },
        else => std.debug.assert(false),
    }
    return pt;
}

fn fileFit(p: *Pik, obj: *PObj, w: PNum, h: PNum) void {
    _ = p;
    if (w > 0) obj.w = w;
    if (h > 0) obj.h = h + 2 * obj.rad;
}

fn fileRender(p: *Pik, obj: *PObj) void {
    const w2 = 0.5 * obj.w;
    const h2 = 0.5 * obj.h;
    var rad = obj.rad;
    const pt = obj.ptAt;
    const mn = if (w2 < h2) w2 else h2;
    if (rad > mn) rad = mn;
    if (rad < mn * 0.25) rad = mn * 0.25;
    if (obj.sw >= 0.0) {
        pik_append_tag_open(p, obj, "path");
        if (obj.fill < 0.0) {
            pik_append(p, " _T");
        }
        if (obj.sw >= 0.0 and obj.color >= 0.0) {
            if (pik_style_stroke_map(p, obj, 1).get(obj.color)) |tag| {
                pik_append(p, " _s");
                pik_append_color_tag(p, tag);
            } else {
                pik_error(p, null, "internal error: missing generated color class");
                return;
            }
        }
        if (obj.fill >= 0.0) {
            if (pik_style_fill_map(p, obj, 1).get(obj.fill)) |tag| {
                pik_append(p, " _f");
                pik_append_color_tag(p, tag);
            } else {
                pik_error(p, null, "internal error: missing generated color class");
                return;
            }
        }
        pik_append(p, "\" ");
        pik_append_xy(p, "d=\"M", pt.x - w2, pt.y - h2);
        pik_append_xy(p, "L", pt.x + w2, pt.y - h2);
        pik_append_xy(p, "L", pt.x + w2, pt.y + (h2 - rad));
        pik_append_xy(p, "L", pt.x + (w2 - rad), pt.y + h2);
        pik_append_xy(p, "L", pt.x - w2, pt.y + h2);
        pik_append(p, "Z\" ");
        pik_append_style(p, obj, 1);
        pik_append(p, " />\n");
        pik_append_tag_open(p, obj, "path");
        pik_append(p, " _T");
        if (obj.sw >= 0.0 and obj.color >= 0.0) {
            if (pik_style_stroke_map(p, obj, 0).get(obj.color)) |tag| {
                pik_append(p, " _s");
                pik_append_color_tag(p, tag);
            } else {
                pik_error(p, null, "internal error: missing generated color class");
                return;
            }
        }
        pik_append(p, "\" ");
        pik_append_xy(p, "d=\"M", pt.x + (w2 - rad), pt.y + h2);
        pik_append_xy(p, "L", pt.x + (w2 - rad), pt.y + (h2 - rad));
        pik_append_xy(p, "L", pt.x + w2, pt.y + (h2 - rad));
        pik_append(p, "\" ");
        pik_append_style(p, obj, 0);
        pik_append(p, " />\n");
    }
    pik_append_txt(p, obj, null);
}

// Methods for the "line" class
fn lineInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "linewid", null);
    obj.h = pik_value(p, "lineht", null);
    obj.rad = pik_value(p, "linerad", null);
}

fn lineOffset(p: *Pik, obj: *PObj, cp: i32) PPoint {
    if (false) {
        // In legacy PIC, the .center of an unclosed line is half way between
        // its .start and .end.
        if (cp == CP_C and obj.bClose == 0) {
            return .{
                .x = 0.5 * (obj.ptEnter.x + obj.ptExit.x) - obj.ptAt.x,
                .y = 0.5 * (obj.ptEnter.x + obj.ptExit.y) - obj.ptAt.y,
            };
        }
    }
    return boxOffset(p, obj, cp);
}

fn ellipseChop(p: *Pik, obj: *PObj, pt: *PPoint) PPoint {
    _ = p;
    var chop: PPoint = undefined;
    const dx = pt.x - obj.ptAt.x;
    const dy = pt.y - obj.ptAt.y;
    if (obj.w <= 0.0) return obj.ptAt;
    if (obj.h <= 0.0) return obj.ptAt;
    const s = obj.h / obj.w;
    const dq = dx * s;
    const dist = std.math.hypot(dq, dy);
    if (dist < obj.h) return obj.ptAt;
    chop.x = obj.ptAt.x + 0.5 * dq * obj.h / (dist * s);
    chop.y = obj.ptAt.y + 0.5 * dy * obj.h / dist;
    return chop;
}

fn ellipseOffset(p: *Pik, obj: *PObj, cp: i32) PPoint {
    _ = p;
    var pt = cZeroPoint;
    const w = obj.w * 0.5;
    const w2 = w * 0.70710678118654747608;
    const h = obj.h * 0.5;
    const h2 = h * 0.70710678118654747608;
    switch (cp) {
        CP_C => {},
        CP_N => pt = .{ .x = 0.0, .y = h },
        CP_NE => pt = .{ .x = w2, .y = h2 },
        CP_E => pt = .{ .x = w, .y = 0.0 },
        CP_SE => pt = .{ .x = w2, .y = -h2 },
        CP_S => pt = .{ .x = 0.0, .y = -h },
        CP_SW => pt = .{ .x = -w2, .y = -h2 },
        CP_W => pt = .{ .x = -w, .y = 0.0 },
        CP_NW => pt = .{ .x = -w2, .y = h2 },
        else => std.debug.assert(false),
    }
    return pt;
}

// Methods for the "move" class
fn moveInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "movewid", null);
    obj.h = obj.w;
    obj.fill = -1.0;
    obj.color = -1.0;
    obj.sw = -1.0;
}

// Methods for the "oval" class
fn ovalInit(p: *Pik, obj: *PObj) void {
    obj.h = pik_value(p, "ovalht", null);
    obj.w = pik_value(p, "ovalwid", null);
    obj.rad = 0.5 * @min(obj.h, obj.w);
}

fn ovalNumProp(p: *Pik, obj: *PObj, id: *PToken) void {
    _ = p;
    _ = id;
    // Always adjust the radius to be half of the smaller of
    // the width and height.
    obj.rad = 0.5 * @min(obj.h, obj.w);
}

fn ovalFit(p: *Pik, obj: *PObj, w: PNum, h: PNum) void {
    _ = p;
    if (w > 0.0) obj.w = w;
    if (h > 0.0) obj.h = h;
    if (obj.w < obj.h) obj.w = obj.h;
    obj.rad = 0.5 * @min(obj.h, obj.w);
}

// Methods for the "spline" class
fn splineInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "linewid", null);
    obj.h = pik_value(p, "lineht", null);
    obj.rad = 1000;
}

// Methods for the "text" class
fn textInit(p: *Pik, obj: *PObj) void {
    _ = pik_value(p, "textwid", null);
    _ = pik_value(p, "textht", null);
    obj.sw = 0.0;
}

fn textOffset(p: *Pik, obj: *PObj, cp: i32) PPoint {
    // Automatically slim-down the width and height of text
    // statements so that the bounding box tightly encloses the text,
    // then get boxOffset() to do the offset computation.
    const saved = p.cur;
    p.cur = obj;
    pik_size_to_fit(p, &obj.errTok, 3);
    p.cur = saved;
    return boxOffset(p, obj, cp);
}

fn textRender(p: *Pik, obj: *PObj) void {
    pik_append_txt(p, obj, null);
}

// Methods for the "sublist" class
fn sublistInit(p: *Pik, obj: *PObj) void {
    _ = p;
    const list = obj.pSublist orelse return;
    pik_bbox_init(&obj.bbox);
    for (list.a[0..list.n]) |child| pik_bbox_addbox(&obj.bbox, &child.bbox);
    obj.w = obj.bbox.ne.x - obj.bbox.sw.x;
    obj.h = obj.bbox.ne.y - obj.bbox.sw.y;
    obj.ptAt.x = 0.5 * (obj.bbox.ne.x + obj.bbox.sw.x);
    obj.ptAt.y = 0.5 * (obj.bbox.ne.y + obj.bbox.sw.y);
    obj.mCalc |= A_WIDTH | A_HEIGHT | A_RADIUS;
}

