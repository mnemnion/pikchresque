fn classToken(name: []const u8) PToken {
    var token: PToken = .zero;
    token.z = name;
    return token;
}

fn nullRender(p: *Pik, obj: *PObj) void {
    _ = p;
    _ = obj;
}

// Methods for the "arc" class
fn arcInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "arcrad", null);
    obj.h = obj.w;
}

// Hack: Arcs are here rendered as quadratic Bezier curves rather
// than true arcs.  Multiple reasons: (1) the legacy-PIC parameters
// that control arcs are obscure and I could not figure out what they
// mean based on available documentation.  (2) Arcs are rarely used,
// and so do not seem that important.
fn arcControlPoint(cw: i32, f: PPoint, t: PPoint, r_scale: PNum) PPoint {
    var m: PPoint = undefined;
    m.x = 0.5 * (f.x + t.x);
    m.y = 0.5 * (f.y + t.y);
    const dx = t.x - f.x;
    const dy = t.y - f.y;
    if (cw != 0) {
        m.x -= 0.5 * r_scale * dy;
        m.y += 0.5 * r_scale * dx;
    } else {
        m.x += 0.5 * r_scale * dy;
        m.y -= 0.5 * r_scale * dx;
    }
    return m;
}

fn arcCheck(p: *Pik, obj: *PObj) void {
    var m: PPoint = undefined;
    if (p.nTPath > 2) {
        pik_error(p, &obj.errTok, "arc geometry error");
        return;
    }
    m = arcControlPoint(obj.cw, p.aTPath[0], p.aTPath[1], 0.5);
    pik_bbox_add_xy(&obj.bbox, m.x, m.y);
}

fn arcRender(p: *Pik, obj: *PObj) void {
    if (obj.nPath < 2) return;
    if (obj.sw < 0.0) return;
    var f = obj.aPath[0];
    var t = obj.aPath[1];
    var m = arcControlPoint(obj.cw, f, t, 1.0);
    if (obj.larrow != 0) {
        pik_draw_arrowhead(p, &m, &f, obj);
    }
    if (obj.rarrow != 0) {
        pik_draw_arrowhead(p, &m, &t, obj);
    }
    pik_append_tag_open(p, obj, "path");
    if (obj.fill < 0.0) {
        pik_append(p, " _T");
    }
    if (obj.sw >= 0.0 and obj.color >= 0.0) {
        if (pik_style_stroke_map(p, obj, 0).get(obj.color)) |tag| {
            pik_append(p, " _s");
            pik_append_color_tag(p, tag);
        } else {
            pik_error(p, null, "internal error: missing generated color class");
            return;
        }
    }
    pik_append(p, "\" ");
    pik_append_xy(p, "d=\"M", f.x, f.y);
    pik_append_xy(p, "Q", m.x, m.y);
    pik_append_xy(p, " ", t.x, t.y);
    pik_append(p, "\" ");
    pik_append_style(p, obj, 0);
    pik_append(p, " />\n");

    pik_append_txt(p, obj, null);
}

// Methods for the "arrow" class
fn arrowInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "linewid", null);
    obj.h = pik_value(p, "lineht", null);
    obj.rad = pik_value(p, "linerad", null);
    obj.rarrow = 1;
}

// Methods for the "box" class
fn boxInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "boxwid", null);
    obj.h = pik_value(p, "boxht", null);
    obj.rad = pik_value(p, "boxrad", null);
}

// Return offset from the center of the box to the compass point
// given by parameter cp
fn boxOffset(p: *Pik, obj: *PObj, cp: i32) PPoint {
    _ = p;
    var pt = cZeroPoint;
    const w2 = 0.5 * obj.w;
    const h2 = 0.5 * obj.h;
    var rad = obj.rad;
    const rx = blk: {
        if (rad <= 0.0) break :blk 0.0;
        if (rad > w2) rad = w2;
        if (rad > h2) rad = h2;
        break :blk 0.29289321881345252392 * rad;
    };
    switch (cp) {
        CP_C => {},
        CP_N => pt = .{ .x = 0.0, .y = h2 },
        CP_NE => pt = .{ .x = w2 - rx, .y = h2 - rx },
        CP_E => pt = .{ .x = w2, .y = 0.0 },
        CP_SE => pt = .{ .x = w2 - rx, .y = rx - h2 },
        CP_S => pt = .{ .x = 0.0, .y = -h2 },
        CP_SW => pt = .{ .x = rx - w2, .y = rx - h2 },
        CP_W => pt = .{ .x = -w2, .y = 0.0 },
        CP_NW => pt = .{ .x = rx - w2, .y = h2 - rx },
        else => std.debug.assert(false),
    }
    return pt;
}

// Given a point outside a box, return the point on the edge of the
// box at which a line from the center of the box to the outside point
// intersects the box.
fn boxChop(p: *Pik, obj: *PObj, pt: *PPoint) PPoint {
    var cp: i32 = CP_C;
    var chop = obj.ptAt;
    if (obj.w <= 0.0 or obj.h <= 0.0) return chop;
    const dx = (pt.x - obj.ptAt.x) * obj.h / obj.w;
    const dy = pt.y - obj.ptAt.y;
    if (dx > 0.0) {
        if (dy >= 2.414 * dx) cp = CP_N
        else if (dy >= 0.414 * dx) cp = CP_NE
        else if (dy >= -0.414 * dx) cp = CP_E
        else if (dy > -2.414 * dx) cp = CP_SE
        else cp = CP_S;
    } else {
        if (dy >= -2.414 * dx) cp = CP_N
        else if (dy >= -0.414 * dx) cp = CP_NW
        else if (dy >= 0.414 * dx) cp = CP_W
        else if (dy > 2.414 * dx) cp = CP_SW
        else cp = CP_S;
    }
    chop = obj.type.?.xOffset.?(p, obj, cp);
    chop.x += obj.ptAt.x;
    chop.y += obj.ptAt.y;
    return chop;
}

fn boxFit(p: *Pik, obj: *PObj, w: PNum, h: PNum) void {
    _ = p;
    if (w > 0) obj.w = w;
    if (h > 0) obj.h = h;
}

// Methods for the "circle" class
fn circleInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "circlerad", null) * 2;
    obj.h = obj.w;
    obj.rad = 0.5 * obj.w;
}

fn circleNumProp(p: *Pik, obj: *PObj, id: *PToken) void {
    // For a circle, the width must equal the height and both must
    // be twice the radius.  Enforce those constraints.
    _ = p;
    if (hasKind(id, .DIAMETER) or hasKind(id, .RADIUS)) {
        obj.w = 2.0 * obj.rad;
        obj.h = obj.w;
    } else if (hasKind(id, .WIDTH)) {
        obj.h = obj.w;
        obj.rad = 0.5 * obj.w;
    } else if (hasKind(id, .HEIGHT)) {
        obj.w = obj.h;
        obj.rad = 0.5 * obj.w;
    }
}

fn circleChop(p: *Pik, obj: *PObj, pt: *PPoint) PPoint {
    _ = p;
    const dx = pt.x - obj.ptAt.x;
    const dy = pt.y - obj.ptAt.y;
    const dist = std.math.hypot(dx, dy);
    if (dist < obj.rad or dist <= 0) return obj.ptAt;
    return .{ .x = obj.ptAt.x + dx * obj.rad / dist, .y = obj.ptAt.y + dy * obj.rad / dist };
}

fn circleFit(p: *Pik, obj: *PObj, w: PNum, h: PNum) void {
    _ = p;
    var mx: PNum = 0.0;
    if (w > 0) mx = w;
    if (h > mx) mx = h;
    if (w * h > 0 and (w * w + h * h) > mx * mx) mx = std.math.hypot(w, h);
    if (mx > 0.0) {
        obj.rad = 0.5 * mx;
        obj.w = mx;
        obj.h = mx;
    }
}

// Methods for the "cylinder" class
fn cylinderInit(p: *Pik, obj: *PObj) void {
    obj.w = pik_value(p, "cylwid", null);
    obj.h = pik_value(p, "cylht", null);
    obj.rad = pik_value(p, "cylrad", null);
}

fn cylinderFit(p: *Pik, obj: *PObj, w: PNum, h: PNum) void {
    _ = p;
    if (w > 0) obj.w = w;
    if (h > 0) obj.h = h + 0.25 * obj.rad + obj.sw;
}

fn cylinderRender(p: *Pik, obj: *PObj) void {
    const w2 = 0.5 * obj.w;
    const h2 = 0.5 * obj.h;
    var rad = obj.rad;
    const pt = obj.ptAt;
    if (obj.sw >= 0.0) {
        if (rad > h2) {
            rad = h2;
        } else if (rad < 0.0) {
            rad = 0.0;
        }
        pik_append_tag_open(p, obj, "path");
        if (obj.fill < 0.0) {
            pik_append(p, " _T");
        }
        if (obj.sw >= 0.0 and obj.color >= 0.0) {
            if (pik_style_stroke_map(p, obj, 3).get(obj.color)) |tag| {
                pik_append(p, " _s");
                pik_append_color_tag(p, tag);
            } else {
                pik_error(p, null, "internal error: missing generated color class");
                return;
            }
        }
        if (obj.fill >= 0.0) {
            if (pik_style_fill_map(p, obj, 3).get(obj.fill)) |tag| {
                pik_append(p, " _f");
                pik_append_color_tag(p, tag);
            } else {
                pik_error(p, null, "internal error: missing generated color class");
                return;
            }
        }
        pik_append(p, "\" ");
        pik_append_xy(p, "d=\"M", pt.x - w2, pt.y + h2 - rad);
        pik_append_xy(p, "L", pt.x - w2, pt.y - h2 + rad);
        pik_append_arc(p, w2, rad, pt.x + w2, pt.y - h2 + rad);
        pik_append_xy(p, "L", pt.x + w2, pt.y + h2 - rad);
        pik_append_arc(p, w2, rad, pt.x - w2, pt.y + h2 - rad);
        pik_append_arc(p, w2, rad, pt.x + w2, pt.y + h2 - rad);
        pik_append(p, "\" ");
        pik_append_style(p, obj, 3);
        pik_append(p, " />\n");
    }
    pik_append_txt(p, obj, null);
}

fn cylinderOffset(p: *Pik, obj: *PObj, cp: i32) PPoint {
    _ = p;
    var pt = cZeroPoint;
    const w2 = obj.w * 0.5;
    const h1 = obj.h * 0.5;
    const h2 = h1 - obj.rad;
    switch (cp) {
        CP_C => {},
        CP_N => pt = .{ .x = 0.0, .y = h1 },
        CP_NE => pt = .{ .x = w2, .y = h2 },
        CP_E => pt = .{ .x = w2, .y = 0.0 },
        CP_SE => pt = .{ .x = w2, .y = -h2 },
        CP_S => pt = .{ .x = 0.0, .y = -h1 },
        CP_SW => pt = .{ .x = -w2, .y = -h2 },
        CP_W => pt = .{ .x = -w2, .y = 0.0 },
        CP_NW => pt = .{ .x = -w2, .y = h2 },
        else => std.debug.assert(false),
    }
    return pt;
}

// Methods for the "dot" class
fn dotInit(p: *Pik, obj: *PObj) void {
    obj.rad = pik_value(p, "dotrad", null);
    obj.h = obj.rad * 6;
    obj.w = obj.h;
    obj.fill = obj.color;
}

fn dotNumProp(p: *Pik, obj: *PObj, id: *PToken) void {
    _ = p;
    const name = id.z;
    if (std.mem.eql(u8, name, "color")) obj.fill = obj.color;
    if (std.mem.eql(u8, name, "fill")) obj.color = obj.fill;
}

fn dotCheck(p: *Pik, obj: *PObj) void {
    _ = p;
    obj.w = 0;
    obj.h = 0;
    pik_bbox_addellipse(&obj.bbox, obj.ptAt.x, obj.ptAt.y, obj.rad, obj.rad);
}

fn dotOffset(p: *Pik, obj: *PObj, cp: i32) PPoint {
    _ = p;
    _ = obj;
    _ = cp;
    return cZeroPoint;
}

// Append a tag, and any classes, to zOut.  Leaves the class open
// so elements can add additional class data.
fn pik_append_tag_open(p: *Pik, obj: ?*PObj, tag: []const u8) void {
    pik_append(p, "<");
    pik_append(p, tag);
    pik_append(p, " ");
    const o = obj orelse {
        pik_append(p, "error=\"missing-pObj\" ");
        return;
    };
    pik_append(p, "class=\"");
    if (o.type) |class| {
        if (std.mem.eql(u8, class.zName, "[]")) {
            pik_append(p, "group");
        } else {
            pik_append(p, class.zName);
        }
    }
    if (o.zName.len != 0) {
        pik_append(p, " ");
        pik_append_text(p, o.zName, 4);
    }
    var xclass = o.pXmlClass;
    while (xclass) |xc| : (xclass = xc.pNext) {
        pik_append(p, " ");
        pik_append_text(p, xc.zClass, 4);
    }
}

// Append a PNum value surrounded by text.  Do coordinate transformations
// on the value.
fn pik_append_x(p: *Pik, prefix: []const u8, v: PNum, suffix: []const u8) void {
    pik_append(p, prefix);
    pik_append_num(p, "", p.rScale * (v - p.bbox.sw.x));
    pik_append(p, suffix);
}

fn pik_append_y(p: *Pik, prefix: []const u8, v: PNum, suffix: []const u8) void {
    pik_append(p, prefix);
    pik_append_num(p, "", p.rScale * (p.bbox.ne.y - v));
    pik_append(p, suffix);
}

fn pik_append_xy(p: *Pik, prefix: []const u8, x: PNum, y: PNum) void {
    pik_append(p, prefix);
    pik_append_num(p, "", p.rScale * (x - p.bbox.sw.x));
    pik_append(p, ",");
    pik_append_num(p, "", p.rScale * (p.bbox.ne.y - y));
}

fn pik_append_dis(p: *Pik, prefix: []const u8, v: PNum, suffix: []const u8) void {
    pik_append(p, prefix);
    pik_append_num(p, "", p.rScale * v);
    pik_append(p, suffix);
}

// Append a PPoint value  (Used for debugging only)
fn pik_append_point(p: *Pik, prefix: []const u8, pt: *PPoint) void {
    pik_append(p, prefix);
    pik_append_num(p, "", pt.x);
    pik_append(p, ",");
    pik_append_num(p, "", pt.y);
}

// Invert the RGB color so that it is appropriate for dark mode.
// Variable x hold the initial color.  The color is intended for use
// as a background color if isBg is true, and as a foreground color
// if isBg is false.
fn pik_color_to_dark_mode(color: i32, is_bg: bool) i32 {
    const x = 0xffffff - color;
    var r = (x >> 16) & 0xff;
    var g = (x >> 8) & 0xff;
    var b = x & 0xff;
    const mx = @max(r, @max(g, b));
    const mn = @min(r, @min(g, b));
    r = mn + (mx - r);
    g = mn + (mx - g);
    b = mn + (mx - b);
    if (is_bg) {
        if (mx > 127) {
            r = @divTrunc(127 * r, mx);
            g = @divTrunc(127 * g, mx);
            b = @divTrunc(127 * b, mx);
        }
    } else {
        if (mn < 128 and mx > mn) {
            r = 127 + @divTrunc((r - mn) * 128, mx - mn);
            g = 127 + @divTrunc((g - mn) * 128, mx - mn);
            b = 127 + @divTrunc((b - mn) * 128, mx - mn);
        }
    }
    return r * 0x10000 + g * 0x100 + b;
}

// Append a color specification to the output.
//
// In PIKCHR_DARK_MODE, the color is inverted.  The "bg" flags indicates that
// the color is intended for use as a background color if true, or as a
// foreground color if false.  The distinction only matters for color
// inversions in PIKCHR_DARK_MODE.
fn pik_append_clr(p: *Pik, prefix: []const u8, value: PNum, suffix: []const u8, is_bg: bool) void {
    var x = pik_round(value);
    if (x == 0 and p.fgcolor > 0 and !is_bg) {
        x = p.fgcolor;
    } else if (is_bg and x >= 0xffffff and p.bgcolor > 0) {
        x = p.bgcolor;
    } else if ((p.mFlags & PIKCHR_DARK_MODE) != 0) {
        x = pik_color_to_dark_mode(x, is_bg);
    }
    pik_append(p, prefix);
    p.zOut.writer.print("rgb({d},{d},{d})", .{ (x >> 16) & 0xff, (x >> 8) & 0xff, x & 0xff }) catch pik_error(p, null, null);
    pik_append(p, suffix);
}

// Append an SVG path A record:
//
//    A r1 r2 0 0 0 x y
fn pik_append_arc(p: *Pik, r1: PNum, r2: PNum, x: PNum, y: PNum) void {
    pik_append(p, "A");
    pik_append_num(p, "", p.rScale * r1);
    pik_append(p, " ");
    pik_append_num(p, "", p.rScale * r2);
    pik_append(p, " 0 0 0 ");
    pik_append_num(p, "", p.rScale * (x - p.bbox.sw.x));
    pik_append(p, " ");
    pik_append_num(p, "", p.rScale * (p.bbox.ne.y - y));
}

// Append presentation styles to text.
//
// eFill is non-zero to fill in the background, or 0 if no fill should
// occur.  Non-zero values of eFill determine the "bg" flag to pik_append_clr()
// for cases when pObj->fill==pObj->color
//
//     1        fill is background, and color is foreground.
//     2        fill and color are both foreground.  (Used by "dot" objects)
//     3        fill and color are both background.  (Used by most other objs)
fn pik_append_style(p: *Pik, obj: *PObj, e_fill: i32) void {
    var clr_is_bg = false;
    if (obj.fill >= 0 and e_fill != 0) {
        var fill_is_bg = true;
        if (obj.fill == obj.color) {
            if (e_fill == 2) fill_is_bg = false;
            if (e_fill == 3) clr_is_bg = true;
        }
        if (comptime !pik_no_style) pik_append_clr(p, "fill=\"", obj.fill, "\"", fill_is_bg);
    } else {
        p.mAttr |= ATTR_FILL_NO;
    }
    if (obj.sw >= 0.0 and obj.color >= 0.0) {
        var sw = obj.sw;
        pik_append_dis(p, " stroke-width=\"", sw, "\"");
        if (obj.nPath > 2 and obj.rad <= obj.sw) {
            pik_append(p, " stroke-linejoin=\"round\"");
        }
        if (comptime !pik_no_style) pik_append_clr(p, " stroke=\"", obj.color, "\"", clr_is_bg);
        if (obj.dotted > 0.0) {
            const v = obj.dotted;
            if (sw < 2.1 / p.rScale) sw = 2.1 / p.rScale;
            pik_append_dis(p, " stroke-dasharray=\"", sw, "");
            pik_append_dis(p, " ", v, "\"");
        } else if (obj.dashed > 0.0) {
            const v = obj.dashed;
            pik_append_dis(p, " stroke-dasharray=\"", v, "");
            pik_append_dis(p, " ", v, "\"");
        }
    }
}

fn pik_style_e_fill(obj: *const PObj) i32 {
    const class = obj.type orelse return 0;
    if (class.xRender == null or class.xRender == nullRender or class.xRender == textRender) return 0;
    if (class.xInit == dotInit) return 2;
    if (class.xInit == fileInit) return 1;
    if (class.isLine != 0) return if (obj.bClose != 0) 3 else 0;
    return 3;
}

fn pik_style_stroke_map(p: *Pik, obj: *const PObj, e_fill: i32) *ColorMap {
    if (obj.fill >= 0.0 and e_fill == 3 and obj.fill == obj.color) return &p.hBgStroke;
    return &p.hStroke;
}

fn pik_style_fill_map(p: *Pik, obj: *const PObj, e_fill: i32) *ColorMap {
    if (obj.fill == obj.color and e_fill == 2) return &p.hFgFill;
    return &p.hFill;
}

// Compute the vertical locations for all text items in the
// object pObj.  In other words, set every pObj->aTxt[*].eCode
// value to contain exactly one of: TP_ABOVE2, TP_ABOVE, TP_CENTER,
// TP_BELOW, or TP_BELOW2 is set.
fn pik_txt_vertical_layout(obj: *PObj) void {
    const n = obj.nTxt;
    if (n == 0) return;
    const a_txt = obj.aTxt[0..n];
    if (n == 1) {
        if ((a_txt[0].eCode & TP_VMASK) == 0) {
            a_txt[0].eCode |= TP_CENTER;
        }
    } else {
        var all_slots: u16 = 0;
        var a_free: [5]u16 = undefined;
        var i_slot: usize = 0;
        var j: i32 = 0;
        var m_just: u16 = 0;
        // If there is more than one TP_ABOVE, change the first to TP_ABOVE2.
        var i: usize = n;
        while (i > 0) {
            i -= 1;
            if ((a_txt[i].eCode & TP_ABOVE) != 0) {
                if (j == 0) {
                    j += 1;
                    m_just = a_txt[i].eCode & TP_JMASK;
                } else if (j == 1 and m_just != 0 and (a_txt[i].eCode & m_just) == 0) {
                    j += 1;
                } else {
                    a_txt[i].eCode = (a_txt[i].eCode & ~TP_VMASK) | TP_ABOVE2;
                    break;
                }
            }
        }
        // If there is more than one TP_BELOW, change the last to TP_BELOW2
        j = 0;
        m_just = 0;
        i = 0;
        while (i < n) : (i += 1) {
            if ((a_txt[i].eCode & TP_BELOW) != 0) {
                if (j == 0) {
                    j += 1;
                    m_just = a_txt[i].eCode & TP_JMASK;
                } else if (j == 1 and m_just != 0 and (a_txt[i].eCode & m_just) == 0) {
                    j += 1;
                } else {
                    a_txt[i].eCode = (a_txt[i].eCode & ~TP_VMASK) | TP_BELOW2;
                    break;
                }
            }
        }
        // Compute a mask of all slots used
        for (a_txt) |txt| all_slots |= txt.eCode & TP_VMASK;
        // Set of an array of available slots
        if (n == 2 and (((a_txt[0].eCode | a_txt[1].eCode) & TP_JMASK) == (TP_LJUST | TP_RJUST))) {
            // Special case of two texts that have opposite justification:
            // Allow them both to float to center.
            i_slot = 2;
            a_free[0] = TP_CENTER;
            a_free[1] = TP_CENTER;
        } else {
            // Set up the arrow so that available slots are filled from top to
            // bottom
            i_slot = 0;
            if (n >= 4 and (all_slots & TP_ABOVE2) == 0) {
                a_free[i_slot] = TP_ABOVE2;
                i_slot += 1;
            }
            if ((all_slots & TP_ABOVE) == 0) {
                a_free[i_slot] = TP_ABOVE;
                i_slot += 1;
            }
            if ((n & 1) != 0) {
                a_free[i_slot] = TP_CENTER;
                i_slot += 1;
            }
            if ((all_slots & TP_BELOW) == 0) {
                a_free[i_slot] = TP_BELOW;
                i_slot += 1;
            }
            if (n >= 4 and (all_slots & TP_BELOW2) == 0) {
                a_free[i_slot] = TP_BELOW2;
                i_slot += 1;
            }
        }
        // Set the VMASK for all unassigned texts
        i_slot = 0;
        i = 0;
        while (i < n) : (i += 1) {
            if ((a_txt[i].eCode & TP_VMASK) == 0) {
                a_txt[i].eCode |= a_free[i_slot];
                i_slot += 1;
            }
        }
    }
}

// Return the font scaling factor associated with the input text attribute.
fn pik_font_scale(t: *const PToken) PNum {
    var scale: PNum = 1.0;
    if ((t.eCode & TP_BIG) != 0) scale *= 1.25;
    if ((t.eCode & TP_SMALL) != 0) scale *= 0.8;
    if ((t.eCode & TP_XTRA) != 0) scale *= scale;
    return scale;
}

// Append a string token as text.
fn pik_append_str(p: *Pik, text: []const u8, m_flags: i32) void {
    var z = text;
    while (z.len > 0) {
        var j: usize = 0;
        while (j < z.len and z[j] != '\\') : (j += 1) {}
        if (j != 0) pik_append_text(p, z[0..j], m_flags);
        if (j < z.len and (j + 1 == z.len or z[j + 1] == '\\')) {
            pik_append(p, "&#92;");
            j += 1;
        }
        if (j >= z.len) break;
        z = z[j + 1 ..];
    }
}

// Table of scale-factor estimates for variable-width characters.
// Actual character widths vary by font.  These numbers are only
// guesses.  And this table only provides data for ASCII.
//
// 100 means normal width.
const awChar = [_]u8{
    // Skip initial 32 control characters
    45, // ' '
    55, // '!'
    62, // '"'
    115, // '#'
    90, // '$'
    132, // '%'
    125, // '&'
    40, // '\''
    55, // '('
    55, // ')'
    71, // '*'
    115, // '+'
    45, // ','
    48, // '-'
    45, // '.'
    50, // '/'
    91, // '0'
    91, // '1'
    91, // '2'
    91, // '3'
    91, // '4'
    91, // '5'
    91, // '6'
    91, // '7'
    91, // '8'
    91, // '9'
    50, // ':'
    50, // ';'
    120, // '<'
    120, // '='
    120, // '>'
    78, // '?'
    142, // '@'
    102, // 'A'
    105, // 'B'
    110, // 'C'
    115, // 'D'
    105, // 'E'
    98, // 'F'
    105, // 'G'
    125, // 'H'
    58, // 'I'
    58, // 'J'
    107, // 'K'
    95, // 'L'
    145, // 'M'
    125, // 'N'
    115, // 'O'
    95, // 'P'
    115, // 'Q'
    107, // 'R'
    95, // 'S'
    97, // 'T'
    118, // 'U'
    102, // 'V'
    150, // 'W'
    100, // 'X'
    93, // 'Y'
    100, // 'Z'
    58, // '['
    50, // '\\'
    58, // ']'
    119, // '^'
    72, // '_'
    72, // '`'
    86, // 'a'
    92, // 'b'
    80, // 'c'
    92, // 'd'
    85, // 'e'
    52, // 'f'
    92, // 'g'
    92, // 'h'
    47, // 'i'
    47, // 'j'
    88, // 'k'
    48, // 'l'
    135, // 'm'
    92, // 'n'
    86, // 'o'
    92, // 'p'
    92, // 'q'
    69, // 'r'
    75, // 's'
    58, // 't'
    92, // 'u'
    80, // 'v'
    121, // 'w'
    81, // 'x'
    80, // 'y'
    76, // 'z'
    91, // '{'
    49, // '|'
    91, // '}'
    118, // '~'
};

// Return an estimate of the width of the displayed characters
// in a character string.  The returned value is 100 times the
// average character width.
//
// Omit "\" used to escape characters.  And count entities like
// "&lt;" as a single character.  Multi-byte UTF8 characters count
// as a single character.
//
// Unless using a monospaced font, attempt to scale the answer by
// the actual characters seen.  Wide characters count more than
// narrow characters. But the widths are only guesses.
fn pik_text_length(t: *const PToken, is_monospace: bool) i32 {
    const std_avg: i32 = 100;
    const mono_avg: i32 = 82;
    const z = t.z;
    var cnt: i32 = 0;
    var j: usize = 1;
    while (j + 1 < z.len) : (j += 1) {
        var c = z[j];
        if (c == '\\' and j + 1 < z.len and z[j + 1] != '&') {
            j += 1;
            c = z[j];
        } else if (c == '&') {
            var k = j + 1;
            while (k < j + 7 and k < z.len and z[k] != ';') : (k += 1) {}
            if (k < z.len and z[k] == ';') j = k;
            cnt += @divTrunc((if (is_monospace) mono_avg else std_avg) * 3, 2);
            continue;
        }
        if ((c & 0xc0) == 0xc0) {
            while (j + 2 < z.len and (z[j + 1] & 0xc0) == 0x80) j += 1;
            cnt += if (is_monospace) mono_avg else std_avg;
            continue;
        }
        if (is_monospace) {
            cnt += mono_avg;
        } else if (c >= 0x20 and c <= 0x7e) {
            cnt += awChar[c - 0x20];
        } else {
            cnt += std_avg;
        }
    }
    return cnt;
}

// Append multiple <text> SVG elements for the text fields of the PObj.
// Parameters:
//
//    p          The Pik object into which we are rendering
//
//    pObj       Object containing the text to be rendered
//
//    pBox       If not NULL, do no rendering at all.  Instead
//               expand the box object so that it will include all
//               of the text.
fn pik_append_txt(p: *Pik, obj: *PObj, box: ?*PBox) void {
    var jw: PNum = undefined; // Justification margin relative to center
    var ha2: PNum = 0.0; // Height of the top row of text
    var ha1: PNum = 0.0; // Height of the second "above" row
    var hc: PNum = 0.0; // Height of the center row
    var hb1: PNum = 0.0; // Height of the first "below" row of text
    var hb2: PNum = 0.0; // Height of the second "below" row
    var y_base: PNum = 0.0;
    const sw: PNum = if (obj.sw >= 0.0) obj.sw else 0.0;
    var all_mask: u16 = 0;

    if (p.nErr != 0) return;
    if (obj.nTxt == 0) return;
    const a_txt = obj.aTxt[0..obj.nTxt];
    pik_txt_vertical_layout(obj);
    const x = obj.ptAt.x;
    for (a_txt) |txt| all_mask |= txt.eCode;
    if (obj.type) |class| {
        if (class.isLine != 0) {
            hc = sw * 1.5;
        } else if (obj.rad > 0.0 and class.xInit == cylinderInit) {
            y_base = -0.75 * obj.rad;
        }
        if (class.eJust == 1) {
            jw = 0.5 * (obj.w - 0.5 * (p.charWidth + sw));
        } else {
            jw = 0.0;
        }
    } else {
        jw = 0.0;
    }
    if ((all_mask & TP_CENTER) != 0) {
        for (a_txt) |*txt| {
            if ((txt.eCode & TP_CENTER) != 0) {
                const s = pik_font_scale(txt);
                if (hc < s * p.charHeight) hc = s * p.charHeight;
            }
        }
    }
    if ((all_mask & TP_ABOVE) != 0) {
        for (a_txt) |*txt| {
            if ((txt.eCode & TP_ABOVE) != 0) {
                const s = pik_font_scale(txt) * p.charHeight;
                if (ha1 < s) ha1 = s;
            }
        }
        if ((all_mask & TP_ABOVE2) != 0) {
            for (a_txt) |*txt| {
                if ((txt.eCode & TP_ABOVE2) != 0) {
                    const s = pik_font_scale(txt) * p.charHeight;
                    if (ha2 < s) ha2 = s;
                }
            }
        }
    }
    if ((all_mask & TP_BELOW) != 0) {
        for (a_txt) |*txt| {
            if ((txt.eCode & TP_BELOW) != 0) {
                const s = pik_font_scale(txt) * p.charHeight;
                if (hb1 < s) hb1 = s;
            }
        }
        if ((all_mask & TP_BELOW2) != 0) {
            for (a_txt) |*txt| {
                if ((txt.eCode & TP_BELOW2) != 0) {
                    const s = pik_font_scale(txt) * p.charHeight;
                    if (hb2 < s) hb2 = s;
                }
            }
        }
    }
    for (a_txt) |*t| {
        var xtra_font_scale = pik_font_scale(t);
        var nx: PNum = 0.0;
        const orig_y = obj.ptAt.y;
        var y = y_base;
        if ((t.eCode & TP_ABOVE2) != 0) y += 0.5 * hc + ha1 + 0.5 * ha2;
        if ((t.eCode & TP_ABOVE) != 0) y += 0.5 * hc + 0.5 * ha1;
        if ((t.eCode & TP_BELOW) != 0) y -= 0.5 * hc + 0.5 * hb1;
        if ((t.eCode & TP_BELOW2) != 0) y -= 0.5 * hc + hb1 + 0.5 * hb2;
        if ((t.eCode & TP_LJUST) != 0) nx -= jw;
        if ((t.eCode & TP_RJUST) != 0) nx += jw;

        if (box) |p_box| {
            // If pBox is not NULL, do not draw any <text>.  Instead, just expand
            // pBox to include the text
            var cw = @as(PNum, @floatFromInt(pik_text_length(t, (t.eCode & TP_MONO) != 0))) * p.charWidth * xtra_font_scale * 0.01;
            const ch = p.charHeight * 0.5 * xtra_font_scale;
            var x0: PNum = undefined;
            var y0: PNum = undefined;
            var x1: PNum = undefined;
            var y1: PNum = undefined; // Boundary of text relative to pObj->ptAt
            if ((t.eCode & (TP_BOLD | TP_MONO)) == TP_BOLD) {
                cw *= 1.1;
            }
            if ((t.eCode & TP_RJUST) != 0) {
                x0 = nx;
                y0 = y - ch;
                x1 = nx - cw;
                y1 = y + ch;
            } else if ((t.eCode & TP_LJUST) != 0) {
                x0 = nx;
                y0 = y - ch;
                x1 = nx + cw;
                y1 = y + ch;
            } else {
                x0 = nx + cw / 2.0;
                y0 = y + ch;
                x1 = nx - cw / 2.0;
                y1 = y - ch;
            }
            if ((t.eCode & TP_ALIGN) != 0 and obj.nPath >= 2 and obj.aPath.len >= 2) {
                const nn: usize = @intCast(obj.nPath);
                var dx = obj.aPath[nn - 1].x - obj.aPath[0].x;
                var dy = obj.aPath[nn - 1].y - obj.aPath[0].y;
                if (dx != 0.0 or dy != 0.0) {
                    const dist = std.math.hypot(dx, dy);
                    var tt: PNum = undefined;
                    dx /= dist;
                    dy /= dist;
                    tt = dx * x0 - dy * y0;
                    y0 = dy * x0 - dx * y0;
                    x0 = tt;
                    tt = dx * x1 - dy * y1;
                    y1 = dy * x1 - dx * y1;
                    x1 = tt;
                }
            }
            pik_bbox_add_xy(p_box, x + x0, orig_y + y0);
            pik_bbox_add_xy(p_box, x + x1, orig_y + y1);
            continue;
        }
        nx += x;
        y += orig_y;
        pik_append_tag_open(p, obj, "text");
        if (obj.textcolor >= 0.0) {
            if (p.hFgFill.get(obj.textcolor)) |tag| {
                pik_append(p, " _f");
                pik_append_color_tag(p, tag);
            } else {
                pik_error(p, null, "internal error: missing generated color class");
                return;
            }
        }
        // _D is dominant baseline, every text element has it
        pik_append(p, " _D");
        p.mAttr |= ATTR_BASELINE;
        if ((t.eCode & TP_RJUST) != 0) {
            pik_append(p, " _tE");
            p.mAttr |= ATTR_T_END;
        } else if ((t.eCode & TP_LJUST) != 0) {
            pik_append(p, " _tS");
            p.mAttr |= ATTR_T_START;
        } else {
            pik_append(p, " _tM");
            p.mAttr |= ATTR_T_MIDDLE;
        }
        if ((t.eCode & TP_ITALIC) != 0) {
            pik_append(p, " _Fi");
            p.mAttr |= ATTR_F_ITALIC;
        }
        if ((t.eCode & TP_BOLD) != 0) {
            pik_append(p, " _Fb");
            p.mAttr |= ATTR_F_BOLD;
        }
        if ((t.eCode & TP_MONO) != 0) {
            pik_append(p, " _Fm");
            p.mAttr |= ATTR_F_MONO;
        }
        pik_append(p, "\" ");
        pik_append_x(p, "x=\"", nx, "\"");
        pik_append_y(p, " y=\"", y, "\"");
        if (comptime !pik_no_style) {
            if (obj.textcolor >= 0.0) {
                pik_append_clr(p, " fill=\"", obj.textcolor, "\"", false);
            }
        }
        xtra_font_scale *= p.fontScale;
        if (xtra_font_scale <= 0.99 or xtra_font_scale >= 1.01) {
            pik_append_num(p, " font-size=\"", xtra_font_scale * 100.0);
            pik_append(p, "%\"");
        }
        if ((t.eCode & TP_ALIGN) != 0 and obj.nPath >= 2 and obj.aPath.len >= 2) {
            const nn: usize = @intCast(obj.nPath);
            const dx = obj.aPath[nn - 1].x - obj.aPath[0].x;
            const dy = obj.aPath[nn - 1].y - obj.aPath[0].y;
            if (dx != 0.0 or dy != 0.0) {
                const ang = std.math.atan2(dy, dx) * -180.0 / std.math.pi;
                pik_append_num10(p, " transform=\"rotate(", ang);
                pik_append_xy(p, " ", x, orig_y);
                pik_append(p, ")\"");
            }
        }
        pik_append(p, ">");
        const z = if (t.z.len >= 2 and t.z[0] == '"') t.z[1 .. t.z.len - 1] else t.z;
        pik_append_str(p, z, 0x3);
        pik_append(p, "</text>\n");
    }
}

// Methods for the "box" class
fn boxRender(p: *Pik, obj: *PObj) void {
    const w2 = 0.5 * obj.w;
    const h2 = 0.5 * obj.h;
    var rad = obj.rad;
    const pt = obj.ptAt;
    if (obj.sw >= 0.0) {
        pik_append_tag_open(p, obj, "path");
        if (obj.fill < 0.0) pik_append(p, " _T");
        if (obj.sw >= 0.0 and obj.color >= 0.0) {
            if (pik_style_stroke_map(p, obj, 3).get(obj.color)) |tag| {
                pik_append(p, " _s");
                pik_append_color_tag(p, tag);
            } else {
                pik_error(p, null, "internal error: missing generated color class");
                return;
            }
        }
        if (obj.fill >= 0.0) {
            if (pik_style_fill_map(p, obj, 3).get(obj.fill)) |tag| {
                pik_append(p, " _f");
                pik_append_color_tag(p, tag);
            } else {
                pik_error(p, null, "internal error: missing generated color class");
                return;
            }
        }
        pik_append(p, "\" ");
        if (rad <= 0.0) {
            pik_append_xy(p, "d=\"M", pt.x - w2, pt.y - h2);
            pik_append_xy(p, "L", pt.x + w2, pt.y - h2);
            pik_append_xy(p, "L", pt.x + w2, pt.y + h2);
            pik_append_xy(p, "L", pt.x - w2, pt.y + h2);
            pik_append(p, "Z\" ");
        } else {
            //
            //         ----       - y3
            //        /    \
            //       /      \     _ y2
            //      |        |
            //      |        |    _ y1
            //       \      /
            //        \    /
            //         ----       _ y0
            //
            //      '  '  '  '
            //     x0 x1 x2 x3
            //
            if (rad > w2) rad = w2;
            if (rad > h2) rad = h2;
            const x0 = pt.x - w2;
            const x1 = x0 + rad;
            const x3 = pt.x + w2;
            const x2 = x3 - rad;
            const y0 = pt.y - h2;
            const y1 = y0 + rad;
            const y3 = pt.y + h2;
            const y2 = y3 - rad;
            const force_zero_vertical = obj.nTxt > 0 and std.mem.eql(u8, tokenInner(&obj.aTxt[0]), "2nd vertex");
            pik_append_xy(p, "d=\"M", x1, y0);
            if (x2 > x1) pik_append_xy(p, "L", x2, y0);
            pik_append_arc(p, rad, rad, x3, y1);
            if (y2 > y1 or force_zero_vertical) pik_append_xy(p, "L", x3, y2);
            pik_append_arc(p, rad, rad, x2, y3);
            if (x2 > x1) pik_append_xy(p, "L", x1, y3);
            pik_append_arc(p, rad, rad, x0, y2);
            if (y2 > y1 or force_zero_vertical) pik_append_xy(p, "L", x0, y1);
            pik_append_arc(p, rad, rad, x1, y0);
            pik_append(p, "Z\" ");
        }
        pik_append_style(p, obj, 3);
        pik_append(p, " />\n");
    }
    pik_append_txt(p, obj, null);
}

