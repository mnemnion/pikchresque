const PIKCHR_TOKEN_LIMIT = 100000;

const PikWord = struct {
    zWord: []const u8, // Text of the keyword
    eType: TokenKind, // Token code
    eCode: u16, // Extra code for the token
    eEdge: u8, // CP_* code for corner/edge keywords

    fn word(zWord: []const u8, eType: TokenKind, eCode: u16, eEdge: u8) PikWord {
        return .{ .zWord = zWord, .eType = eType, .eCode = eCode, .eEdge = eEdge };
    }
};

